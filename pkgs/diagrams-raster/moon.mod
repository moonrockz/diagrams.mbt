name = "moonrockz/diagrams-raster"

version = "0.4.0"

import {
  "moonrockz/diagrams@0.4.0",
  "moonrockz/diagrams-svg@0.4.0",
  "Milky2018/xml@0.6.1",
  "Milky2018/svg@0.6.0",
  "mizchi/font@0.7.4",
  "mizchi/image@0.4.3",
  "mizchi/zlib@0.4.10",
  "mizchi/pixelmatch@0.6.2",
  "moonbitlang/x@0.5.5",
  "moonbitlang/async@0.22.5",
  "walkzzz/image@0.5.0",
}

description = "Portable binary image export for diagrams.mbt generated SVG and playback"

repository = "https://github.com/moonrockz/diagrams.mbt"

license = "Apache-2.0"

readme = "README.mbt.md"
