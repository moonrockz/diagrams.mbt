let player_style : String = "body { margin: 1.5rem; background: #f4f5f7; color: #0f172a; font: 15px/1.5 system-ui, sans-serif; }\n[data-diagram-viewer] { --viewer-bg: #f4f5f7; --viewer-ink: #0f172a; --viewer-border: #64748b; max-width: 90rem; margin: auto; }\n[data-diagram-viewer] .diagram-canvas { overflow: auto; border: 1px solid var(--viewer-border); border-radius: .4rem; }\n[data-diagram-viewer] .diagram-canvas > svg { display: block; max-width: 100%; height: auto; }\n[data-diagram-viewer] .motion-controls, [data-diagram-viewer] fieldset { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem; margin: .8rem 0; }\n[data-diagram-viewer] fieldset { border: 1px solid var(--viewer-border); border-radius: .4rem; }\n[data-diagram-viewer] button, [data-diagram-viewer] select, [data-diagram-viewer] input { font: inherit; }\n[data-diagram-viewer] button, [data-diagram-viewer] select { padding: .35rem .6rem; border: 1px solid var(--viewer-border); border-radius: .3rem; background: var(--viewer-bg); color: var(--viewer-ink); }\n[data-diagram-viewer] [hidden] { display: none !important; }\n[data-diagram-viewer] label { display: inline-flex; align-items: center; gap: .35rem; }\n[data-diagram-viewer] select { max-width: 20rem; }\n[data-diagram-viewer] [data-control=\"seek\"] { width: min(22rem, 60vw); }\n[data-diagram-viewer] :focus-visible { outline: 3px solid #2563eb; outline-offset: 3px; }\n[data-diagram-viewer] [data-control=\"status\"] { min-height: 1.5em; }\n[data-diagram-viewer] .motion-overlay { pointer-events: none; }\n@media screen {\n  [data-diagram-viewer] .motion-selected { filter: drop-shadow(0 0 3px #2563eb); }\n}\n@media (prefers-color-scheme: dark) {\n  body { background: #10131a; color: #e2e8f0; }\n  [data-diagram-viewer] { --viewer-bg: #10131a; --viewer-ink: #e2e8f0; --viewer-border: #94a3b8; }\n}\n@media print {\n  body { margin: 0; background: white; }\n  [data-diagram-viewer] .motion-controls, [data-diagram-viewer] fieldset, [data-diagram-viewer] [data-control=\"status\"], [data-diagram-viewer] .motion-overlay { display: none !important; }\n  [data-diagram-viewer] .diagram-canvas { overflow: visible; border: none; }\n}\n"
