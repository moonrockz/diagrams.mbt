import {
  "moonrockz/diagrams-raster" @raster,
  "moonrockz/diagrams",
  "moonrockz/diagrams/animation",
  "moonrockz/diagrams/render",
  "moonrockz/diagrams-svg" @svg,
  "moonrockz/diagrams/bpmn" @model,
}

import {
  "moonrockz/diagrams-animated" @animated,
  "moonbitlang/core/debug",
  "moonrockz/diagrams/state",
  "moonrockz/diagrams/sequence",
  "moonrockz/diagrams/swimlane",
  "moonrockz/diagrams/bpmn" @model,
  "moonrockz/diagrams/regex",
  "moonrockz/diagrams/render",
} for "test"

// The generator writes these files and its check compares them byte for byte, so the formatter
// skips them.
formatter(ignore: [ "assets.generated.mbt" ])
