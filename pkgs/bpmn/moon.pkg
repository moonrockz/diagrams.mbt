import {
  "moonbitlang/core/debug",
  "moonbitlang/core/immut/hashmap" @namespaces,
}

import {
  "moonrockz/bpmn",
} for "test"

// The generator writes these files and its check compares them byte for byte, so the formatter
// skips them.
formatter(ignore: [ "schema.generated.mbt", "semantic.generated.mbt" ])
