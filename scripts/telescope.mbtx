----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
/// Download and verify the released Telescope CLI, then forward its arguments.
/// No source checkout, local build or PATH fallback is accepted.

///|
let version : String = "0.5.0"

///|
async fn output(command : String, args : Array[String]) -> String {
  let (code, out, err) = @process.collect_output(command, args)
  guard code == 0 else { fail("\{command}: \{err.text()}") }
  out.text().trim().to_owned()
}

///|
async fn install() -> String {
  let system = output("uname", ["-s"])
  let machine = output("uname", ["-m"])
  let (platform, expected) = match (system, machine) {
    ("Darwin", "arm64") =>
      (
        "macos-arm64", "8af13f0e2727eac93e5020f11c9a52400087cef9900d746e4c581b4337a2f153",
      )
    ("Linux", "x86_64") =>
      (
        "linux-x64", "ed25fe34173e7032035708bcfdaec06500bacfa9366916851b75ca675fb8ed6a",
      )
    _ => fail("Telescope \{version} is not qualified for \{system}/\{machine}")
  }
  let stem = "telescope-" + version + "-" + platform
  let dir = "_build/tools/telescope/" + version + "/" + platform
  let binary = dir + "/" + stem + "/telescope"
  let archive = dir + "/" + stem + ".tar.gz"
  @fs.mkdir(dir, recursive=true, allow_exist=true)
  if !@fs.exists(binary) {
    let url = "https://github.com/moonrockz/telescope/releases/download/v" +
      version +
      "/" +
      stem +
      ".tar.gz"
    for
      (remote, destination) in [
        (url, archive),
        (url + ".sha256", archive + ".sha256"),
      ] {
      ignore(
        output("curl", [
          "--fail", "--location", "--retry", "3", "--output", destination, remote,
        ]),
      )
    }
    let companion = @fs.read_file(archive + ".sha256").text()
    guard companion.has_prefix(expected + " ") else {
      fail("Telescope release checksum differs from the pinned checksum")
    }
    let checksum = if system == "Darwin" {
      output("shasum", ["-a", "256", archive])
    } else {
      output("sha256sum", [archive])
    }
    guard checksum.has_prefix(expected + " ") else {
      fail("Telescope archive checksum verification failed")
    }
    ignore(output("tar", ["-xzf", archive, "-C", dir]))
  }
  guard output(binary, ["--version"]) == version else {
    fail("Telescope CLI does not report pinned version " + version)
  }
  binary
}

///|
async fn main {
  let code = try {
    let binary = install()
    @process.run(
      binary,
      @env.args()[1:].to_owned(),
      stdout=@stdio.stdout,
      stderr=@stdio.stderr,
    )
  } catch {
    error => {
      eprintln("Telescope: \{error}")
      1
    }
  }
  if code != 0 {
    @sys.exit(if code > 0 { code } else { 1 })
  }
}
