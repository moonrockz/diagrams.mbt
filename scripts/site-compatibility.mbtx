----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/test",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
/// Capture or compare legacy public routes and heading anchors before site migration.

///|
fn option(args : Array[String], flag : String, fallback : String) -> String {
  for i in 0..<(args.length() - 1) {
    if args[i] == flag {
      return args[i + 1]
    }
  }
  fallback
}

///|
fn attributes(html : String) -> Array[String] {
  let ids = []
  let mut rest = html[:]
  while rest.find("<") is Some(start) {
    let tag = rest[start:]
    if tag.has_prefix("<!--") {
      guard tag.find("-->") is Some(end) else { break }
      rest = tag[end + 3:]
      continue
    }
    let mut end = 1
    let mut quote = 0
    while end < tag.length() {
      let c = tag[end].to_int()
      if quote != 0 {
        if c == quote {
          quote = 0
        }
      } else if c == '"' || c == '\'' {
        quote = c
      } else if c == '>' {
        break
      }
      end += 1
    }
    if end == tag.length() {
      break
    }
    let opening = tag[:end].to_owned()
    for mark in ["\"", "'"] {
      let marker = " id=" + mark
      if opening.find(marker) is Some(begin) {
        let tail = opening[begin + marker.length():]
        if tail.find(mark) is Some(stop) {
          let id = tail[:stop].to_owned()
          if !ids.contains(id) {
            ids.push(id)
          }
        }
      }
    }
    rest = tag[end + 1:]
    let lower = opening.to_lower()
    if lower.has_prefix("<script ") ||
      lower == "<script" ||
      lower.has_prefix("<style ") ||
      lower == "<style" {
      let closing = if lower.has_prefix("<script") {
        "</script>"
      } else {
        "</style>"
      }
      if rest.to_owned().to_lower().find(closing) is Some(stop) {
        rest = rest[stop + closing.length():]
      } else {
        break
      }
    }
  }
  ids.sort()
  ids
}

///|
async fn inventory(root : String, prefix~ : String = "") -> Map[String, Json] {
  let pages = Map([])
  for name in @fs.readdir(root + "/" + prefix, sort=true) {
    let rel = prefix + name
    match @fs.kind(root + "/" + rel) {
      Directory =>
        if prefix != "" || ["docs", "api", "articles"].contains(name) {
          for path, ids in inventory(root, prefix=rel + "/") {
            pages[path] = ids
          }
        }
      Regular =>
        if rel == "index.html" || rel.has_suffix("/index.html") {
          let text = @fs.read_file(root + "/" + rel).text()
          pages[rel] = @json.to_json(attributes(text))
        }
      _ => ()
    }
  }
  pages
}

///|
fn missing(
  expected : Map[String, Json],
  actual : Map[String, Json],
) -> Array[String] {
  let problems = []
  for page, ids in expected {
    match actual.get(page) {
      None => problems.push("Missing page: " + page)
      Some(Array(found)) => {
        guard ids is Array(required) else {
          problems.push("Invalid baseline anchors for " + page)
          continue
        }
        for id in required {
          if !found.contains(id) {
            problems.push(
              "Missing anchor: " +
              page +
              "#" +
              (if id is String(text) { text } else { "" }),
            )
          }
        }
      }
      _ => problems.push("Invalid current anchors for " + page)
    }
  }
  problems.sort()
  problems
}

///|
async fn main {
  let args = @env.args()
  let root = option(args, "--out", "_site")
  let path = option(
    args, "--baseline", "apps/site/fixtures/compatibility/routes.json",
  )
  let pages = inventory(root)
  guard !pages.is_empty() else {
    eprintln("No built pages in " + root + "; run build:site first")
    @sys.exit(1)
  }
  if args.contains("--capture") {
    let (code, out) = @process.collect_stdout("git", ["rev-parse", "HEAD"])
    guard code == 0 else { @sys.exit(1) }
    let baseline : Json = {
      "schema_version": 1,
      "source_ref": out.text().trim().to_owned(),
      "pages": @json.to_json(pages),
    }
    @fs.write_file(path, baseline.stringify(indent=2) + "\n")
    println("Captured \{pages.length()} legacy pages in \{path}")
  } else {
    guard @json.parse(@fs.read_file(path).text()) is Object(fields) &&
      fields.get("pages") is Some(Object(expected)) else {
      raise Failure("Invalid site compatibility baseline: " + path)
    }
    let problems = missing(expected, pages)
    for problem in problems {
      eprintln(problem)
    }
    if !problems.is_empty() {
      @sys.exit(1)
    }
    println("Retained \{expected.length()} legacy routes and their anchors")
  }
}

///|
test "compatibility permits additions and rejects missing routes or anchors" {
  let baseline : Map[String, Json] = { "docs/guide/index.html": ["start"] }
  let added : Map[String, Json] = {
    "docs/guide/index.html": ["start", "more"],
    "gallery/index.html": [],
  }
  @test.assert_eq(missing(baseline, added).length(), 0)
  @test.assert_eq(missing(baseline, Map([])).length(), 1)
  @test.assert_eq(
    missing(baseline, { "docs/guide/index.html": [] }).length(),
    1,
  )
}

///|
test "anchor capture accepts both quoting styles" {
  @test.assert_eq(attributes("<h2 id=\"guide\">Guide</h2><a id='part'>"), [
    "part", "guide",
  ])
}

///|
test "anchor capture ignores escaped source comments and raw script text" {
  @test.assert_eq(
    attributes(
      "<pre>&#x3C;b:task id='A'/>&lt;node id=\"B\"&gt;</pre><!-- <i id='comment'> --><script>const source = \"<x id='script'>\";</script><h2 title='a > b' id='real'>Title</h2>",
    ),
    ["real"],
  )
}
