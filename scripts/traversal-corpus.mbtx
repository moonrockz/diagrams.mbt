----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
/// Check, embed and refresh the shared BPMN traversal corpus.
///
/// - `check` fails when `tests/traversal-corpus/corpus.generated.mbt` does not
///   embed the current `fixtures/` and `expected/` files.
/// - `generate` writes that embedding.
/// - `expected` writes `expected/*.txt` from the MoonBit oracle
///   (`tests/traversal-corpus/dump`, native) and embeds the result.
///
/// The MoonBit test compares the oracle with the embedded text on wasm,
/// wasm-gc, js and native. The Python tests read the same files.

///|
let corpus_dir : String = "tests/traversal-corpus"

///|
let generated_path : String = "tests/traversal-corpus/corpus.generated.mbt"

///|
let usage : String = "Usage: traversal-corpus.mbtx check | generate | expected"

///|
fn fail_with(message : String) -> Unit {
  eprintln("❌ \{message}")
  @sys.exit(1)
}

///|
/// `text` as a MoonBit string literal.
fn small_literal(text : String) -> String {
  let buf = StringBuilder()
  buf.write_char('"')
  for c in text {
    match c {
      '"' => buf.write_string("\\\"")
      '\\' => buf.write_string("\\\\")
      '\n' => buf.write_string("\\n")
      '\r' => buf.write_string("\\r")
      '\t' => buf.write_string("\\t")
      _ => buf.write_char(c)
    }
  }
  buf.write_char('"')
  buf.to_string()
}

///|
/// A long `text` as a parenthesized sum of literals of at most 12,000 units,
/// split only between UTF-16 surrogate pairs.
fn literal(text : String) -> String {
  if text.length() <= 12000 {
    return small_literal(text)
  }
  let chunks : Array[String] = []
  let mut i = 0
  while i < text.length() {
    let mut end = Int32::min(i + 12000, text.length())
    if end < text.length() && text.code_unit_at(end - 1).is_leading_surrogate() {
      end -= 1
    }
    chunks.push(small_literal(text[i:end].to_owned()))
    i = end
  }
  "(" + chunks.join(" +\n    ") + ")"
}

///|
async fn entries(
  dir : String,
  suffixes : Array[String],
) -> Array[(String, String)] {
  let names = @fs.readdir(dir)
  names.sort()
  let out = []
  for name in names {
    guard suffixes.iter().any(s => name.has_suffix(s)) else {
      fail_with("Unexpected corpus file \{dir}/\{name}")
      continue
    }
    out.push((name, @fs.read_file(dir + "/" + name).text()))
  }
  out
}

///|
async fn embedding() -> String {
  let fixtures = entries(corpus_dir + "/fixtures", [".bpmn", ".graph"])
  let expected = entries(corpus_dir + "/expected", [".txt"])
  let out = StringBuilder()
  out.write_string(
    "// Generated by `mise run traversal-corpus:generate`. Do not edit.\n\n///|\npub let files : ReadOnlyArray[CorpusFile] = [\n",
  )
  for pair in fixtures {
    out.write_string(
      "  { name: \{literal(pair.0)}, text: \{literal(pair.1)} },\n",
    )
  }
  out.write_string(
    "]\n\n///|\npub let expected : ReadOnlyArray[CorpusFile] = [\n",
  )
  for pair in expected {
    out.write_string(
      "  { name: \{literal(pair.0)}, text: \{literal(pair.1)} },\n",
    )
  }
  out.write_string("]\n")
  out.to_string()
}

///|
/// Splits the dump output at its `=== <name>` lines.
fn split_dump(text : String) -> Array[(String, String)] raise Failure {
  let out : Array[(String, String)] = []
  let mut name : String? = None
  let body = StringBuilder()
  for line in text.split("\n") {
    if line.has_prefix("=== ") {
      if name is Some(n) {
        out.push((n, body.to_string()))
      }
      name = Some(line[4:].to_owned())
      body.reset()
    } else if name is Some(_) {
      body.write_string(line.to_owned())
      body.write_char('\n')
    }
  }
  guard name is Some(last) else { raise Failure("The dump has no output.") }
  // The text after the last line break is empty.
  let rest = body.to_string()
  out.push((last, rest[0:rest.length() - 1].to_owned()))
  out
}

///|
async fn main {
  let args = @env.args()
  let command = if args.length() > 1 { args[1] } else { "check" }
  match command {
    "check" => {
      let want = embedding()
      if !@fs.exists(generated_path) ||
        @fs.read_file(generated_path).text() != want {
        fail_with(
          "Stale traversal corpus embedding; run mise run traversal-corpus:generate",
        )
      }
      println("✅ Traversal corpus fixtures and expected outputs are embedded")
    }
    "generate" => {
      @fs.write_file(generated_path, embedding())
      println("✅ Wrote \{generated_path}")
    }
    "expected" => {
      @fs.write_file(generated_path, embedding())
      let (code, out, err) = @process.collect_output("moon", [
        "run",
        "--target",
        "native",
        "--release",
        corpus_dir + "/dump",
      ])
      if code != 0 {
        fail_with("The traversal oracle failed: \{err.text()}")
      }
      for pair in split_dump(out.text()) {
        @fs.write_file(corpus_dir + "/expected/" + pair.0, pair.1)
      }
      @fs.write_file(generated_path, embedding())
      println("✅ Wrote the expected traversal outputs and their embedding")
    }
    _ => fail_with(usage)
  }
}

///|
test "dump splitting keeps each file text" {
  assert_eq(split_dump("=== a.txt\nx\ny\n=== b.txt\nz\n"), [
    ("a.txt", "x\ny\n"),
    ("b.txt", "z\n"),
  ])
}

///|
test "long literals split between surrogate pairs" {
  let text = String::make(11999, 'a') + "🚀" + "b"
  let lit = literal(text)
  assert_true(lit.contains("\"🚀b\""))
}
