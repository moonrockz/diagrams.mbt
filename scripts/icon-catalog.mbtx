----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/sys",
}
----

///|

///|
fn field(value : Json, name : String) -> Json {
  guard value is Object(fields) && fields.get(name) is Some(value) else {
    abort("Missing catalog field " + name)
  }
  value
}

///|
fn string(value : Json) -> String {
  guard value is String(value) else { abort("Expected string") }
  value
}

///|
fn array(value : Json) -> Array[Json] {
  guard value is Array(value) else { abort("Expected array") }
  value
}

///|
fn normalized(value : Json) -> String {
  let children = array(field(value, "children")).map(normalized).join(",")
  "{\"tag\":" +
  field(value, "tag").stringify() +
  ",\"attrs\":" +
  field(value, "attrs").stringify() +
  ",\"children\":[" +
  children +
  "]}"
}

///|
fn node(value : Json) -> String {
  let tag = string(field(value, "tag"))
  if ![
      "symbol", "g", "path", "rect", "circle", "ellipse", "line", "polygon", "polyline",
      "defs", "linearGradient", "radialGradient", "stop", "clipPath", "filter", "feFlood",
      "feBlend", "mask",
    ].contains(tag) {
    abort("Unsupported vector element")
  }
  for pair in array(field(value, "attrs")) {
    let pair = array(pair)
    let name = string(pair[0])
    let value = string(pair[1])
    if name.to_lower().has_prefix("on") ||
      name.contains("href") ||
      ["src", "style"].contains(name) ||
      value.contains("http:") ||
      value.contains("https:") ||
      value.contains("javascript:") {
      abort("Unsafe vector attribute")
    }
    if value.contains("url(") && !value.has_prefix("url(#i") {
      abort("Non-local vector reference")
    }
  }
  let attrs = array(field(value, "attrs"))
    .map(pair => {
      let pair = array(pair)
      "(" + pair[0].stringify() + ", " + pair[1].stringify() + ")"
    })
    .join(", ")
  let children = array(field(value, "children")).map(node).join(", ")
  "@writer.Node::Element(" +
  field(value, "tag").stringify() +
  ", [" +
  attrs +
  "], [" +
  children +
  "])"
}

///|
async fn main {
  let args = @env.args()
  let generate = args.length() == 2 && args[1] == "generate"
  if args.length() != 2 || (!generate && args[1] != "check") {
    @sys.exit(1)
  }
  let dir = "pkgs/diagrams-svg/icons/"
  let catalog = @json.parse(@fs.read_file(dir + "catalog.json").text())
  let records = array(field(catalog, "records"))
  if records.length() != 523 {
    abort("Expected complete 523-key registry")
  }
  guard field(catalog, "assets") is Object(assets) else {
    abort("Expected assets")
  }
  let out = StringBuilder()
  out.write_string(
    "// Generated by mise run icons:generate. Do not edit.\n\n///|\nlet catalog : Map[String, Int] = {\n",
  )
  let keys = assets.keys().to_array()
  keys.sort_by((a, b) => a.lexical_compare(b))
  for r in records {
    let source = @fs.read_file(dir + string(field(r, "raw")))
    let actual = @crypto.bytes_to_hex_string(
      @crypto.sha256(@utf8.encode(source.text())),
    )
    if actual != string(field(r, "sourceSha256")) {
      abort("Icon source digest mismatch")
    }
    let vector = assets[string(field(r, "asset"))]
    let normalized_digest = @crypto.bytes_to_hex_string(
      @crypto.sha256(@utf8.encode(normalized(vector))),
    )
    if normalized_digest != string(field(r, "normalizedSha256")) {
      abort("Normalized icon digest mismatch: " + string(field(r, "key")))
    }
    let index = keys.search(string(field(r, "asset"))).unwrap()
    out.write_string(
      "  " + field(r, "key").stringify() + ": " + index.to_string() + ",\n",
    )
  }
  out.write_string(
    "}\n\n///|\nfn asset(index : Int) -> @writer.Node {\n  match index {\n",
  )
  for i, key in keys {
    out.write_string("    " + i.to_string() + " => " + node(assets[key]) + "\n")
  }
  out.write_string("    _ => abort(\"Invalid catalog index\")\n  }\n}\n")
  let mit_permission = @fs.read_file(dir + "LICENSE-ZENUML").text()
  out.write_string(
    "\n///|\nfn asset_notice(index : Int) -> String {\n  match index {\n",
  )
  for i, key in keys {
    let record = records
      .iter()
      .find_first(r => string(field(r, "asset")) == key)
      .unwrap()
    let notice = string(field(record, "attribution")) +
      ". " +
      string(field(record, "licence")) +
      ". Source: https://github.com/mermaid-js/zenuml-core/blob/e3f93e0eb65d23fa3520e8691a5bca883853aa4b/" +
      string(field(record, "source")) +
      ". Normalization preserves geometry, expands CSS classes and scopes IDs." +
      (if string(field(record, "licence")).has_prefix("MIT") {
        "\n" + mit_permission
      } else {
        ""
      })
    out.write_string(
      "    " + i.to_string() + " => " + Json(notice).stringify() + "\n",
    )
  }
  out.write_string("    _ => \"\"\n  }\n}\n")

  let target = dir + "catalog.generated.mbt"
  @fs.mkdir("_build", allow_exist=true)
  let temporary = "_build/icon-catalog.generated.mbt"
  @fs.write_file(temporary, out.to_string())
  let (code, formatted, errors) = @process.collect_output("moonfmt", [temporary])
  if code != 0 {
    eprintln(errors.text())
    @sys.exit(1)
  }
  let expected = formatted.text()
  if generate {
    @fs.write_file(target, expected)
  } else if !@fs.exists(target) || @fs.read_file(target).text() != expected {
    abort("Stale icon catalog; run mise run icons:generate")
  }
  let identities = StringBuilder()
  identities.write_string(
    "// Generated by mise run icons:generate. Registry identities only; no geometry.\n\n///|\nlet participant_keys : Map[String, Bool] = {\n",
  )
  for r in records {
    identities.write_string("  " + field(r, "key").stringify() + ": true,\n")
  }
  identities.write_string("}\n")
  @fs.write_file(temporary, identities.to_string())
  let (code, formatted, errors) = @process.collect_output("moonfmt", [temporary])
  if code != 0 {
    eprintln(errors.text())
    @sys.exit(1)
  }
  let target = "pkgs/diagrams/icons/registry.generated.mbt"
  if generate {
    @fs.write_file(target, formatted.text())
  } else if !@fs.exists(target) ||
    @fs.read_file(target).text() != formatted.text() {
    abort("Stale icon identities; run mise run icons:generate")
  }
  println(
    "Verified 523 participant keys and " +
    keys.length().to_string() +
    " compiled vector assets",
  )
}
