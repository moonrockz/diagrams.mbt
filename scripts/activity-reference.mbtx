///|
/// Refresh or check the PlantUML 1.2026.9 reference with the pinned JAR and
/// the JDK that the mise task pins. This is test-only qualification tooling:
/// no library module runs Java, a server or the upstream renderer.
///
/// Usage: `mise run activity-corpus:reference [-- --check]`.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/sys",
}

///|
let corpus : String = "tests/corpus/plantuml-activity"

///|
fn fail(message : String) -> Unit {
  eprintln("❌ " + message)
  @sys.exit(1)
}

///|
async fn main {
  let check = @env.args().contains("--check")
  let manifest = @json.parse(@fs.read_file(corpus + "/manifest.json").text())
  guard manifest is Object(m) &&
    m.get("jar") is Some(Object(jar)) &&
    jar.get("url") is Some(String(url)) &&
    jar.get("sha256") is Some(String(expected_sha)) &&
    m.get("plantuml") is Some(String(version)) &&
    m.get("jdk") is Some(String(jdk)) &&
    m.get("java_version") is Some(String(java_version)) else {
    fail("Invalid PlantUML manifest")
    return
  }
  // The pinned JAR is cached outside the source tree and verified on use.
  let dir = "_build/plantuml-reference"
  let jar_path = dir + "/plantuml-" + version + ".jar"
  if !@fs.exists(jar_path) {
    if !@fs.exists("_build") {
      @fs.mkdir("_build")
    }
    if !@fs.exists(dir) {
      @fs.mkdir(dir)
    }
    let code = @process.run(
      "curl",
      ["-fsSL", "-o", jar_path, url],
      stdout=@stdio.stdout,
      stderr=@stdio.stderr,
    )
    if code != 0 {
      fail("Could not download the pinned PlantUML JAR")
    }
  }
  let bytes = @fs.read_file(jar_path).binary()
  let actual_sha = @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
  if actual_sha != expected_sha {
    fail("PlantUML JAR digest mismatch: " + actual_sha)
  }
  let (code, _, err) = @process.collect_output("java", ["-version"])
  if code != 0 || !err.text().contains("\"" + java_version + "\"") {
    fail(
      "The reference task needs JDK " +
      jdk +
      "; run it with mise run activity-corpus:reference",
    )
  }
  let raw = dir + "/reference.raw.json"
  let code = @process.run(
    "java",
    [
      "-Djava.awt.headless=true",
      "-cp",
      jar_path,
      "tests/plantuml-activity-reference/ActivityReference.java",
      corpus + "/fixtures",
      raw,
    ],
    extra_env={ "PLANTUML_SECURITY_PROFILE": "SANDBOX" },
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  )
  if code != 0 {
    fail("The PlantUML reference driver failed")
  }
  let (code, out, err) = @process.collect_output("moonx", [
    "scripts/activity-corpus.mbtx", "digest",
  ])
  if code != 0 {
    eprintln(err.text())
    fail("Could not compute activity fixture digest")
  }
  let report = @json.parse(@fs.read_file(raw).text())
  guard report is Object(fields) &&
    fields.get("plantuml") is Some(String(reported)) else {
    fail("Invalid reference driver output")
    return
  }
  if reported != version {
    fail("The JAR reports PlantUML " + reported + ", not " + version)
  }
  if check {
    // Canonical output is produced by the portable MoonBit acceptance test.
    // Qualify it with the same upstream adapter, not with our converter.
    let canonical_path = "tests/plantuml-activity-acceptance/__snapshot__/canonical.json"
    if !@fs.exists(canonical_path) {
      fail(
        "Missing canonical activity snapshot; run the activity acceptance tests with --update",
      )
    }
    let canonical = @json.parse(@fs.read_file(canonical_path).text())
    guard canonical is Array(canonical_entries) else {
      fail("Invalid canonical activity snapshot")
      return
    }
    let canonical_root = dir + "/activity-canonical"
    if !@fs.exists(canonical_root) {
      @fs.mkdir(canonical_root)
    }
    let canonical_names : Map[String, Bool] = Map([])
    for entry in canonical_entries {
      guard entry is Array(values) &&
        values.length() == 2 &&
        values[0] is String(name) &&
        values[1] is String(source) else {
        fail("Invalid canonical activity entry")
        return
      }
      if name.contains("..") || name.has_prefix("/") {
        fail("Invalid canonical path")
      }
      let mut folder = canonical_root
      let pieces = name.split("/").map(s => s.to_owned()).to_array()
      for i = 0; i < pieces.length() - 1; i = i + 1 {
        folder = folder + "/" + pieces[i]
        if !@fs.exists(folder) {
          @fs.mkdir(folder)
        }
      }
      @fs.write_file(canonical_root + "/" + name, source)
      canonical_names[name] = true
    }
    let canonical_report = dir + "/activity-canonical.json"
    let canonical_code = @process.run(
      "java",
      [
        "-Djava.awt.headless=true", "-cp", jar_path, "tests/plantuml-activity-reference/ActivityReference.java",
        canonical_root, canonical_report,
      ],
      extra_env={ "PLANTUML_SECURITY_PROFILE": "SANDBOX" },
      stdout=@stdio.stdout,
      stderr=@stdio.stderr,
    )
    if canonical_code != 0 {
      fail("Canonical PlantUML activity reference failed")
    }
    let native_canonical = @json.parse(@fs.read_file(canonical_report).text())
    guard native_canonical is Object(canonical_fields) &&
      canonical_fields.get("fixtures") is Some(Array(canonical_fixtures)) &&
      fields.get("fixtures") is Some(Array(original_fixtures)) else {
      fail("Invalid activity reference reports")
      return
    }
    let expectations = @json.parse(
      @fs.read_file(corpus + "/expectations.json").text(),
    )
    guard expectations is Object(exceptions) else {
      fail("Invalid activity expectations")
      return
    }
    let by_name : Map[String, Json] = Map([])
    for value in original_fixtures {
      guard value is Object(item) && item.get("name") is Some(String(name)) else {
        fail("Invalid original activity reference")
        return
      }
      by_name[name] = value
    }
    for value in original_fixtures {
      guard value is Object(item) && item.get("name") is Some(String(name)) else {
        fail("Invalid source activity entry")
        return
      }
      let refused = match exceptions.get(name) {
        Some(Object(record)) => record.get("stage") == Some(Json("read"))
        _ => false
      }
      if !refused &&
        item.get("status") == Some(Json("accepted")) &&
        !canonical_names.contains(name) {
        fail("Missing canonical activity output for " + name)
      }
    }
    if canonical_fixtures.length() != canonical_names.length() {
      fail(
        "Stale canonical activity files; remove _build/plantuml-reference/activity-canonical and retry",
      )
    }
    for value in canonical_fixtures {
      guard value is Object(item) && item.get("name") is Some(String(name)) else {
        fail("Invalid canonical activity reference")
        return
      }
      if by_name.get(name) != Some(value) {
        fail("Canonical activity semantics differ from original in " + name)
      }
    }
  }
  let ordered : Map[String, Json] = Map([])
  ordered["plantuml"] = Json(version)
  ordered["jdk"] = Json(jdk)
  ordered["jar_sha256"] = Json(actual_sha)
  ordered["adapter_sha256"] = Json(
    @crypto.bytes_to_hex_string(
      @crypto.sha256(
        @fs.read_file(
          "tests/plantuml-activity-reference/ActivityReference.java",
        ).binary(),
      ),
    ),
  )
  ordered["fixtures_digest"] = Json(out.text().trim().to_owned())
  ordered["fixtures"] = fields.get("fixtures").unwrap()
  let text = Json(ordered).stringify(indent=1) + "\n"
  let target = corpus + "/reference.json"
  if check {
    if !@fs.exists(target) || @fs.read_file(target).text() != text {
      fail("The stored PlantUML reference differs from the pinned JAR output")
    }
    println("✅ The stored PlantUML reference matches the pinned JAR")
    return
  }
  @fs.write_file(target, text)
}
