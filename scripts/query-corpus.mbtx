----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
/// Check and embed the shared normalized query corpus: the BPMN fixtures, the
/// cases and the expected output of `tests/query-corpus/fixtures`. The MoonBit
/// test runs the embedded cases on all four targets; the Python tests read the
/// same files.
///
/// Usage: `moonx scripts/query-corpus.mbtx check | generate`.

///|
let fixtures_dir : String = "tests/query-corpus/fixtures"

///|
let generated_path : String = "tests/query-corpus/inputs.generated.mbt"

///|
/// `text` as a MoonBit string literal, split into chunks.
fn literal(text : String) -> String {
  let chunks : Array[String] = []
  let mut buf = StringBuilder()
  let mut size = 0
  buf.write_char('"')
  for c in text {
    match c {
      '"' => buf.write_string("\\\"")
      '\\' => buf.write_string("\\\\")
      '\n' => buf.write_string("\\n")
      '\r' => buf.write_string("\\r")
      '\t' => buf.write_string("\\t")
      _ => buf.write_char(c)
    }
    size += 1
    if size >= 8000 {
      buf.write_char('"')
      chunks.push(buf.to_string())
      buf = StringBuilder()
      buf.write_char('"')
      size = 0
    }
  }
  buf.write_char('"')
  chunks.push(buf.to_string())
  if chunks.length() == 1 {
    chunks[0]
  } else {
    "(" + chunks.join(" +\n    ") + ")"
  }
}

///|
/// The generated MoonBit source for the given fixture files.
fn generate(
  documents : Array[(String, String)],
  cases : String,
  expected : String,
) -> String {
  let out = StringBuilder()
  out.write_string(
    "// Generated by `mise run query-corpus:generate`. Do not edit.\n\n///|\npub let documents : ReadOnlyArray[(String, String)] = [\n",
  )
  for d in documents {
    out.write_string("  (\{literal(d.0)}, \{literal(d.1)}),\n")
  }
  out.write_string(
    "]\n\n///|\npub let cases_text : String = \{literal(cases)}\n",
  )
  out.write_string(
    "\n///|\npub let expected_text : String = \{literal(expected)}\n",
  )
  out.to_string()
}

///|
async fn main {
  let args = @env.args()
  let command = if args.length() > 1 { args[1] } else { "check" }
  if command != "check" && command != "generate" {
    println("Usage: query-corpus.mbtx check | generate")
    @sys.exit(2)
  }
  let names = @fs.readdir(fixtures_dir).filter(n => n.has_suffix(".bpmn"))
  names.sort()
  let documents = []
  for n in names {
    documents.push((n, @fs.read_file("\{fixtures_dir}/\{n}").text()))
  }
  let cases = @fs.read_file("\{fixtures_dir}/cases.txt").text()
  let expected = @fs.read_file("\{fixtures_dir}/expected.txt").text()
  let text = generate(documents, cases, expected)
  if command == "generate" {
    @fs.write_file(generated_path, text)
    println("Wrote \{generated_path}")
  } else if !@fs.exists(generated_path) ||
    @fs.read_file(generated_path).text() != text {
    println(
      "❌ Stale query corpus embedding; run mise run query-corpus:generate",
    )
    @sys.exit(1)
  } else {
    println("✅ The query corpus embedding is current")
  }
}

///|
test "literals escape quotes, backslashes and line breaks" {
  assert_eq(literal("a\"b\\c\r\n"), "\"a\\\"b\\\\c\\r\\n\"")
  assert_true(
    generate([("x.bpmn", "<x/>")], "c", "e").contains("pub let expected_text"),
  )
}
