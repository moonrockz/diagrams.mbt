///|
/// Build, check and test the docs site of `apps/site`. The site is written to `_site/`.
///
/// Usage: `mise run build:site [-- --main] [--tree <tree>]`, `mise run check:site [-- --tree <tree>]`,
/// `mise run test:site [-- --tree <tree>]` and `mise run assemble:site`, or the same commands of
/// `moonx scripts/site.mbtx`.
/// `build` generates API metadata and invokes the released host with compiled providers. Each task stops at the first
/// step that fails, prints the name of that step, and exits with a non-zero code. `check` checks the
/// built `_site/`. `test` runs consumer tests,
/// installs Chromium, and runs the browser smoke test against the built `_site/` (design D16).
/// `--tree next` builds, checks or tests the `main` tree in `_site/next/`, and `--tree <minor>` the
/// tree of the minor line of the root `moon.mod` in `_site/v/<minor>/` (design D22). `assemble` adds
/// the release trees to a `next` build in `_site/` and writes the deployed site.
/// Run it from the workspace root.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/sys",
}

///|
let usage : String = "Usage: site.mbtx build [--main] [--tree <tree>] | check [--tree <tree>] | test [--tree <tree>] | assemble"

///|
/// The arguments without `--tree <tree>`, and the tree, or `None` without `--tree`.
fn split_tree(args : Array[String]) -> (Array[String], String?) raise Failure {
  let rest = []
  let mut tree = None
  let mut i = 0
  while i < args.length() {
    if args[i] == "--tree" {
      guard i + 1 < args.length() else {
        raise Failure("`--tree` needs a tree: `next` or a minor line. \{usage}")
      }
      tree = Some(args[i + 1])
      i += 2
    } else {
      rest.push(args[i])
      i += 1
    }
  }
  (rest, tree)
}

///|
/// Whether `text` is a minor line `X.Y` with digits only.
fn is_minor_line(text : String) -> Bool {
  let parts = text.split(".").collect()
  parts.length() == 2 &&
  parts
  .iter()
  .all(part => part != "" && part.iter().all(c => c >= '0' && c <= '9'))
}

///|
/// The path of the tree `tree` below `_site/`, with a final `/` (design D22): `next/` for `next`, and
/// `v/<minor>/` for the minor line `line` of the root `moon.mod`. Another minor line fails, and so do
/// the reserved names `latest` and `v`, which only the deploy writes.
fn tree_path(tree : String, line~ : String) -> String raise Failure {
  if tree == "next" {
    "next/"
  } else if is_minor_line(tree) {
    if tree != line {
      raise Failure(
        "moon.mod has the minor line \{line}, but the build asks for the tree \{tree}",
      )
    }
    "v/\{tree}/"
  } else {
    raise Failure(
      "`\{tree}` is not a tree to build: use `next` or the minor line of moon.mod",
    )
  }
}

///|
/// The minor line of the root `moon.mod`, from `scripts/versions.mbtx minor`.
async fn root_line() -> String raise Failure {
  let (code, out) = @process.collect_stdout("moonx", [
    "scripts/versions.mbtx", "minor",
  ]) catch {
    error => raise Failure("scripts/versions.mbtx does not run: \{error}")
  }
  let line = (out.text() catch { _ => "" }).trim().to_owned()
  guard code == 0 && is_minor_line(line) else {
    raise Failure("scripts/versions.mbtx minor gives no minor line")
  }
  line
}

///|
/// The tree path of the arguments of a command, or `""` without `--tree`. Only a minor line needs the
/// version of the root `moon.mod`.
async fn tree_of(tree : String?) -> String raise Failure {
  match tree {
    None => ""
    Some("next") => "next/"
    Some(name) =>
      tree_path(name, line=if is_minor_line(name) { root_line() } else { "" })
  }
}

///|
/// The output directory of the tree at `path` below `_site/`.
fn tree_dir(path : String) -> String {
  if path == "" {
    out_dir
  } else {
    "\{out_dir}/\{path[:path.length() - 1]}"
  }
}

///|
/// The output directory, relative to the workspace root.
let out_dir : String = "_site"

///|
/// The directory of the `moon doc` output of the API pages, relative to the workspace root. The
/// output of the module directory `pkgs/notebooks` is in `_build/site-api/pkgs/notebooks/doc/`.
let api_dir : String = "_build/site-api"

///|
/// The step that runs `moon doc` in the module directory `dir`. `moon -C` reads `--target-dir`
/// relative to `dir`, so the target goes up to the workspace root first. Each module has its own
/// target directory, so a later run does not remove the output of an earlier one.
fn api_doc_step(dir : String) -> Step {
  let up = dir.split("/").map(_ => "..").collect().join("/")
  run("moon doc \{dir}", "moon", [
    "-C",
    dir,
    "doc",
    "--target-dir",
    "\{up}/\{api_dir}/\{dir}",
  ])
}

///|
/// The module directories of the `api` key of `site/site.json`. The generator checks the key; a
/// value that is not an array of strings gives no steps here.
fn api_dirs(site_json : String) -> Array[String] {
  let json = @json.parse(site_json) catch { _ => return [] }
  guard json is Object(fields) && fields.get("api") is Some(Array(items)) else {
    return []
  }
  items.filter_map(item => if item is String(dir) { Some(dir) } else { None })
}

///|
/// What one step does.
enum Action {
  /// Run the command with the arguments.
  Run(String, Array[String])
  /// Serve `_site/` on the port with `serve-site.mbtx --no-watch`, run the browser smoke test against
  /// the tree at the path below the base path (`""` for the whole site), and stop the server.
  BrowserTest(Int32, String)
} derive(Eq, Debug)

///|
/// The port of the preview server during the browser smoke test (design D16).
let browser_test_port : Int32 = 4174

///|
/// The browser smoke test, run by the pinned Node.
let browser_test_script : String = "apps/site/scripts/browser-test.ts"

///|
/// The base path in the text of `site/site.json`.
fn site_base(text : String) -> String raise Failure {
  let json = @json.parse(text) catch {
    error => raise Failure("site/site.json: not valid JSON: \{error}")
  }
  guard json is Object(fields) && fields.get("base_path") is Some(String(base)) else {
    raise Failure("site/site.json: missing string field `base_path`")
  }
  base
}

///|
/// One step of a site task.
struct Step {
  name : String
  action : Action
} derive(Eq, Debug)

///|
fn run(name : String, command : String, args : Array[String]) -> Step {
  { name, action: Run(command, args), }
}

///|
/// The step that installs the npm packages of `apps/site` from `bun.lock`.
let install_step : Step = run("install site dependencies", "bun", [
  "install", "--frozen-lockfile", "--cwd", "apps/site",
])

///|
/// The steps of `build`. `--main` marks a build for the deployed site. `api` holds the module
/// directories of the API pages; `moon doc` runs in each before the host build. `tree` is the path of the
/// version tree below `_site/`, such as `next/`, or `""` for a build at the site root.
fn build_steps(
  args : Array[String],
  api~ : Array[String] = [],
  tree~ : String = "",
) -> Array[Step] raise Failure {
  for arg in args {
    if arg != "--main" {
      raise Failure("unknown option `\{arg}`. \{usage}")
    }
  }
  let out = tree_dir(tree)
  let consumer_args = [
    "run", "--target", "native", "--release", "apps/site/consumer", "--", "--root",
    ".", "--out", out,
  ]
  if tree != "" {
    consumer_args.push("--tree-path")
    consumer_args.push(tree)
  }
  if args.contains("--main") {
    consumer_args.push("--main")
  }
  [
    run("verify released Telescope CLI", "moonx", [
      "scripts/telescope.mbtx", "--version",
    ]),
    ..api.map(api_doc_step),
    run("build with released Telescope host", "moon", consumer_args),
  ]
}

///|
/// The steps of `check`. `tree` is the path of the version tree below `_site/`, and `base` the base
/// path of the site in `_site/`. Without a tree, a `_site/` that the deploy assembled is checked tree
/// by tree.
fn check_steps(
  args : Array[String],
  tree~ : String = "",
  base~ : String = "/",
) -> Array[Step] raise Failure {
  if args is [arg, ..] {
    raise Failure("unknown option `\{arg}`. \{usage}")
  }
  [
    run("check with released Telescope CLI", "moonx", [
      "scripts/telescope.mbtx",
      "check",
      "--out",
      tree_dir(tree),
      "--base",
      base + tree,
    ]),
  ]
}

///|
/// The steps of `assemble` (design D22): the `assemble` executable reads the releases with `gh`,
/// supplies their existing trees to Telescope, and writes the assembled output.
fn assemble_steps(args : Array[String]) -> Array[Step] raise Failure {
  if args is [arg, ..] {
    raise Failure("unknown option `\{arg}`. \{usage}")
  }
  [
    run("assemble", "moon", [
      "run", "--target", "native", "--release", "apps/site/assemble", "--", "--root",
      ".", "--site", out_dir,
    ]),
  ]
}

///|
/// The module name of `apps/site`.
let site_module : String = "moonrockz/diagrams-site"

///|
/// The full names of the site packages that run on native. `packages` holds the directory name and the
/// `moon.pkg` text of each package below `apps/site`, in order. JS-only packages are excluded.
fn native_packages(packages : Array[(String, String)]) -> Array[String] {
  packages
  .filter(entry => !entry.1.contains("supported_targets = \"js\""))
  .map(entry => "\{site_module}/\{entry.0}")
}

///|
/// Each package below `apps/site`: the directory name and the `moon.pkg` text.
async fn site_packages() -> Array[(String, String)] {
  let found = []
  for name in @fs.readdir("apps/site", sort=true) {
    let pkg = "apps/site/\{name}/moon.pkg"
    if @fs.kind("apps/site/\{name}") is Directory && @fs.exists(pkg) {
      found.push((name, @fs.read_file(pkg).text()))
    }
  }
  found
}

///|
/// Test native consumer adapters, then the browser behavior of the selected tree.
fn test_steps(
  args : Array[String],
  packages : Array[String],
  tree~ : String = "",
) -> Array[Step] raise Failure {
  if args is [arg, ..] {
    raise Failure("unknown option `\{arg}`. \{usage}")
  }
  [
    install_step,
    run(
      "test site packages (native)",
      "moon",
      ["test", "--target", "native", "-p", ..packages],
    ),
    // The Playwright CLI of the locked `playwright` package. It does nothing when the browser is
    // already installed, for example from the CI cache.
    run("install chromium", "node", [
      "apps/site/node_modules/playwright/cli.js", "install", "chromium",
    ]),
    run("test SVG paint in chromium", "node", ["apps/site/scripts/svg-test.ts"]),
    {
      name: "browser smoke test",
      action: BrowserTest(browser_test_port, tree),
    },
  ]
}

///|
/// Run one step. Returns 0, or a positive exit code.
async fn run_step(step : Step) -> Int32 {
  match step.action {
    Run(command, args) => {
      let code = @process.run(
        if command == "moon" {
          "mise"
        } else {
          command
        },
        if command == "moon" {
          ["exec", "--", "moon", ..args]
        } else {
          args
        },
        stdout=@stdio.stdout,
        stderr=@stdio.stderr,
      ) catch {
        error => {
          eprintln("❌ \{step.name}: \{error}")
          return 1
        }
      }
      if code > 0 {
        code
      } else if code < 0 {
        1
      } else {
        0
      }
    }
    BrowserTest(port, tree) => {
      let site = site_base(@fs.read_file("site/site.json").text()) catch {
        error => {
          eprintln("❌ \{step.name}: \{error}")
          return 1
        }
      }
      let base = site + tree
      let code = (@async.with_task_group() <| group => {
        // The group stops the server when the test ends. `moonx` runs the script in its own
        // process, so the server stops with it.
        group.spawn_bg(no_wait=true, () => {
          ignore(
            @process.run(
              "moonx",
              [
                "scripts/serve-site.mbtx",
                "--no-watch",
                "--port",
                port.to_string(),
              ],
              stdout=@stdio.stdout,
              stderr=@stdio.stderr,
            ),
          )
        })
        @process.run(
          "node",
          [browser_test_script],
          extra_env={
            "SITE_ORIGIN": "http://127.0.0.1:\{port}",
            "SITE_BASE": base,
          },
          stdout=@stdio.stdout,
          stderr=@stdio.stderr,
        )
      }) catch {
        error => {
          eprintln("❌ \{step.name}: \{error}")
          return 1
        }
      }
      if code > 0 {
        code
      } else if code < 0 {
        1
      } else {
        0
      }
    }
  }
}

///|
/// Run `steps` in order and stop at the first failure. Returns 0, or the exit code of the failed step
/// (1 when that code is not positive).
async fn run_steps(steps : Array[Step]) -> Int32 {
  for step in steps {
    println("🔨 \{step.name}")
    let code = run_step(step)
    if code != 0 {
      eprintln("❌ Step failed: \{step.name}")
      return code
    }
  }
  0
}

///|
async fn main {
  let args = @env.args()[1:]
  guard args is [command, .. rest] else {
    eprintln(usage)
    @sys.exit(2)
    return
  }
  let (steps, done) = try {
    let (rest, tree_name) = split_tree(rest.to_owned())
    let tree = tree_of(tree_name)
    match command {
      "build" =>
        (
          build_steps(
            rest,
            api=api_dirs(@fs.read_file("site/site.json").text()),
            tree~,
          ),
          "✅ Built \{tree_dir(tree)}/",
        )
      "check" =>
        (
          check_steps(
            rest,
            tree~,
            base=site_base(@fs.read_file("site/site.json").text()),
          ),
          "✅ Checked \{tree_dir(tree)}/",
        )
      "test" =>
        (
          test_steps(rest, native_packages(site_packages()), tree~),
          "✅ Site tests passed",
        )
      "assemble" =>
        if tree_name is Some(_) {
          raise Failure("`assemble` takes no tree. \{usage}")
        } else {
          (assemble_steps(rest), "✅ Assembled \{out_dir}/")
        }
      _ => raise Failure("unknown command `\{command}`. \{usage}")
    }
  } catch {
    Failure(message) => {
      eprintln("❌ \{message}")
      @sys.exit(2)
      return
    }
    error => {
      eprintln("❌ \{error}")
      @sys.exit(1)
      return
    }
  }
  let code = run_steps(steps)
  if code != 0 {
    @sys.exit(code)
  }
  println(done)
}

///|
test "the api key gives the module directories" {
  assert_eq(api_dirs("{\"api\": [\"pkgs/diagrams\", \"pkgs/notebooks\"]}"), [
    "pkgs/diagrams", "pkgs/notebooks",
  ])
  assert_eq(api_dirs("{}"), [])
  assert_eq(api_dirs("not json"), [])
}

///|
test "release builds accept only the workspace minor line" {
  assert_eq(tree_path("next", line="0.2"), "next/")
  assert_eq(tree_path("0.2", line="0.2"), "v/0.2/")
  let error = try tree_path("0.1", line="0.2") catch {
    Failure(message) => message
  } noraise {
    _ => ""
  }
  assert_true(error.contains("moon.mod has the minor line 0.2"))
}
