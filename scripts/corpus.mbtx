///|
/// Check and embed the frozen corpus of Mermaid examples.
///
/// The corpus is in `tests/corpus/mermaid-12.2.0/`. `SHA256SUMS` lists the SHA-256 digest of each
/// example file. Tests on the wasm targets cannot read files, so `tests/corpus/examples.generated.mbt`
/// embeds the text and the digest of each example.
///
/// - `check` fails when a digest does not match its file, when a listed file is missing, when an
///   example file is not listed, or when the generated file is not current.
/// - `generate` writes the generated file again.
///
/// Usage: `mise run validate:corpus` or `mise run corpus:generate`, or
/// `moonx scripts/corpus.mbtx check|generate`. The script exits with 1 on failure.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/sys",
}

///|
let corpus_dir : String = "tests/corpus/mermaid-12.2.0"

///|
let generated_path : String = "tests/corpus/examples.generated.mbt"

///|
let usage : String = "Usage: corpus.mbtx check | generate"

///|
fn fail_with(message : String) -> Unit {
  eprintln("❌ \{message}")
  @sys.exit(1)
}

///|
/// The `(digest, path)` pairs of a `shasum -a 256` listing. A line that is empty gives nothing.
fn parse_sums(text : String) -> Array[(String, String)] raise Failure {
  let out = []
  for line in text.split("\n") {
    let line = line.trim(chars=" \r").to_owned()
    if line == "" {
      continue
    }
    guard line.find("  ") is Some(at) && at == 64 else {
      raise Failure("not a shasum line: \{line}")
    }
    out.push(
      (
        line.view(end_offset=64).to_owned(),
        line.view(start_offset=66).to_owned(),
      ),
    )
  }
  out
}

///|
/// The SHA-256 digest of the UTF-8 encoding of `text`, as lowercase hex.
fn digest(text : String) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(@utf8.encode(text)))
}

///|
/// `text` as a MoonBit string literal.
fn literal(text : String) -> String {
  let buf = StringBuilder()
  buf.write_char('"')
  for c in text {
    match c {
      '"' => buf.write_string("\\\"")
      '\\' => buf.write_string("\\\\")
      '\n' => buf.write_string("\\n")
      '\r' => buf.write_string("\\r")
      '\t' => buf.write_string("\\t")
      _ => buf.write_char(c)
    }
  }
  buf.write_char('"')
  buf.to_string()
}

///|
/// The name of an example: its file name without the folder and the `.mmd` extension.
fn example_name(path : String) -> String {
  let base = match path.rev_find("/") {
    Some(i) => path.view(start_offset=i + 1).to_owned()
    None => path
  }
  if base.has_suffix(".mmd") {
    base.view(end_offset=base.length() - 4).to_owned()
  } else {
    base
  }
}

///|
/// The text of the generated file for `examples`, each `(name, digest, text)`.
fn generated(examples : Array[(String, String, String)]) -> String {
  let buf = StringBuilder()
  buf.write_string(
    "// Generated by `mise run corpus:generate` from tests/corpus/mermaid-12.2.0. Do not edit.\n\n",
  )
  buf.write_string("///|\n")
  buf.write_string(
    "/// The sequence examples of the Mermaid 12.2.0 documentation, in document order.\n",
  )
  buf.write_string("pub let mermaid_12_2_0 : ReadOnlyArray[Example] = [\n")
  for e in examples {
    buf.write_string(
      "  { name: \{literal(e.0)}, sha256: \{literal(e.1)}, source: \{literal(e.2)} },\n",
    )
  }
  buf.write_string("]\n")
  buf.to_string()
}

///|
/// The examples of the corpus, checked against `SHA256SUMS`. Each problem is an entry of `problems`.
async fn read_corpus(
  problems : Array[String],
) -> Array[(String, String, String)] {
  let listing = @fs.read_file("\{corpus_dir}/SHA256SUMS").text()
  let sums = parse_sums(listing) catch {
    Failure(m) => {
      problems.push(m)
      []
    }
  }
  let listed = sums.map(s => s.1)
  for file in @fs.readdir("\{corpus_dir}/examples", sort=true) {
    if file.has_suffix(".mmd") && !listed.contains("examples/\{file}") {
      problems.push("examples/\{file} is not listed in SHA256SUMS")
    }
  }
  let examples = []
  for s in sums {
    let (expected, path) = s
    let full = "\{corpus_dir}/\{path}"
    guard @fs.exists(full) else {
      problems.push("\{path} is listed in SHA256SUMS but is missing")
      continue
    }
    let text = @fs.read_file(full).text()
    let actual = digest(text)
    if actual != expected {
      problems.push("\{path}: SHA-256 is \{actual}, SHA256SUMS has \{expected}")
    }
    examples.push((example_name(path), expected, text))
  }
  examples
}

///|
/// Embed the independent reference output without importing its parser in CI.
async fn references(
  examples : Array[(String, String, String)],
  problems : Array[String],
) -> String {
  let out = StringBuilder()
  out.write_string(
    "// Generated by `mise run corpus:generate`. Do not edit.\n\n///|\npub let sequence_references : ReadOnlyArray[(String, String)] = [\n",
  )
  let dir = "\{corpus_dir}/reference"
  for (name, sha, _) in examples {
    let path = "\{dir}/\{name}.json"
    if !@fs.exists(path) {
      problems.push("Missing reference fixture: \{path}")
      continue
    }
    let text = @fs.read_file(path).text()
    let doc = Some(@json.parse(text)) catch { _ => None }
    match doc {
      Some(
        Object(
          {
            "reference": String("moonbit-community/mermaid@0.2.0"),
            "source_sha256": String(found),
            "model": Object(_),
            ..
          }
        )
      ) if found == sha => ()
      _ =>
        problems.push(
          "\{path}: invalid provenance or source digest; run `mise run corpus:reference`",
        )
    }
    out.write_string("  (\{literal(name)}, \{literal(text)}),\n")
  }
  if @fs.exists(dir) {
    for file in @fs.readdir(dir, sort=true) {
      if file.has_suffix(".json") &&
        !examples.iter().any(e => "\{e.0}.json" == file) {
        problems.push("Unexpected reference fixture: \{file}")
      }
    }
  }
  out.write_string("]\n")
  out.to_string()
}

///|
async fn check() -> Unit {
  let problems = []
  let examples = read_corpus(problems)
  let reference_text = references(examples, problems)
  let reference_path = "tests/corpus/reference.generated.mbt"
  if !@fs.exists(reference_path) ||
    @fs.read_file(reference_path).text() != reference_text {
    problems.push(
      "\{reference_path} is not current; run `mise run corpus:generate`",
    )
  }
  let current = if @fs.exists(generated_path) {
    @fs.read_file(generated_path).text()
  } else {
    ""
  }
  if current != generated(examples) {
    problems.push(
      "\{generated_path} is not current; run `mise run corpus:generate`",
    )
  }
  if problems.length() > 0 {
    for p in problems {
      eprintln("❌ \{p}")
    }
    @sys.exit(1)
  }
  println("✅ \{examples.length()} corpus examples match their digests")
}

///|
async fn generate() -> Unit {
  let problems = []
  let examples = read_corpus(problems)
  let reference_text = references(examples, problems)
  if problems.length() > 0 {
    fail_with(problems.join("\n"))
    return
  }
  @fs.write_file(generated_path, generated(examples))
  @fs.write_file("tests/corpus/reference.generated.mbt", reference_text)
  println("✅ Wrote \{generated_path} with \{examples.length()} examples")
}

///|
async fn main {
  match @env.args()[1:] {
    ["check"] => check()
    ["generate"] => generate()
    _ => fail_with(usage)
  }
}

///|
test "a shasum listing gives its digests and paths" {
  let d = "b2066a62d878a2b2b1ad49be0674b68d0fb78deed9c5def176cfcb2340403d25"
  assert_eq(parse_sums("\{d}  examples/01.mmd\n\n"), [(d, "examples/01.mmd")])
  let failed = try parse_sums("not a line\n") catch {
    Failure(_) => true
  } noraise {
    _ => false
  }
  assert_true(failed)
}

///|
test "the digest is SHA-256 of the UTF-8 text" {
  assert_eq(
    digest("abc"),
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
  )
}

///|
test "a literal escapes quotes, backslashes and line breaks" {
  assert_eq(literal("a \"b\" \\ c\n\td"), "\"a \\\"b\\\" \\\\ c\\n\\td\"")
}

///|
test "an example is named after its file" {
  assert_eq(example_name("examples/07.mmd"), "07")
}
