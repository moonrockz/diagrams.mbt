----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/test",
}
----

///|

///|
/// Write the review gallery after checking snapshots against the renderer.

///|
fn escape(text : String) -> String {
  text
  .replace_all(old="&", new="&amp;")
  .replace_all(old="<", new="&lt;")
  .replace_all(old=">", new="&gt;")
  .replace_all(old="\"", new="&quot;")
}

///|
/// Keep canonical bytes as inert text, independent from the displayed viewport.
fn preview_panel(
  file : String,
  svg : String,
  caption : String,
  title : String,
  theme : String,
) -> String {
  let canonical = escape(svg)
    .replace_all(old="\r", new="&#13;")
    .replace_all(old="(", new="&#40;")
    .replace_all(old=")", new="&#41;")
    .replace_all(old="/", new="&#47;")
  let name = file.replace_all(old=".svg", new="")
  let caption = if caption == "" { escape(title) } else { caption }
  "<figure class=\"diagram-viewer \{theme}\" data-diagram-viewer data-raster-name=\"\{escape(name)}\" data-raster-theme=\"\{theme}\"><figcaption>\{caption}</figcaption><div class=\"diagram-viewer__viewport\"><div class=\"diagram-viewer__content\"><img loading=\"lazy\" src=\"\{escape(file)}\" alt=\"\{escape(title)}\"></div></div><template class=\"diagram-viewer__canonical\">\{canonical}</template></figure>"
}

///|
fn source_panel(file : String, text : String) -> String {
  "<details class=\"gallery-source\" data-gallery-source><summary>Original source</summary><p><span>\{escape(file)}</span> · <a download href=\"\{escape(file)}\">Download source</a></p><pre tabindex=\"0\" aria-label=\"\{escape(file)} source\"><code>\{escape(text).replace_all(old="\r", new="&#13;")}</code></pre></details>"
}

///|
async fn snapshot_gallery(
  html : StringBuilder,
  path : String,
  check : Bool,
  site_assets : Bool,
  source_dir : String?,
) -> Unit {
  let mut source : (String, String)? = None
  for row in rows(path) {
    let name = string(row[0])
    let media = string(row[1])
    let content = string(row[2])
    if media == "text/plain" {
      if source is Some((file, text)) {
        html.write_string("</div>" + source_panel(file, text) + "</article>")
      }
      let source_name = match name {
        "flowchart-mermaid-review.mmd" => "mermaid-review.mmd"
        "flowchart-plantuml-modern.puml" => "plantuml-modern-order.puml"
        "flowchart-plantuml-legacy.puml" => "plantuml-legacy-request.puml"
        _ => name
      }
      if source_dir is Some(dir) &&
        @fs.read_file(dir + source_name).text() != content {
        raise Failure("Stale gallery source: " + name)
      }
      source = Some((name, content))
      html.write_string("<article><h3>\{escape(name)}</h3><div class=\"pair\">")
    }
    if media != "text/plain" {
      guard source is Some((file, _)) else {
        raise Failure("Preview has no declared source: " + name)
      }
      let stem = file
        .replace_all(old=".mmd", new="")
        .replace_all(old=".puml", new="")
      if !name.has_prefix(stem + "-") {
        raise Failure("Preview does not belong to declared source: " + name)
      }
    }
    save(name, content, check, site_assets)
    html.write_string("<p><a href=\"\{escape(name)}\">\{escape(name)}</a></p>")
    if media == "image/svg+xml" &&
      (name.has_suffix("-light.svg") || name.has_suffix("-dark.svg")) {
      html.write_string(
        preview_panel(
          name,
          content,
          "",
          name,
          if name.has_suffix("-dark.svg") {
            "dark"
          } else {
            "light"
          },
        ),
      )
    }
  }
  if source is Some((file, text)) {
    html.write_string("</div>" + source_panel(file, text) + "</article>")
  }
}

///|
async fn trusted_asset(path : String) -> String {
  let source = @fs.read_file(path).text()
  if source.to_lower().contains("</script") ||
    source.to_lower().contains("</style") {
    raise Failure("Trusted gallery asset contains an HTML terminator: " + path)
  }
  source
}

///|
fn string(value : Json) -> String raise Failure {
  guard value is String(text) else { raise Failure("Expected snapshot string") }
  text
}

///|
async fn rows(path : String) -> Array[Array[Json]] {
  guard @json.parse(@fs.read_file(path).text()) is Array(values) else {
    raise Failure("Expected snapshot rows")
  }
  let result = []
  for value in values {
    guard value is Array(row) else { raise Failure("Expected snapshot row") }
    result.push(row)
  }
  result
}

///|
async fn save(name : String, text : String, check : Bool, site : Bool) -> Unit {
  let paths = []
  if !@env.args().contains("--site-assets-only") {
    paths.push("_gallery/" + name)
  }
  if site {
    paths.push("apps/site/assets/examples/" + name)
  }
  for path in paths {
    if check {
      if !@fs.exists(path) || @fs.read_file(path).text() != text {
        raise Failure("Stale or missing gallery artifact: " + path)
      }
    } else {
      @fs.write_file(path, text)
    }
  }
}

///|
async fn main {
  let args = @env.args()
  let check = args.contains("--check")
  let site_assets = args.contains("--site-assets")
  let local_gallery = !args.contains("--site-assets-only")
  let raster_path = "pkgs/diagrams-animated/assets/raster.generated.js"
  let raster_available = @fs.exists(raster_path)
  if local_gallery && !raster_available && !args.contains("--existing-output") {
    raise Failure(
      "Missing supported raster browser payload: " +
      raster_path +
      ". Build the raster assets before normal gallery generation; --existing-output permits explicit viewport-only review.",
    )
  }
  if !args.contains("--existing-output") && !check {
    for
      package_name in [
        "moonrockz/diagrams-tests/acceptance", "moonrockz/diagrams-tests/bpmn-acceptance",
        "moonrockz/diagrams-tests/animation-acceptance", "moonrockz/diagrams-tests/plantuml-acceptance",
        "moonrockz/diagrams-tests/zenuml-integration", "moonrockz/diagrams-tests/flowchart-gallery-acceptance",
        "moonrockz/diagrams-tests/gallery-expansion-acceptance", "moonrockz/diagrams-tests/state-gallery-acceptance",
      ] {
      let code = @process.run(
        "moon",
        ["test", "--target", "js", "-p", package_name],
        stdout=@stdio.stdout,
        stderr=@stdio.stderr,
      )
      if code != 0 {
        @sys.exit(if code > 0 { code } else { 1 })
      }
    }
  }
  if site_assets && !@fs.exists("apps/site/assets/examples") {
    @fs.mkdir("apps/site/assets/examples", recursive=true)
  }
  if !args.contains("--site-assets-only") && !@fs.exists("_gallery") {
    @fs.mkdir("_gallery", recursive=true)
  }
  let html = StringBuilder()
  html.write_string(
    (
      #|<!doctype html>
      #|<html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
      #|<title>Diagram review gallery</title>
      #|<style>
      #|html{color-scheme:light dark}body{margin:2rem;background:#f9fafb;color:#111827;font:16px system-ui;overflow-wrap:anywhere}h1{font-size:1.8rem}
      #|article{margin:2rem 0}h2 a{color:inherit}.pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
      #|figure{margin:0;overflow:auto;border-radius:8px}figcaption{padding:.75rem;font-weight:600}
      #|img{display:block;max-width:100%;height:auto}.diagram-viewer{min-width:0}.diagram-viewer__viewport{margin:.5rem}.diagram-viewer__export{width:auto}
      #|pre{min-width:0;max-width:100%;overflow-wrap:normal;overflow:auto;padding:1rem;background:#fff;border-radius:8px}summary{cursor:pointer;margin-top:1rem}
      #|@media(max-width:900px){.pair{grid-template-columns:1fr}body{margin:1rem}}
      #|@media(prefers-color-scheme:dark){body{background:#0f1014;color:#e5e7eb}pre{background:#17181f}a{color:#a5b4fc}}
      #|</style>
    ),
  )
  if local_gallery {
    html.write_string(
      "<style>" +
      trusted_asset("pkgs/diagrams-animated/assets/viewer.css") +
      trusted_asset("scripts/assets/gallery-inspection.css") +
      "</style>",
    )
  }
  html.write_string(
    (
      #|<h1>Diagram review gallery</h1>
      #|<nav><a href="#bpmn">BPMN views and XML</a> · <a href="#animation">Offline players</a> · <a href="#plantuml">PlantUML regex, EBNF, JSON and YAML</a> · <a href="#sequence">Sequence corpus</a> · <a href="#flowcharts">Flowcharts</a></nav>
      #|<p>Processes and collaborations render with supplied or automatic geometry. Choreography and conversation documents are retained and validated; their rendering is deferred.</p>
      #|<p>Players illustrate drawn connections. Conditions, timer triggers and gateway synchronization are not evaluated. No tokens or process execution are simulated.</p>
      #|<h2 id="sequence">Sequence corpus</h2><p>All 38 frozen Mermaid 12.2.0 examples, rendered with the classic dark and light palettes.
      #|The task verifies these SVG bytes against the current renderer before writing this page.
      #|Use the corner controls to enlarge, zoom, pan or fit each diagram. Choose Source to compare the original syntax.</p>
      #|
    ),
  )
  if local_gallery && !raster_available {
    html.write_string(
      "<p role=\"status\" data-raster-unavailable>Viewport-only review: the supported raster browser payload has not been built. PNG/JPEG export is unavailable. Build the raster assets and regenerate this gallery for export qualification.</p>",
    )
  }
  let base = "tests/corpus/mermaid-12.2.0"
  for line in @fs.read_file("\{base}/SHA256SUMS").text().split("\n") {
    if line.trim() == "" {
      continue
    }
    let path = line.view(start_offset=66).trim().to_owned()
    let name = path
      .replace_all(old="examples/", new="")
      .replace_all(old=".mmd", new="")
    html.write_string(
      "<article id=\"example-\{name}\"><h2><a href=\"#example-\{name}\">Example \{name}</a></h2><div class=\"pair\">",
    )
    for variant in ["dark", "light"] {
      let file = "\{name}-\{variant}.svg"
      let svg = @fs.read_file("tests/acceptance/__snapshot__/svg/\{file}")
      save(file, svg.text(), check, site_assets && name == "01")
      html.write_string(
        preview_panel(
          file,
          svg.text(),
          "<a href=\"\{file}\">\{variant} SVG</a>",
          "Example \{name}, \{variant} theme",
          variant,
        ),
      )
    }
    let source = @fs.read_file("\{base}/\{path}").text()
    let source_name = name + ".mmd"
    save(source_name, source, check, false)
    html.write_string(
      "</div>" + source_panel(source_name, source) + "</article>\n",
    )
  }
  save(
    "sequence-basic.mmd",
    @fs.read_file("tests/corpus/mermaid-12.2.0/examples/01.mmd").text(),
    check,
    site_assets,
  )
  html.write_string(
    "<h2 id=\"bpmn\">BPMN process and collaboration views</h2><p>Project-authored Apache-2.0 fixtures retain their XML and exact supplied DI. Automatic views deliberately ignore DI.</p>",
  )
  let images : Map[String, String] = Map([])
  for row in rows("tests/bpmn-acceptance/__snapshot__/scenes.json") {
    images[string(row[0]) + "/" + string(row[1])] = string(row[2])
  }
  for source_name in ["process-di.bpmn", "collaboration-di.bpmn"] {
    let xml = @fs.read_file("tests/corpus/bpmn-render/" + source_name).text()
    save(source_name, xml, check, site_assets)
    for policy in ["supplied", "automatic"] {
      let name = source_name + "/" + policy
      let id = "bpmn-" +
        source_name.replace_all(old=".bpmn", new="") +
        "-" +
        policy
      html.write_string(
        "<article id=\"\{id}\"><h3>\{escape(name)}</h3><p><a href=\"\{source_name}\">BPMN XML</a></p><div class=\"pair\">",
      )
      for variant in ["dark", "light"] {
        let file = id + "-" + variant + ".svg"
        save(file, images[name + "/" + variant], check, site_assets)
        html.write_string(
          preview_panel(
            file,
            images[name + "/" + variant],
            "<a href=\"\{file}\">\{variant} SVG</a>",
            name + " " + variant,
            variant,
          ),
        )
      }
      html.write_string(
        "</div>" + source_panel(source_name, xml) + "</article>",
      )
    }
  }
  html.write_string(
    "<details><summary>Typed document coverage, including deferred views</summary><p>These process, collaboration, choreography and conversation inputs are document fixtures. Rendering choreography/conversations is explicitly deferred.</p><ul>",
  )
  for
    name in [
      "activities", "events", "collaboration", "di-views", "choreography-conversation",
    ] {
    let file = "document-" + name + ".bpmn"
    save(
      file,
      @fs.read_file("tests/corpus/bpmn-model/" + name + ".bpmn").text(),
      check,
      false,
    )
    html.write_string("<li><a href=\"\{file}\">\{name} XML</a></li>")
  }
  html.write_string(
    "</ul></details><h2 id=\"animation\">Standalone offline players</h2><p>Open either fixed SVG theme. Use Play, Step and Position; choose structural routes or reachability; download the exact static SVG. The player controls follow the browser preference.</p>",
  )
  let players : Map[String, String] = Map([])
  let swimlane_svgs : Map[String, String] = Map([])
  for row in rows("tests/animation-acceptance/__snapshot__/players.json") {
    players[string(row[0])] = string(row[1])
    if string(row[0]).has_prefix("swimlane-") {
      swimlane_svgs[string(row[0])] = string(row[2])
    }
  }
  for
    (kind, title) in [
      ("bpmn-collaboration", "BPMN collaboration"),
      (
        "sequence-scenario", "Finite sequence scenario: alternative, repeated loop and parallel branches",
      ),
    ] {
    html.write_string("<article id=\"\{kind}\"><h3>\{title}</h3><ul>")
    for variant in ["dark", "light"] {
      let file = kind + "-" + variant + ".html"
      save(file, players[kind + "-" + variant], check, site_assets)
      html.write_string(
        "<li><a href=\"\{file}\">Open \{variant} player</a></li>",
      )
    }
    html.write_string("</ul>")
    if kind == "bpmn-collaboration" {
      html.write_string(
        source_panel(
          "collaboration-di.bpmn",
          @fs.read_file("tests/corpus/bpmn-render/collaboration-di.bpmn").text(),
        ),
      )
    } else {
      html.write_string(
        "<p data-source-unavailable>Original source unavailable: model-only fixture in tests/animation-acceptance/player_test.mbt.</p>",
      )
    }
    html.write_string("</article>")
  }
  for
    (name, title) in [
      ("bpmn-automatic", "Automatic BPMN process"),
      (
        "bpmn-concurrent", "Finite BPMN scenario with repeated concurrent occurrences",
      ),
    ] {
    let file = name + ".html"
    save(file, players[name], check, site_assets)
    html.write_string("<p><a href=\"\{file}\">\{title}</a></p>")
  }
  html.write_string(
    "<h2 id=\"swimlanes\">Native Mermaid swimlanes</h2><p>Ordered responsibility bands retain explicit directed interactions. The examples include bidirectional review/return, parallel edges and opt-in unheaded connections.</p>",
  )
  let swimlane_source = @fs.read_file(
    "tests/corpus/mermaid-swimlanes/cases/review.mmd",
  ).text()
  save("swimlane-review.mmd", swimlane_source, check, site_assets)
  html.write_string(
    "<article id=\"local-swimlane-review\"><h3>Review</h3><div class=\"pair\">",
  )
  for variant in ["dark", "light"] {
    let name = "swimlane-review-" + variant
    save(name + ".svg", swimlane_svgs[name], check, site_assets)
    save(name + ".html", players[name], check, site_assets)
    html.write_string(
      preview_panel(
        name + ".svg",
        swimlane_svgs[name],
        "<a href=\"\{name}.html\">Open \{variant} review player</a> · <a href=\"\{name}.svg\">static SVG</a>",
        "Customer and Support review in " + variant,
        variant,
      ),
    )
  }
  html.write_string(
    "</div>" +
    source_panel("swimlane-review.mmd", swimlane_source) +
    "</article>",
  )
  for direction in ["tb", "bt", "lr", "rl"] {
    let name = "swimlane-" + direction
    save(name + ".svg", swimlane_svgs[name], check, site_assets)
    save(name + ".html", players[name], check, site_assets)
    html.write_string(
      "<p><a href=\"\{name}.html\">\{direction.to_upper()} flow player</a> · <a href=\"\{name}.svg\">static SVG</a></p>",
    )
  }
  for name in ["swimlane-reverse", "swimlane-scenario", "swimlane-collapsed"] {
    save(name + ".html", players[name], check, site_assets)
    html.write_string("<p><a href=\"\{name}.html\">\{name}</a></p>")
  }
  html.write_string(
    "<h2 id=\"plantuml\">PlantUML regex, EBNF, JSON and YAML</h2><p>Native PlantUML 1.2026.9 blocks, read and rendered by the MoonBit library without Java. Railroads show structure: they do not match or parse input. Trace highlights show evidence that an external provider supplied; this gallery uses a scripted test provider. Players visit terms and rows and follow only drawn connectors.</p>",
  )
  let plantuml : Map[String, String] = Map([])
  let plantuml_order : Array[String] = []
  for
    row in rows("tests/plantuml-acceptance/__snapshot__/plantuml-gallery.json") {
    plantuml[string(row[0])] = string(row[2])
    plantuml_order.push(string(row[0]))
  }
  let site_examples = [
    "regex-date.puml", "regex-date-dark.svg", "regex-date-light.svg", "regex-date-light.html",
    "ebnf-arithmetic.puml", "ebnf-arithmetic-dark.svg", "ebnf-arithmetic-light.svg",
    "ebnf-arithmetic-light.html", "json-order.puml", "json-order-light.svg", "json-order-dark.svg",
    "json-order-light.html", "yaml-service.puml", "yaml-service-light.svg", "yaml-service-dark.svg",
    "yaml-service-light.html", "regex-date-trace-success.svg", "regex-date-trace-failure.svg",
    "regex-date-trace-prefix.svg", "regex-date-trace-terminal.svg", "ebnf-arithmetic-trace-failure.svg",
  ]
  for name in plantuml_order {
    if name != "inline.html" {
      save(
        name,
        plantuml[name],
        check,
        site_assets && site_examples.contains(name),
      )
    }
  }
  for
    pair in [
      (
        "regex-date", "Regex: named groups, sets, repetitions and a negative lookahead",
      ),
      (
        "regex-constraints", "Regex: anchors, lookbehind, reluctant and nested repeats, backreference",
      ),
      ("regex-long", "Regex: a long pattern continues on new rows"),
      ("ebnf-arithmetic", "EBNF: recursive references and a note"),
      (
        "ebnf-constraints", "EBNF: counts, options, exclusions, rule notes and an empty rule",
      ),
      (
        "json-order", "JSON: nested collections, exact numbers, empty containers and a highlight",
      ),
      (
        "yaml-service", "YAML: native string scalars, flow and block values, lists of maps",
      ),
    ] {
    let (name, title) = pair
    html.write_string(
      "<article id=\"\{name}\"><h3>\{escape(title)}</h3><p><a href=\"\{name}.puml\">PlantUML source</a> · <a href=\"\{name}-dark.html\">dark player</a> · <a href=\"\{name}-light.html\">light player</a></p><div class=\"pair\">",
    )
    for variant in ["dark", "light"] {
      let file = name + "-" + variant + ".svg"
      html.write_string(
        preview_panel(
          file,
          plantuml[file],
          "<a href=\"\{file}\">\{variant} SVG</a>",
          title + ", " + variant + " theme",
          variant,
        ),
      )
    }
    html.write_string(
      "</div>" +
      source_panel(name + ".puml", plantuml[name + ".puml"]) +
      "</article>\n",
    )
  }
  html.write_string(
    "<h3 id=\"plantuml-traces\">Independent trace highlight channels</h3><p>Matched paths are solid, non-matched paths are dashed, the taken path or prefix has its own colour, and failure points have a cross marker. Each channel can be shown alone. Unvisited branches stay neutral.</p>",
  )
  for name in ["regex-date", "ebnf-arithmetic"] {
    html.write_string(
      "<article><h3>\{escape(name)} traces</h3><div class=\"pair\">",
    )
    for
      variant in [
        ("success", "matched and not-matched attempts"),
        ("failure", "failed attempt and failure point"),
        ("prefix", "taken prefix only"),
        ("terminal", "failure terminal only"),
        ("dark", "dark theme with taken path"),
      ] {
      let file = name + "-trace-" + variant.0 + ".svg"
      html.write_string(
        preview_panel(
          file,
          plantuml[file],
          "<a href=\"\{file}\">\{name}: \{variant.1}</a>",
          name + " trace, " + variant.1,
          if variant.0 == "dark" {
            "dark"
          } else {
            "light"
          },
        ),
      )
    }
    html.write_string(
      "</div>" +
      source_panel(name + ".puml", plantuml[name + ".puml"]) +
      "</article>",
    )
  }
  html.write_string(
    "<p><a href=\"ebnf-scenario.html\">Explicit EBNF scenario with term visits and a return loop</a> · <a href=\"ebnf-arithmetic-trace-light.html\">Player with configured static trace highlights</a></p>",
  )
  html.write_string(
    "<h2 id=\"native-mermaid\">Mermaid ZenUML and architecture</h2><p>Native interactions retain participant symbols. Architecture playback follows authored connections and does not execute deployments. <a href=\"icon-contact-sheet.svg\">Complete 523-key symbol contact sheet</a>.</p>",
  )
  snapshot_gallery(
    html,
    "tests/zenuml-integration/__snapshot__/new-gallery.json",
    check,
    site_assets,
    None,
  )
  html.write_string(
    "<h2 id=\"flowcharts\">Mermaid and PlantUML flowcharts</h2><p>Mermaid flowchart/graph and modern/legacy PlantUML activity examples keep groups, branches, loop returns and parallel paths. Players illustrate structure and caller-supplied scenarios. They do not evaluate conditions, execute actions or assert synchronization.</p>",
  )
  snapshot_gallery(
    html,
    "tests/flowchart-gallery-acceptance/__snapshot__/flowchart-gallery.json",
    check,
    site_assets,
    Some("site/examples/flowcharts/"),
  )
  html.write_string(
    "<h2 id=\"states\">Mermaid and PlantUML state diagrams</h2><p>States, composite and concurrent regions, pseudostates and history are authored structure. Playback illustrates finite supplied scenarios without evaluating guards, executing actions or restoring history.</p>",
  )
  snapshot_gallery(
    html,
    "tests/state-gallery-acceptance/__snapshot__/state-gallery.json",
    check,
    site_assets,
    Some("site/examples/states/"),
  )
  html.write_string(
    "<h2 id=\"expanded-gallery\">Thirty additional source examples</h2><p>The published baseline has 15 cards. This section adds three distinct sources in each of its ten families. Theme, player and connector comparison variants do not count as additional sources.</p>",
  )
  let expanded_artifacts : Map[String, String] = Map([])
  for
    row in rows(
      "tests/gallery-expansion-acceptance/__snapshot__/expanded-gallery.json",
    ) {
    let name = string(row[0])
    let content = string(row[2])
    if name == "connector-crossing.mmd" &&
      @fs.read_file("site/examples/connectors/crossing.mmd")
      .text()
      .trim_end()
      .to_owned() !=
      content.trim_end().to_owned() {
      raise Failure("Stale connector comparison source fixture")
    }
    expanded_artifacts[name] = content
    save(name, content, check, site_assets)
  }
  for entry in expanded_gallery_examples() {
    guard entry is Object(fields) else {
      raise Failure("Invalid expanded gallery entry")
    }
    let id = string(fields["id"])
    let title = string(fields["title"])
    guard fields["sources"] is Array(sources) else {
      raise Failure("Missing expanded sources")
    }
    guard sources[0] is Object(source) else {
      raise Failure("Missing expanded source")
    }
    let source_name = string(source["path"])
    html.write_string(
      "<article id=\"expanded-\{id}\"><h3>\{escape(title)}</h3><p>\{escape(string(fields["family"]))}: \{escape(string(fields["description"]))}</p><p>\{escape(string(fields["scope"]))}</p><p><a href=\"\{source_name}\">Exact source</a> · <a href=\"\{id}-adaptive.svg\">adaptive SVG</a></p><div class=\"pair\">",
    )
    for variant in ["light", "dark"] {
      let name = id + "-" + variant
      html.write_string(
        preview_panel(
          name + ".svg",
          expanded_artifacts[name + ".svg"],
          "<a href=\"\{name}.svg\">\{variant} SVG</a> · <a href=\"\{name}.html\">offline player</a>",
          title + ", " + variant,
          variant,
        ),
      )
    }
    html.write_string(
      "</div>" +
      source_panel(source_name, expanded_artifacts[source_name]) +
      "</article>",
    )
  }
  save(
    "icon-contact-sheet.svg",
    @fs.read_file(
      "tests/zenuml-integration/__snapshot__/icon-contact-sheet.svg",
    ).text(),
    check,
    false,
  )
  if local_gallery {
    html.write_string(
      "<script>" +
      trusted_asset("pkgs/diagrams-animated/assets/viewer.js") +
      trusted_asset("scripts/assets/gallery-inspection.js") +
      "</script>",
    )
    if raster_available {
      html.write_string(
        "<script>" +
        trusted_asset(raster_path) +
        "</script><script>" +
        trusted_asset("pkgs/diagrams-animated/assets/gallery-export.js") +
        "</script>",
      )
    }
  }
  html.write_string("</html>\n")
  save("index.html", html.to_string(), check, false)
  if site_assets {
    save_site_gallery(check)
  }
  if args.contains("--qualify") {
    for
      (command, arguments) in [
        ("bun", ["install", "--frozen-lockfile", "--cwd", "apps/site"]),
        (
          "node",
          ["apps/site/node_modules/playwright/cli.js", "install", "chromium"],
        ),
        ("node", ["apps/site/scripts/gallery-test.ts"]),
        ("node", ["apps/site/scripts/flowchart-test.ts"]),
        ("node", ["apps/site/scripts/state-test.ts"]),
      ] {
      let code = @process.run(
        command,
        arguments,
        stdout=@stdio.stdout,
        stderr=@stdio.stderr,
      )
      if code != 0 {
        @sys.exit(if code > 0 { code } else { 1 })
      }
    }
  }
  println("Gallery: _gallery/index.html")
}

///|
fn gallery_file(path : String, media_type : String) -> Json {
  { "path": path, "media_type": media_type }
}

///|
fn gallery_example(
  id : String,
  family : String,
  title : String,
  description : String,
  scope : String,
  source : String,
  source_type : String,
  preview : String,
  preview_dark? : String,
  player? : String,
) -> Json {
  let fields : Map[String, Json] = {
    "id": @json.to_json(id),
    "family": @json.to_json(family),
    "title": @json.to_json(title),
    "status": "implemented",
    "description": @json.to_json(description),
    "scope": @json.to_json(scope),
    "sources": @json.to_json([gallery_file(source, source_type)]),
    "preview": gallery_file(preview, "image/svg+xml"),
  }
  if preview_dark is Some(path) {
    fields["preview_dark"] = gallery_file(path, "image/svg+xml")
  }
  if player is Some(path) {
    fields["player"] = gallery_file(path, "text/html")
  }
  @json.to_json(fields)
}

