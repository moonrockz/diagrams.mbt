///|
/// Write the review gallery after checking snapshots against the renderer.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn escape(text : String) -> String {
  text
  .replace_all(old="&", new="&amp;")
  .replace_all(old="<", new="&lt;")
  .replace_all(old=">", new="&gt;")
  .replace_all(old="\"", new="&quot;")
}

///|
fn string(value : Json) -> String raise Failure {
  guard value is String(text) else { raise Failure("Expected snapshot string") }
  text
}

///|
async fn rows(path : String) -> Array[Array[Json]] {
  guard @json.parse(@fs.read_file(path).text()) is Array(values) else {
    raise Failure("Expected snapshot rows")
  }
  let result = []
  for value in values {
    guard value is Array(row) else { raise Failure("Expected snapshot row") }
    result.push(row)
  }
  result
}

///|
async fn save(name : String, text : String, check : Bool, site : Bool) -> Unit {
  let paths = []
  if !@env.args().contains("--site-assets-only") {
    paths.push("_gallery/" + name)
  }
  if site {
    paths.push("apps/site/assets/examples/" + name)
  }
  for path in paths {
    if check {
      if !@fs.exists(path) || @fs.read_file(path).text() != text {
        raise Failure("Stale or missing gallery artifact: " + path)
      }
    } else {
      @fs.write_file(path, text)
    }
  }
}

///|
async fn main {
  let args = @env.args()
  let check = args.contains("--check")
  let site_assets = args.contains("--site-assets")
  if !args.contains("--existing-output") && !check {
    for
      package_name in [
        "moonrockz/diagrams-tests/acceptance", "moonrockz/diagrams-tests/bpmn-acceptance",
        "moonrockz/diagrams-tests/animation-acceptance", "moonrockz/diagrams-tests/plantuml-acceptance",
      ] {
      let code = @process.run(
        "moon",
        ["test", "--target", "js", "-p", package_name],
        stdout=@stdio.stdout,
        stderr=@stdio.stderr,
      )
      if code != 0 {
        @sys.exit(if code > 0 { code } else { 1 })
      }
    }
  }
  if site_assets && !@fs.exists("apps/site/assets/examples") {
    @fs.mkdir("apps/site/assets/examples", recursive=true)
  }
  if !args.contains("--site-assets-only") && !@fs.exists("_gallery") {
    @fs.mkdir("_gallery", recursive=true)
  }
  let html = StringBuilder()
  html.write_string(
    (
      #|<!doctype html>
      #|<html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
      #|<title>Diagram review gallery</title>
      #|<style>
      #|body{margin:2rem;background:#e2e8f0;color:#0f172a;font:16px system-ui}h1{font-size:1.8rem}
      #|article{margin:2rem 0}h2 a{color:inherit}.pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
      #|figure{margin:0;overflow:auto;border-radius:8px}figcaption{padding:.75rem;font-weight:600}
      #|.dark{background:#020617;color:#e2e8f0}.light{background:#f4f5f7}img{display:block;max-width:none}
      #|pre{overflow:auto;padding:1rem;background:#fff;border-radius:8px}summary{cursor:pointer;margin-top:1rem}
      #|@media(max-width:900px){.pair{grid-template-columns:1fr}body{margin:1rem}}
      #|</style><h1>Diagram review gallery</h1>
      #|<nav><a href="#bpmn">BPMN views and XML</a> · <a href="#animation">Offline players</a> · <a href="#plantuml">PlantUML regex, EBNF, JSON and YAML</a> · <a href="#sequence">Sequence corpus</a></nav>
      #|<p>Processes and collaborations render with supplied or automatic geometry. Choreography and conversation documents are retained and validated; their rendering is deferred.</p>
      #|<p>Players illustrate drawn connections. Conditions, timer triggers and gateway synchronization are not evaluated. No tokens or process execution are simulated.</p>
      #|<h2 id="sequence">Sequence corpus</h2><p>All 38 frozen Mermaid 12.2.0 examples, rendered with the classic dark and light palettes.
      #|The task verifies these SVG bytes against the current renderer before writing this page.
      #|Each diagram scrolls at its natural size. Expand the source to compare syntax.</p>
      #|
    ),
  )
  let base = "tests/corpus/mermaid-12.2.0"
  for line in @fs.read_file("\{base}/SHA256SUMS").text().split("\n") {
    if line.trim() == "" {
      continue
    }
    let path = line.view(start_offset=66).trim().to_owned()
    let name = path
      .replace_all(old="examples/", new="")
      .replace_all(old=".mmd", new="")
    html.write_string(
      "<article id=\"example-\{name}\"><h2><a href=\"#example-\{name}\">Example \{name}</a></h2><div class=\"pair\">",
    )
    for variant in ["dark", "light"] {
      let file = "\{name}-\{variant}.svg"
      let svg = @fs.read_file("tests/acceptance/__snapshot__/svg/\{file}")
      save(file, svg.text(), check, false)
      html.write_string(
        "<figure class=\"\{variant}\"><figcaption><a href=\"\{file}\">\{variant} SVG</a></figcaption><img src=\"\{file}\" alt=\"Example \{name}, \{variant} theme\" loading=\"lazy\"></figure>",
      )
    }
    let source = escape(@fs.read_file("\{base}/\{path}").text())
    html.write_string(
      "</div><details><summary>Mermaid source</summary><pre><code>\{source}</code></pre></details></article>\n",
    )
  }
  html.write_string(
    "<h2 id=\"bpmn\">BPMN process and collaboration views</h2><p>Project-authored Apache-2.0 fixtures retain their XML and exact supplied DI. Automatic views deliberately ignore DI.</p>",
  )
  let images : Map[String, String] = Map([])
  for row in rows("tests/bpmn-acceptance/__snapshot__/scenes.json") {
    images[string(row[0]) + "/" + string(row[1])] = string(row[2])
  }
  for source_name in ["process-di.bpmn", "collaboration-di.bpmn"] {
    let xml = @fs.read_file("tests/corpus/bpmn-render/" + source_name).text()
    save(source_name, xml, check, site_assets)
    for policy in ["supplied", "automatic"] {
      let name = source_name + "/" + policy
      let id = "bpmn-" +
        source_name.replace_all(old=".bpmn", new="") +
        "-" +
        policy
      html.write_string(
        "<article id=\"\{id}\"><h3>\{escape(name)}</h3><p><a href=\"\{source_name}\">BPMN XML</a></p><div class=\"pair\">",
      )
      for variant in ["dark", "light"] {
        let file = id + "-" + variant + ".svg"
        save(file, images[name + "/" + variant], check, site_assets)
        html.write_string(
          "<figure class=\"\{variant}\"><figcaption><a href=\"\{file}\">\{variant} SVG</a></figcaption><img src=\"\{file}\" alt=\"\{escape(name)} \{variant}\" loading=\"lazy\"></figure>",
        )
      }
      html.write_string(
        "</div><details><summary>BPMN XML source</summary><pre><code>\{escape(xml)}</code></pre></details></article>",
      )
    }
  }
  html.write_string(
    "<details><summary>Typed document coverage, including deferred views</summary><p>These process, collaboration, choreography and conversation inputs are document fixtures. Rendering choreography/conversations is explicitly deferred.</p><ul>",
  )
  for
    name in [
      "activities", "events", "collaboration", "di-views", "choreography-conversation",
    ] {
    let file = "document-" + name + ".bpmn"
    save(
      file,
      @fs.read_file("tests/corpus/bpmn-model/" + name + ".bpmn").text(),
      check,
      false,
    )
    html.write_string("<li><a href=\"\{file}\">\{name} XML</a></li>")
  }
  html.write_string(
    "</ul></details><h2 id=\"animation\">Standalone offline players</h2><p>Open either fixed SVG theme. Use Play, Step and Position; choose structural routes or reachability; download the exact static SVG. The player controls follow the browser preference.</p>",
  )
  let players : Map[String, String] = Map([])
  let swimlane_svgs : Map[String, String] = Map([])
  for row in rows("tests/animation-acceptance/__snapshot__/players.json") {
    players[string(row[0])] = string(row[1])
    if string(row[0]).has_prefix("swimlane-") {
      swimlane_svgs[string(row[0])] = string(row[2])
    }
  }
  for
    (kind, title) in [
      ("bpmn-collaboration", "BPMN collaboration"),
      (
        "sequence-scenario", "Finite sequence scenario: alternative, repeated loop and parallel branches",
      ),
    ] {
    html.write_string("<article id=\"\{kind}\"><h3>\{title}</h3><ul>")
    for variant in ["dark", "light"] {
      let file = kind + "-" + variant + ".html"
      save(file, players[kind + "-" + variant], check, site_assets)
      html.write_string(
        "<li><a href=\"\{file}\">Open \{variant} player</a></li>",
      )
    }
    html.write_string("</ul></article>")
  }
  for
    (name, title) in [
      ("bpmn-automatic", "Automatic BPMN process"),
      (
        "bpmn-concurrent", "Finite BPMN scenario with repeated concurrent occurrences",
      ),
    ] {
    let file = name + ".html"
    save(file, players[name], check, site_assets)
    html.write_string("<p><a href=\"\{file}\">\{title}</a></p>")
  }
  html.write_string(
    "<h2 id=\"swimlanes\">Native Mermaid swimlanes</h2><p>Ordered responsibility bands retain explicit directed interactions. The examples include bidirectional review/return, parallel edges and opt-in unheaded connections.</p>",
  )
  let swimlane_source = @fs.read_file(
    "tests/corpus/mermaid-swimlanes/cases/review.mmd",
  ).text()
  save("swimlane-review.mmd", swimlane_source, check, site_assets)
  html.write_string(
    "<p><a href=\"swimlane-review.mmd\">Native Mermaid source</a></p><details><summary>Review source</summary><pre><code>\{escape(swimlane_source)}</code></pre></details>",
  )
  for variant in ["dark", "light"] {
    let name = "swimlane-review-" + variant
    save(name + ".svg", swimlane_svgs[name], check, site_assets)
    save(name + ".html", players[name], check, site_assets)
    html.write_string(
      "<figure class=\"\{variant}\"><figcaption><a href=\"\{name}.html\">Open \{variant} review player</a> · <a href=\"\{name}.svg\">static SVG</a></figcaption><img src=\"\{name}.svg\" alt=\"Customer and Support review in \{variant}\"></figure>",
    )
  }
  for direction in ["tb", "bt", "lr", "rl"] {
    let name = "swimlane-" + direction
    save(name + ".svg", swimlane_svgs[name], check, site_assets)
    save(name + ".html", players[name], check, site_assets)
    html.write_string(
      "<p><a href=\"\{name}.html\">\{direction.to_upper()} flow player</a> · <a href=\"\{name}.svg\">static SVG</a></p>",
    )
  }
  for name in ["swimlane-reverse", "swimlane-scenario", "swimlane-collapsed"] {
    save(name + ".html", players[name], check, site_assets)
    html.write_string("<p><a href=\"\{name}.html\">\{name}</a></p>")
  }
  html.write_string(
    "<h2 id=\"plantuml\">PlantUML regex, EBNF, JSON and YAML</h2><p>Native PlantUML 1.2026.9 blocks, read and rendered by the MoonBit library without Java. Railroads show structure: they do not match or parse input. Trace highlights show evidence that an external provider supplied; this gallery uses a scripted test provider. Players visit terms and rows and follow only drawn connectors.</p>",
  )
  let plantuml : Map[String, String] = Map([])
  let plantuml_order : Array[String] = []
  for
    row in rows("tests/plantuml-acceptance/__snapshot__/plantuml-gallery.json") {
    plantuml[string(row[0])] = string(row[2])
    plantuml_order.push(string(row[0]))
  }
  let site_examples = [
    "regex-date.puml", "regex-date-dark.svg", "regex-date-light.svg", "regex-date-light.html",
    "ebnf-arithmetic.puml", "ebnf-arithmetic-dark.svg", "ebnf-arithmetic-light.svg",
    "ebnf-arithmetic-light.html", "json-order.puml", "json-order-light.svg", "json-order-dark.svg",
    "json-order-light.html", "yaml-service.puml", "yaml-service-light.svg", "yaml-service-dark.svg",
    "regex-date-trace-success.svg", "regex-date-trace-failure.svg", "regex-date-trace-prefix.svg",
    "regex-date-trace-terminal.svg", "ebnf-arithmetic-trace-failure.svg",
  ]
  for name in plantuml_order {
    if name != "inline.html" {
      save(
        name,
        plantuml[name],
        check,
        site_assets && site_examples.contains(name),
      )
    }
  }
  for
    pair in [
      (
        "regex-date", "Regex: named groups, sets, repetitions and a negative lookahead",
      ),
      (
        "regex-constraints", "Regex: anchors, lookbehind, reluctant and nested repeats, backreference",
      ),
      ("regex-long", "Regex: a long pattern continues on new rows"),
      ("ebnf-arithmetic", "EBNF: recursive references and a note"),
      (
        "ebnf-constraints", "EBNF: counts, options, exclusions, rule notes and an empty rule",
      ),
      (
        "json-order", "JSON: nested collections, exact numbers, empty containers and a highlight",
      ),
      (
        "yaml-service", "YAML: native string scalars, flow and block values, lists of maps",
      ),
    ] {
    let (name, title) = pair
    html.write_string(
      "<article id=\"\{name}\"><h3>\{escape(title)}</h3><p><a href=\"\{name}.puml\">PlantUML source</a> · <a href=\"\{name}-dark.html\">dark player</a> · <a href=\"\{name}-light.html\">light player</a></p><div class=\"pair\">",
    )
    for variant in ["dark", "light"] {
      let file = name + "-" + variant + ".svg"
      html.write_string(
        "<figure class=\"\{variant}\"><figcaption><a href=\"\{file}\">\{variant} SVG</a></figcaption><img src=\"\{file}\" alt=\"\{escape(title)}, \{variant} theme\" loading=\"lazy\"></figure>",
      )
    }
    html.write_string(
      "</div><details><summary>PlantUML source</summary><pre><code>\{escape(plantuml[name + ".puml"])}</code></pre></details></article>\n",
    )
  }
  html.write_string(
    "<h3 id=\"plantuml-traces\">Independent trace highlight channels</h3><p>Matched paths are solid, non-matched paths are dashed, the taken path or prefix has its own colour, and failure points have a cross marker. Each channel can be shown alone. Unvisited branches stay neutral.</p>",
  )
  for name in ["regex-date", "ebnf-arithmetic"] {
    html.write_string("<div class=\"pair\">")
    for
      variant in [
        ("success", "matched and not-matched attempts"),
        ("failure", "failed attempt and failure point"),
        ("prefix", "taken prefix only"),
        ("terminal", "failure terminal only"),
        ("dark", "dark theme with taken path"),
      ] {
      let file = name + "-trace-" + variant.0 + ".svg"
      html.write_string(
        "<figure class=\"\{if variant.0 == "dark" { "dark" } else { "light" }}\"><figcaption><a href=\"\{file}\">\{name}: \{variant.1}</a></figcaption><img src=\"\{file}\" alt=\"\{name} trace, \{variant.1}\" loading=\"lazy\"></figure>",
      )
    }
    html.write_string("</div>")
  }
  html.write_string(
    "<p><a href=\"ebnf-scenario.html\">Explicit EBNF scenario with term visits and a return loop</a> · <a href=\"ebnf-arithmetic-trace-light.html\">Player with configured static trace highlights</a></p>",
  )
  html.write_string("</html>\n")
  save("index.html", html.to_string(), check, false)
  if args.contains("--qualify") {
    for
      (command, arguments) in [
        ("bun", ["install", "--frozen-lockfile", "--cwd", "apps/site"]),
        (
          "node",
          ["apps/site/node_modules/playwright/cli.js", "install", "chromium"],
        ),
        ("node", ["apps/site/scripts/gallery-test.ts"]),
      ] {
      let code = @process.run(
        command,
        arguments,
        stdout=@stdio.stdout,
        stderr=@stdio.stderr,
      )
      if code != 0 {
        @sys.exit(if code > 0 { code } else { 1 })
      }
    }
  }
  println("Gallery: _gallery/index.html")
}
