///|
async fn expanded_gallery_examples() -> Array[Json] {
  guard @json.parse(
      @fs.read_file(
        "tests/gallery-expansion-acceptance/__snapshot__/expanded-inventory.json",
      ).text(),
    )
    is Array(entries) else {
    raise Failure("Invalid qualified expanded gallery inventory")
  }
  entries
}

///|
async fn save_site_gallery(check : Bool) -> Unit {
  let entries = site_gallery_examples()
  entries.append(expanded_gallery_examples())
  entries.append(state_gallery_examples())
  let root = "apps/site/assets/examples"
  let absolute_root = @fs.realpath(root)
  for entry in entries {
    guard entry is Object(fields) else {
      raise Failure("Invalid gallery entry")
    }
    let id = string(fields["id"])
    let files : Array[Json] = []
    guard fields["sources"] is Array(sources) else {
      raise Failure("Missing gallery sources: " + id)
    }
    files.append(sources)
    if fields.get("companions") is Some(Array(companions)) {
      files.append(companions)
    }
    for key in ["preview", "preview_dark", "player"] {
      if fields.get(key) is Some(file) {
        files.push(file)
      }
    }
    for file in files {
      guard file is Object(record) else {
        raise Failure("Invalid gallery file: " + id)
      }
      let path = root + "/" + string(record["path"])
      guard @fs.exists(path) && @fs.kind(path) is Regular else {
        raise Failure("Missing gallery artifact: " + id + ": " + path)
      }
      guard @fs.realpath(path).has_prefix(absolute_root + "/") else {
        raise Failure("Gallery artifact escapes its root: " + id + ": " + path)
      }
    }
  }
  let manifest : Json = {
    "schema_version": 1,
    "root": root,
    "entries": @json.to_json(entries),
  }
  let path = "site/gallery.json"
  let text = manifest.stringify(indent=2) + "\n"
  if check {
    guard @fs.exists(path) && @fs.read_file(path).text() == text else {
      raise Failure(
        "Gallery metadata changed; run mise run gallery -- --existing-output --site-assets",
      )
    }
  } else {
    @fs.write_file(path, text)
  }
}

///|
test "site gallery baseline covers implemented families with unique ids and no digests" {
  let ids : Array[String] = []
  let families : Array[String] = []
  let entries = site_gallery_examples()
  @test.assert_eq(entries.length(), 15)
  for entry in entries {
    guard entry is Object(fields) else { fail("object required") }
    let id = string(fields["id"])
    @test.assert_eq(ids.contains(id), false)
    ids.push(id)
    families.push(string(fields["family"]))
    @test.assert_eq(entry.stringify().contains("sha256"), false)
  }
  for
    family in [
      "sequence", "ZenUML", "architecture", "BPMN", "swimlane", "regex", "EBNF",
      "JSON", "YAML", "flowchart",
    ] {
    @test.assert_eq(families.contains(family), true)
  }
}

///|
fn state_gallery_examples() -> Array[Json] {
  let entries = []
  for
    (id, extension, title, format) in [
      (
        "state-mermaid-lifecycle", "mmd", "Mermaid lifecycle and retry", "Mermaid 12.2.0",
      ),
      (
        "state-mermaid-choice", "mmd", "Mermaid composite and choice", "Mermaid 12.2.0",
      ),
      (
        "state-mermaid-concurrent", "mmd", "Mermaid concurrency and fork/join", "Mermaid 12.2.0",
      ),
      (
        "state-plantuml-lifecycle", "puml", "PlantUML descriptions and notes", "PlantUML 1.2026.9",
      ),
      (
        "state-plantuml-composite", "puml", "PlantUML child and boundary endpoints",
        "PlantUML 1.2026.9",
      ),
      (
        "state-plantuml-history", "puml", "PlantUML concurrent regions and history",
        "PlantUML 1.2026.9",
      ),
    ] {
    let entry = gallery_example(
      id,
      "state",
      title,
      format + " state source with typed hierarchy and labelled transitions.",
      "Structural illustration and supplied scenarios only. Guards and actions remain text. History is descriptive and is never restored by execution.",
      id + "." + extension,
      "text/plain",
      id + "-light.svg",
      preview_dark=id + "-dark.svg",
      player=id + "-light.html",
    )
    if entry is Object(fields) {
      fields["companions"] = @json.to_json([
        gallery_file(id + "-adaptive.svg", "image/svg+xml"),
        gallery_file(id + "-dark.html", "text/html"),
        gallery_file(id + "-adaptive.html", "text/html"),
      ])
    }
    if id == "state-plantuml-history" && entry is Object(fields) {
      if fields.get("companions") is Some(Array(companions)) {
        for variant in ["curved-light", "curved-dark", "elbow-plain-light"] {
          companions.push(
            gallery_file(id + "-" + variant + ".svg", "image/svg+xml"),
          )
          companions.push(
            gallery_file(id + "-" + variant + ".html", "text/html"),
          )
        }
      }
    }
    entries.push(entry)
  }
  entries
}

///|
test "source panels preserve carriage returns and escape active markup" {
  let panel = source_panel("a&b.mmd", "<script>\r\n&\"</script>")
  @test.assert_eq(panel.contains("<script>"), false)
  @test.assert_eq(
    panel.contains("&lt;script&gt;&#13;\n&amp;&quot;&lt;/script&gt;"),
    true,
  )
  @test.assert_eq(panel.contains("href=\"a&amp;b.mmd\""), true)
}
