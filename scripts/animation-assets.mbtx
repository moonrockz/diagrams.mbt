----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
/// Refresh or check the trusted, offline player assets embedded in MoonBit.

///|
fn generated(js : String, css : String) -> String raise Failure {
  if js.to_lower().contains("</script") || css.to_lower().contains("</style") {
    raise Failure("Embedded assets must not terminate their HTML element")
  }
  "// Generated by `mise run animation-assets:generate`. Do not edit.\n\n///|\nlet player_source : String = \{Json(js).stringify()}\n\n///|\nlet player_style : String = \{Json(css).stringify()}\n"
}

///|
async fn main {
  let args = @env.args()
  let command = args.get(1).unwrap_or("check")
  if args.length() > 2 || (command != "check" && command != "generate") {
    eprintln("Usage: animation-assets.mbtx check | generate")
    @sys.exit(1)
  }
  try {
    let js = @fs.read_file("pkgs/diagrams-animated/assets/player.js").text()
    let css = @fs.read_file("pkgs/diagrams-animated/assets/player.css").text()
    let output = generated(js, css)
    let path = "pkgs/diagrams-animated/assets.generated.mbt"
    if command == "generate" {
      @fs.write_file(path, output)
    } else if !@fs.exists(path) || @fs.read_file(path).text() != output {
      eprintln("Stale player assets; run mise run animation-assets:generate")
      @sys.exit(1)
    }
    println("✅ Standalone player asset embedding matches source")
  } catch {
    error => {
      eprintln(error.to_string())
      @sys.exit(1)
    }
  }
}

///|
test "asset embedding is deterministic and rejects HTML terminators" {
  let source = generated("const x = '<unsafe>&\\n';", "body { color: red; }")
  assert_eq(
    source,
    generated("const x = '<unsafe>&\\n';", "body { color: red; }"),
  )
  assert_true(source.contains("let player_source"))
  assert_true(
    try {
      ignore(generated("// </ScRiPt>", ""))
      false
    } catch {
      _ => true
    },
  )
  assert_true(
    try {
      ignore(generated("", "/* </STYLE> */"))
      false
    } catch {
      _ => true
    },
  )
}
