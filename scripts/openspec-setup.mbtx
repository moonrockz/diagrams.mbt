///|
/// Refresh the six core OpenSpec workflows for the supported agent clients.
/// Run from the repository root with `mise run openspec:setup`.
/// Isolate global settings so personal delivery/profile preferences cannot
/// remove another client's entry points or change the workflow set.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/x@0.5.5/sys",
}

///|
async fn main {
  guard @fs.exists("openspec/config.yaml") && @fs.exists("AGENTS.md") else {
    eprintln("Run openspec:setup from the initialized repository root.")
    @sys.exit(1)
  }
  let code = {
    let config_dir = @fs.tmpdir(prefix="diagrams-openspec")
    defer @fs.rmdir(config_dir, recursive=true)
    @fs.mkdir("\{config_dir}/openspec")
    let config : Json = {
      "profile": "core",
      "delivery": "both",
      "telemetry": { "noticeSeen": true },
    }
    @fs.write_file("\{config_dir}/openspec/config.json", config.stringify())
    @process.run(
      "openspec",
      [
        "init", "--tools", "codex,claude,grok,cursor,github-copilot", "--profile",
        "core", "--no-animation",
      ],
      extra_env={ "XDG_CONFIG_HOME": config_dir, "OPENSPEC_TELEMETRY": "0" },
      stdout=@stdio.stdout,
      stderr=@stdio.stderr,
    )
  }
  if code != 0 {
    @sys.exit(if code > 0 { code } else { 1 })
  }
}
