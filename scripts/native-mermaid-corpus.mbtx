----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
fn field(value : Json, name : String) -> Json {
  guard value is Object(fields) && fields.get(name) is Some(value) else {
    abort("Missing fixture field " + name)
  }
  value
}

///|
fn array(value : Json) -> Array[Json] {
  guard value is Array(values) else { abort("Expected fixture array") }
  values
}

///|
async fn emit(path : String, text : String, generate : Bool) -> Unit {
  @fs.mkdir("_build", allow_exist=true)
  let temporary = "_build/native-mermaid-fixtures.mbt"
  @fs.write_file(temporary, text)
  let (code, out, err) = @process.collect_output("moonfmt", [temporary])
  if code != 0 {
    eprintln(err.text())
    @sys.exit(1)
  }
  if generate {
    @fs.write_file(path, out.text())
  } else if !@fs.exists(path) || @fs.read_file(path).text() != out.text() {
    abort("Stale portable fixture " + path)
  }
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 2 && ["generate", "check"].contains(args[1]) else {
    @sys.exit(1)
  }
  let generate = args[1] == "generate"
  for kind in ["zenuml", "architecture"] {
    let dir = "tests/" + kind + "-corpus/"
    let sums = @fs.read_file(dir + "SHA256SUMS").text()
    for line in sums.split("\n") {
      if line.is_empty() {
        continue
      }
      guard line.length() > 66 && line[64:66] == "  " else {
        abort("Invalid corpus checksum record")
      }
      let name = line[66:].to_owned()
      if name.contains("..") || name.has_prefix("/") {
        abort("Invalid corpus path")
      }
      let data = @fs.read_file(dir + name).text()
      let digest = @crypto.bytes_to_hex_string(
        @crypto.sha256(@utf8.encode(data)),
      )
      if digest != line[:64].to_owned() {
        abort("Corpus digest mismatch: " + kind + "/" + name)
      }
    }
    if kind == "architecture" {
      let reference = @fs.read_file(dir + "reference.json").text()
      emit(
        "tests/architecture-acceptance/fixtures.generated.mbt",
        "// Generated by mise run native-mermaid-corpus:generate. Do not edit.\n\n///|\npub let reference : String = " +
        Json(reference).stringify() +
        "\n",
        generate,
      )
    } else {
      let reference = @json.parse(
        @fs.read_file(dir + "reference/semantics.json").text(),
      )
      let out = StringBuilder()
      out.write_string(
        "// Generated by mise run native-mermaid-corpus:generate. Do not edit.\n\n///|\nlet oracle : Array[(String,String,String)] = [\n",
      )
      for example in array(field(reference, "examples")) {
        let participants = array(field(example, "participants")).map(p => {
          field(p, "id")
        })
        let messages = array(field(example, "messages")).map(m => {
          Json::object(
            Map([
              ("from", field(m, "from")),
              ("to", field(m, "to")),
              ("label", field(m, "label")),
            ]),
          )
        })
        let semantics = Json::object(
          Map([
            ("participants", Json::array(participants)),
            ("messages", Json::array(messages)),
          ]),
        )
        out.write_string(
          "  (" +
          field(example, "id").stringify() +
          "," +
          field(example, "source").stringify() +
          "," +
          Json(semantics.stringify()).stringify() +
          "),\n",
        )
      }
      out.write_string("]\n")
      emit(
        "pkgs/diagrams-mermaid/zenuml/oracle.generated_wbtest.mbt",
        out.to_string(),
        generate,
      )
    }
    println(
      "Verified frozen " + kind + " sources, oracle and portable fixtures",
    )
  }
}
