///|
/// Check and embed the exact frozen OMG schemas and project BPMN fixture.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/sys",
}

///|
let corpus_dir : String = "tests/corpus/bpmn-2.0.2"

///|
let generated_path : String = "tests/bpmn-corpus/inputs.generated.mbt"

///|
let usage : String = "Usage: bpmn-corpus.mbtx check | generate"

///|
fn fail_with(message : String) -> Unit {
  eprintln("❌ \{message}")
  @sys.exit(1)
}

///|
/// The `(digest, path)` pairs of a `shasum -a 256` listing. A line that is empty gives nothing.
fn parse_sums(text : String) -> Array[(String, String)] raise Failure {
  let out = []
  for line in text.split("\n") {
    let line = line.trim(chars=" \r").to_owned()
    if line == "" {
      continue
    }
    guard line.find("  ") is Some(at) && at == 64 else {
      raise Failure("not a shasum line: \{line}")
    }
    out.push(
      (
        line.view(end_offset=64).to_owned(),
        line.view(start_offset=66).to_owned(),
      ),
    )
  }
  out
}

///|
/// The SHA-256 digest of the UTF-8 encoding of `text`, as lowercase hex.
fn digest(text : String) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(@utf8.encode(text)))
}

///|
/// `text` as a MoonBit string literal.
fn small_literal(text : String) -> String {
  let buf = StringBuilder()
  buf.write_char('"')
  for c in text {
    match c {
      '"' => buf.write_string("\\\"")
      '\\' => buf.write_string("\\\\")
      '\n' => buf.write_string("\\n")
      '\r' => buf.write_string("\\r")
      '\t' => buf.write_string("\\t")
      _ => buf.write_char(c)
    }
  }
  buf.write_char('"')
  buf.to_string()
}

///|
fn literal(text : String) -> String {
  if text.length() <= 12000 {
    return small_literal(text)
  }
  let chunks : Array[String] = []
  let mut i = 0
  while i < text.length() {
    let end = Int32::min(i + 12000, text.length())
    chunks.push(small_literal(text[i:end].to_owned()))
    i = end
  }
  "(" + chunks.join(" +\n    ") + ")"
}

///|
async fn main {
  let args = @env.args()
  let command = if args.length() > 1 { args[1] } else { "check" }
  if command != "check" && command != "generate" {
    fail_with(usage)
  }
  let sums = parse_sums(@fs.read_file("\{corpus_dir}/SHA256SUMS").text())
  let names = [
    "BPMN20.xsd", "BPMNDI.xsd", "DC.xsd", "DI.xsd", "Semantic.xsd", "minimal.bpmn",
  ]
  if sums.map(p => p.1) != names {
    fail_with("Corpus inventory differs from the six pinned inputs")
  }
  let output = StringBuilder()
  output.write_string(
    "// Generated by `mise run bpmn-corpus:generate`. Do not edit.\n\n///|\npub let inputs : ReadOnlyArray[Input] = [\n",
  )
  for (expected, file) in sums {
    let source = @fs.read_file("\{corpus_dir}/\{file}").text()
    if digest(source) != expected {
      fail_with("Digest mismatch: \{file}")
    }
    output.write_string(
      "  { name: \{literal(file)}, sha256: \{literal(expected)}, source: \{literal(source)} },\n",
    )
  }
  output.write_string("]\n")
  let expected = output.to_string()
  if command == "generate" {
    @fs.write_file(generated_path, expected)
  } else if !@fs.exists(generated_path) ||
    @fs.read_file(generated_path).text() != expected {
    fail_with("Stale BPMN embedding; run mise run bpmn-corpus:generate")
  }
  let model_dir = "tests/corpus/bpmn-model"
  let model_sums = parse_sums(@fs.read_file(model_dir + "/SHA256SUMS").text())
  let model_names = [
    "activities.bpmn", "events.bpmn", "collaboration.bpmn", "choreography-conversation.bpmn",
    "di-views.bpmn", "minimal.reference.json", "activities.reference.json", "events.reference.json",
    "collaboration.reference.json", "choreography-conversation.reference.json", "di-views.reference.json",
  ]
  if model_sums.map(p => p.1) != model_names {
    fail_with("Model corpus inventory differs from its pinned fixtures")
  }
  let models = StringBuilder()
  models.write_string(
    "// Generated by `mise run bpmn-corpus:generate`. Do not edit.\n\n///|\npub let model_inputs : ReadOnlyArray[Input] = [\n",
  )
  for (expected, file) in model_sums {
    let source = @fs.read_file(model_dir + "/" + file).text()
    if digest(source) != expected {
      fail_with("Model corpus digest mismatch: \{file}")
    }
    models.write_string(
      "  { name: \{literal(file)}, sha256: \{literal(expected)}, source: \{literal(source)} },\n",
    )
  }
  models.write_string("]\n")
  let path = "tests/bpmn-corpus/models.generated.mbt"
  let expected = models.to_string()
  if command == "generate" {
    @fs.write_file(path, expected)
  } else if !@fs.exists(path) || @fs.read_file(path).text() != expected {
    fail_with("Stale model embedding; run mise run bpmn-corpus:generate")
  }
  let render_dir = "tests/corpus/bpmn-render"
  let render_sums = parse_sums(@fs.read_file(render_dir + "/SHA256SUMS").text())
  if render_sums.map(p => p.1) != ["process-di.bpmn", "collaboration-di.bpmn"] {
    fail_with("Rendering corpus inventory differs from its pinned fixtures")
  }
  let renders = StringBuilder()
  renders.write_string(
    "// Generated by `mise run bpmn-corpus:generate`. Do not edit.\n\n///|\npub let render_inputs : ReadOnlyArray[Input] = [\n",
  )
  for (expected, file) in render_sums {
    let source = @fs.read_file(render_dir + "/" + file).text()
    if digest(source) != expected {
      fail_with("Rendering corpus digest mismatch: " + file)
    }
    renders.write_string(
      "  { name: \{literal(file)}, sha256: \{literal(expected)}, source: \{literal(source)} },\n",
    )
  }
  renders.write_string("]\n")
  let render_path = "tests/bpmn-corpus/render.generated.mbt"
  let render_output = renders.to_string()
  if command == "generate" {
    @fs.write_file(render_path, render_output)
  } else if !@fs.exists(render_path) ||
    @fs.read_file(render_path).text() != render_output {
    fail_with("Stale rendering embedding; run mise run bpmn-corpus:generate")
  }
  let coverage = @fs.read_file(model_dir + "/graphical-coverage.json").text()
  let coverage_path = "tests/bpmn-corpus/graphical.generated.mbt"
  let coverage_output = "// Generated by `mise run bpmn-corpus:generate`. Do not edit.\n\n///|\npub let graphical_coverage : String = " +
    literal(coverage) +
    "\n"
  if command == "generate" {
    @fs.write_file(coverage_path, coverage_output)
  } else if !@fs.exists(coverage_path) ||
    @fs.read_file(coverage_path).text() != coverage_output {
    fail_with(
      "Stale graphical coverage embedding; run mise run bpmn-corpus:generate",
    )
  }
  println(
    "✅ BPMN schema, minimal and model/reference corpus digests and embeddings match",
  )
}

///|
test "digest and literal retain CRLF and XML quote spelling" {
  assert_eq(
    digest("abc"),
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
  )
  assert_eq(literal("\r\n\""), "\"\\r\\n\\\"\"")
}
