///|
/// Run the unchanged Zig test gate. Optional Linux diagnostics observe resource
/// pressure without reading process arguments/environment or changing coverage.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/sys",
}

///|
priv struct MonitorState {
  mut done : Bool
}

///|
priv struct ZigOptions {
  diagnostics : Bool
  jobs : Int32?
}

///|
fn zig_options(args : ArrayView[String]) -> Result[ZigOptions, String] {
  let mut diagnostics = false
  let mut jobs : Int32? = None
  for arg in args {
    if arg == "--diagnostics" {
      if diagnostics {
        return Err("Duplicate diagnostics option")
      }
      diagnostics = true
    } else if arg.has_prefix("--jobs=") {
      let raw = arg[7:]
      if jobs is Some(_) ||
        raw.is_empty() ||
        !raw.iter().all(c => c >= '0' && c <= '9') {
        return Err("Supply one positive --jobs=N limit")
      }
      let value = @string.parse_int(raw) catch {
        _ => return Err("Job limit exceeds the integer range")
      }
      if value <= 0 {
        return Err("Job limit must be positive")
      }
      jobs = Some(value)
    } else {
      return Err("Unknown Zig test option")
    }
  }
  Ok({ diagnostics, jobs, })
}

///|
priv struct ProcessRow {
  pid : Int64
  ppid : Int64
  pgid : Int64
  sid : Int64
  comm : String
  rss_pages : Int64
  ticks : Int64
  start : Int64
}

///|
priv struct Samples {
  mut previous : Map[Int64, (Int64, Int64)]
  mut uptime : Double
  page_size : Int64?
  hertz : Int64?
}

///|
fn number(text : String) -> Int64? {
  let n = @string.parse_int64(text.trim()) catch { _ => return None }
  Some(n)
}

///|
fn words(text : String) -> Array[String] {
  text
  .split(" ")
  .map(part => part.trim().to_owned())
  .filter(part => part != "")
  .to_array()
}

///|
/// Only fixed, small kernel files are read. Exceptions and partial metrics are
/// unavailable observations, never reasons to cancel the foreground gate.
async fn small_file(path : String) -> String? {
  try {
    let file = @fs.open(path, mode=ReadOnly)
    defer file.close()
    file.read_some(max_len=16384).map(bytes => @utf8.decode_lossy(bytes))
  } catch {
    _ => None
  }
}

///|
fn selected_numbers(text : String?, keys : ArrayView[String]) -> Json {
  let fields : Map[String, Json] = Map([])
  if text is Some(text) {
    for line in text.split("\n") {
      let fields_in_line = words(line.to_owned())
      if fields_in_line.length() >= 2 {
        let key = fields_in_line[0].replace(old=":", new="")
        if keys.contains(key) && number(fields_in_line[1]) is Some(value) {
          fields[key] = Json(value.to_string())
        }
      }
    }
  }
  Json(fields)
}

///|
fn process_row(text : String) -> ProcessRow? {
  guard text.find("(") is Some(open) &&
    text.rev_find(")") is Some(close) &&
    close > open else {
    return None
  }
  guard number(text[:open].to_owned()) is Some(pid) else { return None }
  let fields = words(text[close + 1:].to_owned())
  guard fields.length() >= 22 &&
    number(fields[1]) is Some(ppid) &&
    number(fields[2]) is Some(pgid) &&
    number(fields[3]) is Some(sid) &&
    number(fields[11]) is Some(user) &&
    number(fields[12]) is Some(system) &&
    number(fields[19]) is Some(start) &&
    number(fields[21]) is Some(rss) &&
    user >= 0L &&
    system >= 0L &&
    user <= 9223372036854775807L - system &&
    rss >= 0L else {
    return None
  }
  let name = text[open + 1:close]
  let comm = StringBuilder()
  for i in 0..<name.length().min(32) {
    let c = name.code_unit_at(i).to_int()
    comm.write_char(
      if (c >= 48 && c <= 57) ||
        (c >= 65 && c <= 90) ||
        (c >= 97 && c <= 122) ||
        [43, 45, 46, 95].contains(c) {
        c.to_char().unwrap()
      } else {
        '_'
      },
    )
  }
  Some({
    pid,
    ppid,
    pgid,
    sid,
    comm: comm.to_string(),
    rss_pages: rss,
    ticks: user + system,
    start,
  })
}

///|
fn row_data(row : ProcessRow, samples : Samples, uptime : Double) -> Json {
  let cpu = if samples.hertz is Some(hertz) &&
    hertz > 0L &&
    samples.previous.get(row.pid) is Some((start, ticks)) &&
    start == row.start &&
    row.ticks >= ticks &&
    uptime > samples.uptime {
    Json(
      (row.ticks - ticks).to_double() *
      100.0 /
      hertz.to_double() /
      (uptime - samples.uptime),
    )
  } else {
    Json(null)
  }
  let rss = if samples.page_size is Some(size) &&
    size > 0L &&
    row.rss_pages <= 9223372036854775807L / size {
    Json((row.rss_pages * size / 1024L).to_string())
  } else {
    Json(null)
  }
  {
    "pid": Json(row.pid.to_string()),
    "ppid": Json(row.ppid.to_string()),
    "pgid": Json(row.pgid.to_string()),
    "sid": Json(row.sid.to_string()),
    "comm": Json(row.comm),
    "rss_kib": rss,
    "rss_pages": Json(row.rss_pages.to_string()),
    "cpu_percent_interval": cpu,
    "cpu_ticks": Json(row.ticks.to_string()),
  }
}

///|
async fn cgroup_metrics() -> Json {
  let fields : Map[String, Json] = Map([])
  let mut root = "/sys/fs/cgroup"
  if small_file("/proc/self/cgroup") is Some(text) {
    for line in text.split("\n") {
      if line.has_prefix("0::/") && !line.contains("..") {
        root += line[3:].to_owned()
        break
      }
    }
  }
  for name in ["memory.current", "memory.peak", "memory.max"] {
    let value = small_file(root + "/" + name)
    if value is Some(value) {
      if number(value) is Some(n) {
        fields[name] = Json(n.to_string())
      } else if value.trim() == "max" {
        fields[name] = Json("max")
      }
    }
  }
  fields["memory.events"] = selected_numbers(
    small_file(root + "/memory.events"),
    ["low", "high", "max", "oom", "oom_kill", "oom_group_kill"],
  )
  Json(fields)
}

///|
/// df is queried for one filesystem; only numeric columns are retained.
async fn disk_metrics() -> Json {
  let (code, output) = @process.collect_stdout("df", ["-Pk", "."])
  if code == 0 {
    let lines = output.text().split("\n").to_array()
    if lines.length() >= 2 {
      let fields = words(lines[1].to_owned())
      if fields.length() >= 4 &&
        number(fields[1]) is Some(total) &&
        number(fields[2]) is Some(used) &&
        number(fields[3]) is Some(available) {
        return {
          "total_kib": Json(total.to_string()),
          "used_kib": Json(used.to_string()),
          "available_kib": Json(available.to_string()),
        }
      }
    }
  }
  Json(null)
}

///|
async fn sample_linux(index : Int32, samples : Samples) -> Unit {
  let uptime_text = small_file("/proc/uptime").unwrap_or("")
  let uptime_word = words(uptime_text).get(0).unwrap_or("0")
  let uptime = @string.parse_double(uptime_word) catch { _ => 0.0 }
  let load = words(small_file("/proc/loadavg").unwrap_or(""))
    .iter()
    .take(3)
    .to_array()
  let memory = selected_numbers(small_file("/proc/meminfo"), [
    "MemTotal", "MemAvailable", "SwapTotal", "SwapFree",
  ])
  let oom = selected_numbers(small_file("/proc/vmstat"), ["oom_kill"])
  let cgroup = cgroup_metrics()
  let resources : Json = {
    "sample": Json(index),
    "uptime_seconds": Json(uptime_word),
    "load_average": Json(load),
    "memory_kib": memory,
    "vmstat": oom,
    "cgroup": cgroup,
  }
  // Publish these first, even if an overloaded process table later times out.
  println("[zig-diag] " + resources.stringify())
  let top : Array[ProcessRow] = []
  let runners : Array[ProcessRow] = []
  let current : Map[Int64, (Int64, Int64)] = Map([])
  let directory = @fs.opendir("/proc")
  defer directory.close()
  let mut scanned = 0
  let mut limited = false
  while directory.next() is Some(entry) {
    if scanned >= 4096 {
      limited = true
      break
    }
    if number(entry.name) is None {
      continue
    }
    scanned += 1
    if small_file("/proc/" + entry.name + "/stat") is Some(text) &&
      process_row(text) is Some(row) {
      current[row.pid] = (row.start, row.ticks)
      top.push(row)
      top.sort_by((a, b) => b.rss_pages.compare(a.rss_pages))
      if top.length() > 10 {
        ignore(top.pop())
      }
      if ["Runner.Worker", "Runner.Listener"].contains(row.comm) &&
        runners.length() < 8 {
        runners.push(row)
      }
    }
  }
  let disk = disk_metrics()
  let data : Json = {
    "sample": Json(index),
    "uptime_seconds": Json(uptime_word),
    "disk": disk,
    "processes_scanned": Json(scanned),
    "scan_limited": Json(limited),
    "top_rss": Json(top.map(row => row_data(row, samples, uptime))),
    "runners": Json(runners.map(row => row_data(row, samples, uptime))),
  }
  println("[zig-diag] " + data.stringify())
  samples.previous = current
  samples.uptime = uptime
}

///|
async fn host_number(name : String) -> Int64? {
  @async.with_timeout_opt(2000, () => {
    let (code, output) = @process.collect_stdout("getconf", [name])
    if code == 0 {
      number(output.text())
    } else {
      None
    }
  }).bind(value => value) catch {
    _ => None
  }
}

///|
/// The monitor never cancels the test. Completion is cooperative; any monitor
/// exception is reported without changing the foreground result.
async fn run_monitored(
  command : String,
  arguments : Array[String],
  sample : async (Int32) -> Unit,
  interval_ms~ : Int32 = 15000,
  max_samples~ : Int32 = 120,
) -> Int32 {
  let state = MonitorState::{ done: false, }
  @async.with_task_group() <| group => {
    group.spawn_bg(allow_failure=true, () => {
      for index in 0..<max_samples.min(120) {
        if state.done {
          return
        }
        try {
          if @async.with_timeout_opt(3000, () => sample(index)) is None {
            println("[zig-diag] sample unavailable: timeout")
          }
        } catch {
          _ => println("[zig-diag] sample unavailable")
        }
        let mut remaining = interval_ms
        while remaining > 0 && !state.done {
          let delay = remaining.min(250)
          @async.sleep(delay)
          remaining -= delay
        }
      }
    })
    defer {
      state.done = true
    }
    @process.run(command, arguments, stdout=@stdio.stdout, stderr=@stdio.stderr)
  }
}

///|
async fn main {
  let options = match zig_options(@env.args()[1:]) {
    Ok(options) => options
    Err(message) => {
      eprintln(message)
      eprintln("Usage: test-native-zig.mbtx [--diagnostics] [--jobs=N]")
      @sys.exit(2)
      return
    }
  }
  try {
    let diagnostics = options.diagnostics &&
      small_file("/proc/self/stat") is Some(_)
    if options.diagnostics && !diagnostics {
      println(
        "[zig-diag] unavailable: Linux procfs is unavailable; test command unchanged",
      )
    }
    let arguments = [
      "moonrockz/zig-cross@0.1.2", "exec", "host", "--", "moonx", "scripts/test.mbtx",
      "native",
    ]
    if options.jobs is Some(jobs) {
      arguments.push("--jobs=" + jobs.to_string())
    }
    let code = if diagnostics {
      let samples = Samples::{
        previous: Map([]),
        uptime: 0.0,
        page_size: host_number("PAGESIZE"),
        hertz: host_number("CLK_TCK"),
      }
      run_monitored("moonx", arguments, index => sample_linux(index, samples))
    } else {
      @process.run(
        "moonx",
        arguments,
        stdout=@stdio.stdout,
        stderr=@stdio.stderr,
      )
    }
    println("[zig-test] child status: " + code.to_string())
    // async/process uses negative signal numbers; map these to conventional Unix
    // shell statuses while preserving ordinary exit codes unchanged.
    @sys.exit(if code >= 0 { code } else { 128 - code })
  } catch {
    _ => {
      eprintln("Zig test invocation failed")
      @sys.exit(1)
    }
  }
}

///|
test "diagnostics and a positive worker limit remain independent" {
  for args in [["--diagnostics", "--jobs=2"], ["--jobs=2", "--diagnostics"]] {
    let options = match zig_options(args) {
      Ok(options) => options
      Err(message) => fail(message)
    }
    assert_true(options.diagnostics)
    assert_eq(options.jobs, Some(2))
  }
  for
    args in [
      ["--jobs=0"],
      ["--jobs=-1"],
      ["--jobs="],
      ["--jobs=2.5"],
      ["--jobs=2147483648"],
      ["--jobs=1", "--jobs=2"],
      ["--diagnostics", "--jobs=0"],
      ["--jobs", "2"],
    ] {
    assert_true(zig_options(args) is Err(_))
  }
}

///|
async test "monitor completion and failures preserve child exit status" {
  let (tool_code, tool_output) = @process.collect_stdout("mise", [
    "which", "moonx",
  ])
  assert_eq(tool_code, 0)
  let moonx = tool_output.text().trim().to_owned()
  let directory = @fs.tmpdir(prefix="zig-monitor")
  defer @fs.rmdir(directory, recursive=true)
  for status in [0, 37] {
    let fixture = directory + "/exit-" + status.to_string() + ".mbtx"
    @fs.write_file(
      fixture,
      "import { \"moonbitlang/x@0.5.5/sys\" }\nfn main { @sys.exit(" +
      status.to_string() +
      ") }\n",
    )
    // Compile the tiny fixture before measuring monitor shutdown behavior.
    assert_eq(@process.run(moonx, [fixture]), status)
    let mut observed = 0
    let result = @async.with_timeout(7500, () => {
      run_monitored(
        moonx,
        [fixture],
        _ => {
          observed += 1
          raise Failure("unavailable telemetry")
        },
        interval_ms=15000,
        max_samples=80,
      )
    })
    assert_eq(result, status)
    assert_true(observed > 0 && observed <= 80)
  }
}

///|
async test "sample cap cannot terminate a still-running command" {
  let (tool_code, tool_output) = @process.collect_stdout("mise", [
    "which", "moonx",
  ])
  assert_eq(tool_code, 0)
  let moonx = tool_output.text().trim().to_owned()
  let directory = @fs.tmpdir(prefix="zig-monitor-limit")
  defer @fs.rmdir(directory, recursive=true)
  let fixture = directory + "/wait.mbtx"
  @fs.write_file(
    fixture, "import { \"moonbitlang/async@0.22.5\", \"moonbitlang/x@0.5.5/sys\" }\nasync fn main { @async.sleep(60); @sys.exit(23) }\n",
  )
  let mut observed = 0
  let result = run_monitored(
    moonx,
    [fixture],
    _ => observed += 1,
    interval_ms=1,
    max_samples=3,
  )
  assert_eq(result, 23)
  assert_eq(observed, 3)
}

///|
test "proc stat reads fixed numeric fields and sanitizes comm without args" {
  let row = process_row(
    "42 (Runner.Worker) S 1 42 42 0 0 0 0 0 0 0 100 20 0 0 0 0 1 0 50 4096 30",
  ).unwrap()
  assert_eq(
    (row.pid, row.ppid, row.pgid, row.sid, row.rss_pages, row.ticks, row.start),
    (42L, 1L, 42L, 42L, 30L, 120L, 50L),
  )
  assert_eq(row.comm, "Runner.Worker")
  assert_true(process_row("broken") is None)
  assert_eq(
    process_row(
      "42 (secret\nname) S 1 42 42 0 0 0 0 0 0 0 100 20 0 0 0 0 1 0 50 4096 30",
    ).unwrap().comm,
    "secret_name",
  )
}
