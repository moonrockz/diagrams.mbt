----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "mizchi/zlib@0.4.10",
  "moonbitlang/x@0.5.5/sys",
}
----

///|

///|
async fn run(command : String, args : Array[String]) -> Unit {
  let code = @process.run(
    command,
    args,
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  )
  if code != 0 {
    raise Failure("Raster asset build failed: " + command)
  }
}

///|
/// JSON literals embedded in classic HTML scripts must not introduce a closing
/// script token, including when the literal itself contains worker source.
fn literal(value : String) -> String {
  Json(value)
  .stringify()
  .replace_all(old="<", new="\\u003c")
  .replace_all(old="\u2028", new="\\u2028")
  .replace_all(old="\u2029", new="\\u2029")
}

///|
fn notice_comment(notices : String) -> String raise Failure {
  guard notices.length() > 0 &&
    !notices.contains("*/") &&
    !notices.to_lower().contains("</script") else {
    raise Failure(
      "Raster notices must be nonempty and contain no JavaScript comment or HTML script terminator",
    )
  }
  // HTML parsing and the checked-in JavaScript assets use LF. Preserve the
  // original notice file; normalize only the generated comment's line endings.
  let text = notices
    .replace_all(old="\r\n", new="\n")
    .replace_all(old="\r", new="\n")
  "/*!\n" + text + "\n*/\n"
}

///|
fn asset(
  template : String,
  worker : Bytes,
  fonts : String,
  notice_header : String,
) -> String {
  "// Generated by mise run raster-assets:generate. Do not edit.\n" +
  notice_header +
  template
  .replace_all(
    old="__DIAGRAMS_RASTER_WORKER__",
    new=literal(@base64.encode(worker)),
  )
  .replace_all(
    old="__DIAGRAMS_RASTER_FONTS__",
    new=if fonts == "null" {
      "null"
    } else {
      literal(@base64.encode(@zlib.zlib_compress(@utf8.encode(fonts))))
    },
  )
}

///|
async fn main {
  let args = @env.args()
  let command = args.get(1).unwrap_or("check")
  if args.length() > 2 || (command != "check" && command != "generate") {
    eprintln("Usage: raster-assets.mbtx check | generate")
    @sys.exit(1)
  }
  try {
    let notice_header = notice_comment(
      @fs.read_file("apps/raster-browser/assets/THIRD-PARTY-NOTICES.txt").text(),
    )
    if !@fs.exists("_build/raster-assets") {
      @fs.mkdir("_build/raster-assets", recursive=true)
    }
    run("moon", [
      "build", "apps/raster-browser/worker", "--target", "js", "--release",
    ])
    run("bun", [
      "build", "_build/js/release/build/moonrockz/diagrams-raster-browser/worker/worker.js",
      "--target", "browser", "--minify", "--outfile", "_build/raster-assets/worker.min.js",
    ])
    run("moon", [
      "run", "apps/raster-browser/fonts", "--target", "native", "--", "_build/raster-assets/fonts.json",
      "--default",
    ])
    let worker = @zlib.zlib_compress(
      @fs.read_file("_build/raster-assets/worker.min.js").binary(),
    )
    let fonts = @fs.read_file("_build/raster-assets/fonts.json").text()
    let template = @fs.read_file("apps/raster-browser/assets/adapter.js").text()
    let outputs = [
      ("raster.generated.js", asset(template, worker, fonts, notice_header)),
      (
        "raster-runtime.generated.js",
        asset(template, worker, "null", notice_header),
      ),
    ]
    for (name, body) in outputs {
      guard !body.to_lower().contains("</script") else {
        raise Failure("Raster asset must not terminate an HTML script")
      }
      let path = "pkgs/diagrams-animated/assets/" + name
      if command == "generate" {
        @fs.write_file(path, body)
      } else {
        guard @fs.exists(path) && @fs.read_file(path).text() == body else {
          raise Failure(
            "Stale raster asset: " +
            path +
            "; run mise run raster-assets:generate",
          )
        }
      }
      println(name + ": " + body.length().to_string() + " units")
    }
    let site_directory = "apps/site/assets/raster"
    let site_path = site_directory + "/diagrams-raster.js"
    let site_body = outputs[0].1
    if command == "generate" {
      if !@fs.exists(site_directory) {
        @fs.mkdir(site_directory, recursive=true)
      }
      @fs.write_file(site_path, site_body)
    } else {
      guard @fs.exists(site_path) &&
        @fs.read_file(site_path).text() == site_body else {
        raise Failure(
          "Stale published gallery adapter; run mise run raster-assets:generate",
        )
      }
    }
  } catch {
    error => {
      eprintln(error.to_string())
      @sys.exit(1)
    }
  }
}

///|
test "embedded worker literals cannot terminate a script" {
  assert_true(!literal("</script>\u2028").contains("</script>"))
  assert_true(
    asset(
      "__DIAGRAMS_RASTER_WORKER__ __DIAGRAMS_RASTER_FONTS__",
      b"test",
      "null",
      notice_comment("Notice"),
    ).contains("null"),
  )
}

///|
test "both offline adapter variants retain exact readable notices" {
  let notices = "Copyright holder\r\nExact license text: \"AS IS\"\n"
  let header = notice_comment(notices)
  let normalized = notices.replace_all(old="\r\n", new="\n")
  assert_eq(header, "/*!\n" + normalized + "\n*/\n")
  for fonts in ["null", "{\"resources\":[]}"] {
    let body = asset(
      "__DIAGRAMS_RASTER_WORKER__ __DIAGRAMS_RASTER_FONTS__", b"worker", fonts, header,
    )
    assert_true(body.contains(header))
    assert_true(body.contains(normalized))
    assert_true(!body.contains("\r"))
  }
}

///|
test "unsafe notice delimiters fail without changing license text" {
  for
    notices in [
      "", "copyright */ escaped code", "copyright </script>", "copyright </ScRiPt data-x>",
    ] {
    let rejected = try {
      ignore(notice_comment(notices))
      false
    } catch {
      Failure(_) => true
    }
    assert_true(rejected)
  }
}
