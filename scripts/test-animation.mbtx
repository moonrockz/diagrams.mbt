///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/x@0.5.5/sys",
}

///|
/// Qualify current-commit stored animation artifacts without a workspace/site build.

///|
async fn main {
  for
    (command, args) in [
      ("bun", ["install", "--frozen-lockfile", "--cwd", "apps/site"]),
      (
        "node",
        ["apps/site/node_modules/playwright/cli.js", "install", "chromium"],
      ),
      ("node", ["apps/site/scripts/animation-test.ts"]),
      ("node", ["apps/site/scripts/native-mermaid-test.ts", "animation"]),
      ("node", ["apps/site/scripts/flowchart-test.ts"]),
    ] {
    let code = @process.run(
      command,
      args,
      stdout=@stdio.stdout,
      stderr=@stdio.stderr,
    )
    if code != 0 {
      @sys.exit(if code > 0 { code } else { 1 })
    }
  }
}
