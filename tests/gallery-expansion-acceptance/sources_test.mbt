///|
/// Thirty additional sources, three per published family. The original 15 cards
/// remain in scripts/gallery.mbtx and are not counted here.
priv struct GalleryCase {
  id : String
  family : String
  title : String
  description : String
  scope : String
  extension : String
  source : String
}

///|
fn gallery_cases() -> Array[GalleryCase] {
  [
    {
      id: "sequence-auth-retry",
      family: "sequence",
      title: "Authentication and retry",
      description: "A retry loop with an alternative success response.",
      scope: "Implemented Mermaid sequence syntax and illustrative playback. Calls are not executed.",
      extension: "mmd",
      source: "sequenceDiagram\nactor User\nparticipant API\nparticipant Auth\nUser->>API: Sign in\nloop Up to three attempts\nAPI->>Auth: Verify credentials\nalt accepted\nAuth-->>API: Session\nelse rejected\nAuth-->>API: Retry\nend\nend\nAPI-->>User: Result\n",
    },
    {
      id: "sequence-worker-lifetime",
      family: "sequence",
      title: "Worker creation and destruction",
      description: "Explicit participant lifetime around a short background job.",
      scope: "Implemented Mermaid sequence syntax and illustrative playback. Calls are not executed.",
      extension: "mmd",
      source: "sequenceDiagram\nparticipant API\ncreate participant Worker\nAPI->>Worker: Start job\nWorker->>Worker: Process batch\ndestroy Worker\nWorker-->>API: Completed\n",
    },
    {
      id: "sequence-parallel-checkout",
      family: "sequence",
      title: "Parallel checkout checks",
      description: "Nested alternatives and parallel stock and payment calls.",
      scope: "Implemented Mermaid sequence syntax and illustrative playback. Calls are not executed.",
      extension: "mmd",
      source: "sequenceDiagram\nactor Buyer\nparticipant Shop\nparticipant Stock\nparticipant Bank\nBuyer->>Shop: Checkout\npar Inventory\nShop->>Stock: Reserve\nStock-->>Shop: Available\nand Payment\nShop->>Bank: Authorise\nBank-->>Shop: Accepted\nend\nalt ready\nShop-->>Buyer: Confirmed\nelse unavailable\nShop-->>Buyer: Retry later\nend\n",
    },
    {
      id: "zenuml-nested-calls",
      family: "ZenUML",
      title: "Nested calls and returns",
      description: "Call nesting with explicit return messages.",
      scope: "Implemented native Mermaid ZenUML syntax and illustrative playback. Calls are not executed.",
      extension: "mmd",
      source: "zenuml\ntitle Nested order lookup\nClient->API.lookup() {\n    Store.find() {\n        return record\n    }\n    return result\n}\n",
    },
    {
      id: "zenuml-cleanup",
      family: "ZenUML",
      title: "Exception cleanup",
      description: "Typed exception sections retain their structural order.",
      scope: "Implemented native Mermaid ZenUML syntax and illustrative playback. Calls are not executed.",
      extension: "mmd",
      source: "zenuml\ntitle Safe storage request\ntry {\n API->Store: query\n} catch(missing) {\n Store->API: absent\n} catch(busy) {\n Store->API: retry\n} finally {\n API->Store: close\n}\n",
    },
    {
      id: "zenuml-symbol-fanout",
      family: "ZenUML",
      title: "Asynchronous service fan-out",
      description: "Participant symbols distinguish a queue, worker and store.",
      scope: "Implemented native Mermaid ZenUML syntax and illustrative playback. Calls are not executed.",
      extension: "mmd",
      source: "zenuml\ntitle Queue fan-out\n@Actor Client\n@SQS Queue\n@Lambda Worker\n@PostgreSQL Store\nClient->Queue: publish\nQueue->Worker: consume\nWorker->Store: persist\nWorker->Queue: acknowledge\n",
    },
    {
      id: "architecture-storage",
      family: "architecture",
      title: "Storage service group",
      description: "A small authored service group with explicit ports.",
      scope: "Authored services, ports and structural connections. Deployment is not executed.",
      extension: "mmd",
      source: "architecture-beta\n    group api(cloud)[API]\n\n    service db(database)[Database] in api\n    service disk1(disk)[Storage] in api\n    service disk2(disk)[Storage] in api\n    service server(server)[Server] in api\n\n    db:L -- R:server\n    disk1:T -- B:server\n    disk2:T -- B:db\n",
    },
    {
      id: "architecture-boundary-ports",
      family: "architecture",
      title: "Connections at group boundaries",
      description: "Two opposite connections retain their group-boundary attachment.",
      scope: "Authored services, ports and structural connections. Deployment is not executed.",
      extension: "mmd",
      source: "architecture-beta\ngroup left(cloud)[Left]\ngroup right(server)[Right]\nservice a(server)[A] in left\nservice b(database)[B] in right\na{group}:R --> L:b{group}\na{group}:R <-- L:b{group}\n",
    },
    {
      id: "architecture-nested-network",
      family: "architecture",
      title: "Nested network and junction",
      description: "Nested service ownership and a declared junction join.",
      scope: "Authored services, ports and structural connections. Deployment is not executed.",
      extension: "mmd",
      source: "architecture-beta\ntitle Nested processing network\ngroup cloud(cloud)[Cloud]\ngroup ingest(server)[Ingest] in cloud\ngroup data(database)[Data] in cloud\nservice api(server)[API] in ingest\nservice worker(server)[Worker] in ingest\nservice db(database)[Database] in data\nservice archive(disk)[Archive] in data\njunction join in cloud\napi:R --> L:worker\nworker:B --> T:join\njoin:R --> L:db\njoin:B --> T:archive\n",
    },
    {
      id: "bpmn-approval-loop",
      family: "BPMN",
      title: "Approval with a return route",
      description: "An automatic process with a decision and a review return.",
      scope: "Process and collaboration structure only. No process execution or token simulation.",
      extension: "bpmn",
      source: "<b:definitions xmlns:b=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" targetNamespace=\"urn:gallery:expanded\">\n<b:process id=\"Approval\" isExecutable=\"false\">\n<b:startEvent id=\"start\"/><b:userTask id=\"review\" name=\"Review\"/><b:exclusiveGateway id=\"decision\" name=\"Approved?\"/><b:endEvent id=\"end\"/>\n<b:sequenceFlow id=\"request\" sourceRef=\"start\" targetRef=\"review\"/>\n<b:sequenceFlow id=\"check\" sourceRef=\"review\" targetRef=\"decision\"/>\n<b:sequenceFlow id=\"retry\" sourceRef=\"decision\" targetRef=\"review\" name=\"retry\"/>\n<b:sequenceFlow id=\"approve\" sourceRef=\"decision\" targetRef=\"end\" name=\"yes\"/>\n</b:process>\n</b:definitions>\n",
    },
    {
      id: "bpmn-pool-messages",
      family: "BPMN",
      title: "Cross-pool request and response",
      description: "A collaboration with independent buyer and seller processes.",
      scope: "Process and collaboration structure only. No process execution or token simulation.",
      extension: "bpmn",
      source: "<b:definitions xmlns:b=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" targetNamespace=\"urn:gallery:expanded\">\n<b:process id=\"Buyer\"><b:startEvent id=\"bs\"/><b:sendTask id=\"request\" name=\"Request\"/><b:receiveTask id=\"receive\" name=\"Receive\"/><b:endEvent id=\"be\"/><b:sequenceFlow id=\"b1\" sourceRef=\"bs\" targetRef=\"request\"/><b:sequenceFlow id=\"b2\" sourceRef=\"request\" targetRef=\"receive\"/><b:sequenceFlow id=\"b3\" sourceRef=\"receive\" targetRef=\"be\"/></b:process>\n<b:process id=\"Seller\"><b:startEvent id=\"ss\"/><b:serviceTask id=\"handle\" name=\"Handle\"/><b:endEvent id=\"se\"/><b:sequenceFlow id=\"s1\" sourceRef=\"ss\" targetRef=\"handle\"/><b:sequenceFlow id=\"s2\" sourceRef=\"handle\" targetRef=\"se\"/></b:process>\n<b:collaboration id=\"Trade\"><b:participant id=\"buyer\" name=\"Buyer\" processRef=\"Buyer\"/><b:participant id=\"seller\" name=\"Seller\" processRef=\"Seller\"/><b:messageFlow id=\"order\" sourceRef=\"request\" targetRef=\"handle\"/><b:messageFlow id=\"receipt\" sourceRef=\"handle\" targetRef=\"receive\"/></b:collaboration>\n</b:definitions>\n",
    },
    {
      id: "bpmn-subprocess-timeout",
      family: "BPMN",
      title: "Subprocess and boundary timeout",
      description: "Nested activities and a boundary timer show structural exception paths.",
      scope: "Process and collaboration structure only. No process execution or token simulation.",
      extension: "bpmn",
      source: "<b:definitions xmlns:b=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" targetNamespace=\"urn:gallery:expanded\">\n<b:process id=\"Fulfilment\" isExecutable=\"false\">\n<b:startEvent id=\"start\"/><b:subProcess id=\"work\" name=\"Fulfil order\"><b:startEvent id=\"innerStart\"/><b:serviceTask id=\"pack\" name=\"Pack\"/><b:endEvent id=\"innerEnd\"/><b:sequenceFlow id=\"i1\" sourceRef=\"innerStart\" targetRef=\"pack\"/><b:sequenceFlow id=\"i2\" sourceRef=\"pack\" targetRef=\"innerEnd\"/></b:subProcess>\n<b:boundaryEvent id=\"timeout\" attachedToRef=\"work\"><b:timerEventDefinition/></b:boundaryEvent><b:task id=\"escalate\" name=\"Escalate\"/><b:endEvent id=\"end\"/>\n<b:sequenceFlow id=\"f1\" sourceRef=\"start\" targetRef=\"work\"/><b:sequenceFlow id=\"f2\" sourceRef=\"work\" targetRef=\"end\"/><b:sequenceFlow id=\"f3\" sourceRef=\"timeout\" targetRef=\"escalate\"/><b:sequenceFlow id=\"f4\" sourceRef=\"escalate\" targetRef=\"end\"/>\n</b:process>\n</b:definitions>\n",
    },
    {
      id: "swimlane-escalation",
      family: "swimlane",
      title: "Three-team escalation",
      description: "Responsibility bands with a review loop and an escalation.",
      scope: "Native swimlane-beta responsibility bands and bounded structural exploration.",
      extension: "mmd",
      source: "swimlane-beta LR\nsubgraph Customer [Customer]\nA[Request]\nend\nsubgraph Support [Support]\nB{Review}\nend\nsubgraph Engineering [Engineering]\nC[Investigate]\nD([Complete])\nend\nA --> B\nB -->|escalate| C\nC -->|clarify| B\nC --> D\n",
    },
    {
      id: "swimlane-reverse-handoff",
      family: "swimlane",
      title: "Right-to-left handoff",
      description: "A reverse direction route preserves its marked endpoints.",
      scope: "Native swimlane-beta responsibility bands and bounded structural exploration.",
      extension: "mmd",
      source: "swimlane-beta RL\nsubgraph Intake [Intake]\nA([Received])\nB[Validate]\nend\nsubgraph Dispatch [Dispatch]\nC[Ship]\nD((Done))\nend\nA --> B\nB --> C\nC --> D\n",
    },
    {
      id: "swimlane-nested-ownership",
      family: "swimlane",
      title: "Nested ownership and return",
      description: "Nested responsibility groups keep ownership and a return route.",
      scope: "Native swimlane-beta responsibility bands and bounded structural exploration.",
      extension: "mmd",
      source: "swimlane-beta TB\nsubgraph Operations [Operations]\nA[Receive]\nsubgraph Reviewers [Reviewers]\nB[Check]\nC[Approve]\nend\nend\nsubgraph Delivery [Delivery]\nD[Deliver]\nend\nA --> B\nB --> C\nC --> D\nC -->|revise| A\n",
    },
    {
      id: "flowchart-mermaid-dispatch",
      family: "flowchart",
      title: "Mermaid dispatch decisions",
      description: "Branching decisions, a return path and parallel delivery targets.",
      scope: "Mermaid or PlantUML activity structure and bounded exploration. Conditions are not evaluated and workflows are not executed.",
      extension: "mmd",
      source: "flowchart LR\nsubgraph Intake\nA[Read] --> B{Valid?}\nend\nB -->|no| A\nB -->|yes| C{Priority?}\nC -->|fast| D[Express]\nC -->|normal| E[Queue]\nD --> F[Notify]\nE --> F\nF --> G[Archive]\n",
    },
    {
      id: "flowchart-modern-parallel",
      family: "flowchart",
      title: "PlantUML parallel preparation",
      description: "Modern activity syntax with repeat, fork and a nested partition.",
      scope: "Mermaid or PlantUML activity structure and bounded exploration. Conditions are not evaluated and workflows are not executed.",
      extension: "puml",
      source: "@startuml\ntitle Parallel preparation\nstart\npartition Preparation {\nrepeat\n:Validate;\nrepeat while (Retry?) is (yes) not (no)\nfork\n:Prepare stock;\nfork again\n:Prepare invoice;\nend fork\n}\n:Dispatch;\nstop\n@enduml\n",
    },
    {
      id: "flowchart-legacy-return",
      family: "flowchart",
      title: "PlantUML legacy retry",
      description: "Legacy activity aliases, a partition and an explicit return route.",
      scope: "Mermaid or PlantUML activity structure and bounded exploration. Conditions are not evaluated and workflows are not executed.",
      extension: "puml",
      source: "@startuml\ntitle Legacy retry\npartition Intake {\n(*) --> \"Receive\" as R\nR --> \"Check\" as C\n}\nif \"Ready?\" then\n-->[yes] \"Dispatch\" as D\nelse\n-->[no] \"Correct\" as Fix\nFix --> R\nendif\nD --> (*)\n@enduml\n",
    },
    {
      id: "regex-identifier",
      family: "regex",
      title: "Identifier validation",
      description: "Anchors and a bounded repeated character class.",
      scope: "Regex syntax and structural exploration only. Match evidence requires an external engine.",
      extension: "puml",
      source: "@startregex\ntitle Identifier\n^[A-Za-z_][A-Za-z0-9_]{0,31}$\n@endregex\n",
    },
    {
      id: "regex-alternatives",
      family: "regex",
      title: "Alternatives and repetition",
      description: "Nested alternatives and optional repeated suffixes.",
      scope: "Regex syntax and structural exploration only. Match evidence requires an external engine.",
      extension: "puml",
      source: "@startregex\ntitle Colour tags\n(?:red|green|blue)(?:-(?:light|dark))?(?:,[a-z]+)*\n@endregex\n",
    },
    {
      id: "regex-assertions",
      family: "regex",
      title: "Assertions and named capture",
      description: "A named capture, lookahead and negative assertion.",
      scope: "Regex syntax and structural exploration only. Match evidence requires an external engine.",
      extension: "puml",
      source: "@startregex\ntitle Version capture\n(?=v)(?<version>v\\d+(?:\\.\\d+){1,2})(?![\\w.])\n@endregex\n",
    },
    {
      id: "ebnf-command",
      family: "EBNF",
      title: "Command grammar",
      description: "A command with a choice and an optional argument.",
      scope: "Grammar structure and bounded exploration only. Parse evidence requires an external engine.",
      extension: "puml",
      source: "@startebnf\ntitle Command\ncommand = (\"get\" | \"put\"), name, [ \"--force\" ];\nname = letter, { letter | digit };\nletter = ? alphabetic ?;\ndigit = ? decimal digit ?;\n@endebnf\n",
    },
    {
      id: "ebnf-recursive-list",
      family: "EBNF",
      title: "Recursive nested lists",
      description: "Recursive references describe nested list syntax.",
      scope: "Grammar structure and bounded exploration only. Parse evidence requires an external engine.",
      extension: "puml",
      source: "@startebnf\ntitle Nested lists\nlist = \"[\", [ item, { \",\", item } ], \"]\";\nitem = word | list;\nword = letter, { letter };\nletter = ? alphabetic ?;\n@endebnf\n",
    },
    {
      id: "ebnf-protocol",
      family: "EBNF",
      title: "Protocol fields and choices",
      description: "Optional and repeated fields with an explicit alternative.",
      scope: "Grammar structure and bounded exploration only. Parse evidence requires an external engine.",
      extension: "puml",
      source: "@startebnf\ntitle Protocol line\nmessage = verb, \" \", path, [ \"?\", query ];\nverb = \"GET\" | \"POST\" | \"DELETE\";\npath = \"/\", name, { \"/\", name };\nquery = name, \"=\", name, { \"&\", name, \"=\", name };\nname = ? nonempty text ?;\n@endebnf\n",
    },
    {
      id: "json-api-response",
      family: "JSON",
      title: "API response data",
      description: "Nested result and pagination objects preserve scalar types.",
      scope: "Native JSON data-tree rendering with exact scalar values and structural exploration.",
      extension: "puml",
      source: "@startjson\ntitle API response\n{\"ok\":true,\"data\":{\"id\":42,\"name\":\"Ada\"},\"page\":{\"next\":null,\"count\":1}}\n@endjson\n",
    },
    {
      id: "json-inventory",
      family: "JSON",
      title: "Inventory and empty collections",
      description: "A list of records with empty object and array values.",
      scope: "Native JSON data-tree rendering with exact scalar values and structural exploration.",
      extension: "puml",
      source: "@startjson\ntitle Inventory\n{\"warehouse\":{\"items\":[{\"sku\":\"A\",\"stock\":3,\"tags\":[\"fragile\",\"gift\"]},{\"sku\":\"B\",\"stock\":0,\"tags\":[]}],\"reserved\":{},\"locations\":[\"north\",\"south\"]}}\n@endjson\n",
    },
    {
      id: "json-exact-values",
      family: "JSON",
      title: "Repeated values and exact numbers",
      description: "Repeated strings and large numeric tokens retain their source values.",
      scope: "Native JSON data-tree rendering with exact scalar values and structural exploration.",
      extension: "puml",
      source: "@startjson\ntitle Exact values\n{\"ids\":[12345678901234567890,12345678901234567890],\"amount\":0.000000001,\"states\":[false,true,null],\"labels\":[\"same\",\"same\"],\"meta\":{\"empty\":\"\",\"unicode\":\"café\"}}\n@endjson\n",
    },
    {
      id: "yaml-deployment",
      family: "YAML",
      title: "Deployment configuration",
      description: "Nested configuration maps with scalar and list values.",
      scope: "Native YAML data-tree rendering with string scalars and structural exploration. No YAML execution.",
      extension: "puml",
      source: "@startyaml\ntitle Deployment\ndeployment:\n  name: web\n  replicas: 3\n  image:\n    repository: example/web\n    tag: stable\n  ports: [80, 443]\n@endyaml\n",
    },
    {
      id: "yaml-service-list",
      family: "YAML",
      title: "A list of services",
      description: "Service maps have different nested endpoint lists.",
      scope: "Native YAML data-tree rendering with string scalars and structural exploration. No YAML execution.",
      extension: "puml",
      source: "@startyaml\ntitle Services\nservices:\n  - name: api\n    endpoints: [read, write]\n    health:\n      path: /health\n  - name: worker\n    endpoints: []\n    queue: jobs\n@endyaml\n",
    },
    {
      id: "yaml-mixed-collections",
      family: "YAML",
      title: "Flow and block collections",
      description: "Flow collections and block text remain native data values.",
      scope: "Native YAML data-tree rendering with string scalars and structural exploration. No YAML execution.",
      extension: "puml",
      source: "@startyaml\ntitle Mixed collections\nsettings:\n  limits: {soft: 20, hard: 100}\n  regions: [east, west]\n  notes: |\n    First line\n    Second line\nroutes:\n  - [api, worker]\n  - [worker, store]\n@endyaml\n",
    },
  ]
}
