pression\",\n      \"fields\": {\n        \"@body\": {\n          \"kind\": \"string\",\n          \"value\": \"done == true\"\n        },\n        \"language\": {\n          \"kind\": \"string\",\n          \"value\": \"urn:inert\"\n        }\n      },\n      \"children\": []\n    },\n    {\n      \"key\": \"#AdHocTask\",\n      \"parent\": \"#AdHoc\",\n      \"type\": \"bpmn:Task\",\n      \"fields\": {\n        \"id\": {\n          \"kind\": \"string\",\n          \"value\": \"AdHocTask\"\n        }\n      },\n      \"children\": []\n    },\n    {\n      \"key\": \"#Audit\",\n      \"parent\": \"#P\",\n      \"type\": \"bpmn:Auditing\",\n      \"fields\": {\n        \"id\": {\n          \"kind\": \"string\",\n          \"value\": \"Audit\"\n        }\n      },\n      \"children\": []\n    },\n    {\n      \"key\": \"#Behavior\",\n      \"parent\": \"#Multi\",\n      \"type\": \"bpmn:ComplexBehaviorDefinition\",\n      \"fields\": {\n        \"id\": {\n          \"kind\": \"string\",\n          \"value\": \"Behavior\"\n        }\n      },\n      \"children\": [\n        \"#Behavior/bpmn:FormalExpression[0]\",\n        \"#Implicit\"\n      ]\n    },\n    {\n      \"key\": \"#Behavior/bpmn:FormalExpression[0]\",\n      \"parent\": \"#Behavior\",\n      \"type\": \"bpmn:FormalExpression\",\n      \"fields\": {\n        \"@body\": {\n          \"kind\": \"string\",\n          \"value\": \"count > 1\"\n        }\n      },\n      \"children\": []\n    },\n    {\n      \"key\": \"#Call\",\n      \"parent\": \"#P\",\n      \"type\": \"bpmn:CallActivity\",\n      \"fields\": {\n        \"calledElement\": {\n          \"kind\": \"string\",\n          \"value\": \"GlobalTask\"\n        },\n        \"id\": {\n          \"kind\": \"string\",\n          \"value\": \"Call\"\n        }\n      },\n      \"children\": []\n    },\n    {\n      \"key\": \"#Doc\",\n      \"parent\": \"#P\",\n      \"type\": \"bpmn:Documentation\",\n      \"fields\": {\n        \"@body\": {\n          