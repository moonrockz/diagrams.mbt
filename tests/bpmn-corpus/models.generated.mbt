pub let model_inputs : ReadOnlyArray[Input] = [
  { name: "activities.bpmn", sha256: "02649df4ef544cf0c3d488b803aa74bb9ee0470a291f593e00cec6d5159c205d", source: "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" id=\"Activities\" targetNamespace=\"urn:activities\">\n  <bpmn:itemDefinition id=\"Item\" structureRef=\"xsi:type\" isCollection=\"false\" itemKind=\"Information\"/>\n  <bpmn:message id=\"Message\" name=\"Request\" itemRef=\"Item\"/>\n  <bpmn:error id=\"Error\" name=\"Failure\" errorCode=\"E1\" structureRef=\"Item\"/>\n  <bpmn:escalation id=\"Escalation\" escalationCode=\"S1\" structureRef=\"Item\"/>\n  <bpmn:signal id=\"Signal\" name=\"Ready\" structureRef=\"Item\"/>\n  <bpmn:interface id=\"Interface\" name=\"Service\" implementationRef=\"Item\"><bpmn:operation id=\"Operation\" name=\"Invoke\"><bpmn:inMessageRef>Message</bpmn:inMessageRef><bpmn:outMessageRef>Message</bpmn:outMessageRef><bpmn:errorRef>Error</bpmn:errorRef></bpmn:operation></bpmn:interface>\n  <bpmn:globalTask id=\"GlobalTask\" name=\"Reusable\"/>\n  <bpmn:globalUserTask id=\"GlobalUser\" name=\"Reusable review\" implementation=\"##unspecified\"/>\n  <bpmn:globalBusinessRuleTask id=\"GlobalRule\" implementation=\"##unspecified\"/>\n  <bpmn:globalManualTask id=\"GlobalManual\"/>\n  <bpmn:globalScriptTask id=\"GlobalScript\" scriptLanguage=\"urn:inert\"><bpmn:script>describe-only()</bpmn:script></bpmn:globalScriptTask>\n  <bpmn:process id=\"P\" name=\"Activity inventory\" processType=\"Private\" isClosed=\"false\" isExecutable=\"false\">\n    <bpmn:documentation id=\"Doc\">Review &amp; approve 😀</bpmn:documentation>\n    <bpmn:auditing id=\"Audit\"/><bpmn:monitoring id=\"Monitor\"/>\n    <bpmn:property id=\"Property\" name=\"Request\" itemSubjectRef=\"Item\"/>\n    <bpmn:task id=\"Task\" name=\"Generic\" isForCompensation=\"false\" startQuantity=\"1\" completionQuantity=\"2\"/>\n    <bpmn:userTask id=\"User\" name=\"Review\" implementation=\"##unspecified\"><bpmn:rendering id=\"Rendering\"/></bpmn:userTask>\n    <bpmn:serviceTask id=\"Service\" implementation=\"##WebService\" operationRef=\"Operation\"/>\n    <bpmn:scriptTask id=\"Script\" scriptFormat=\"urn:inert\"><bpmn:script>neverExecute(&lt;request&gt;)</bpmn:script></bpmn:scriptTask>\n    <bpmn:businessRuleTask id=\"Rule\" implementation=\"urn:rules\"/>\n    <bpmn:manualTask id=\"Manual\"/>\n    <bpmn:sendTask id=\"Send\" implementation=\"##WebService\" messageRef=\"Message\" operationRef=\"Operation\"/>\n    <bpmn:receiveTask id=\"Receive\" implementation=\"##WebService\" instantiate=\"false\" messageRef=\"Message\" operationRef=\"Operation\"/>\n    <bpmn:callActivity id=\"Call\" calledElement=\"GlobalTask\"/>\n    <bpmn:subProcess id=\"Sub\" triggeredByEvent=\"false\"><bpmn:startEvent id=\"SubStart\"/><bpmn:task id=\"SubTask\"/><bpmn:endEvent id=\"SubEnd\"/><bpmn:sequenceFlow id=\"SubFlow1\" sourceRef=\"SubStart\" targetRef=\"SubTask\"/><bpmn:sequenceFlow id=\"SubFlow2\" sourceRef=\"SubTask\" targetRef=\"SubEnd\"/></bpmn:subProcess>\n    <bpmn:adHocSubProcess id=\"AdHoc\" ordering=\"Parallel\" cancelRemainingInstances=\"true\"><bpmn:task id=\"AdHocTask\"/><bpmn:completionCondition xsi:type=\"bpmn:tFormalExpression\" language=\"urn:inert\">done == true</bpmn:completionCondition></bpmn:adHocSubProcess>\n    <bpmn:transaction id=\"Transaction\" method=\"##Compensate\"><bpmn:task id=\"TransactionTask\"/></bpmn:transaction>\n    <bpmn:task id=\"StandardLoop\"><bpmn:standardLoopCharacteristics id=\"Loop\" testBefore=\"true\" loopMaximum=\"999999999999999999999999\"><bpmn:loopCondition xsi:type=\"bpmn:tFormalExpression\">retry &lt; 3</bpmn:loopCondition></bpmn:standardLoopCharacteristics></bpmn:task>\n    <bpmn:task id=\"MultiLoop\"><bpmn:multiInstanceLoopCharacteristics id=\"Multi\" isSequential=\"false\" behavior=\"Complex\">\n      <bpmn:loopCardinality xsi:type=\"bpmn:tFormalExpression\">3</bpmn:loopCardinality>\n      <bpmn:loopDataInputRef>Property</bpmn:loopDataInputRef><bpmn:loopDataOutputRef>Property</bpmn:loopDataOutputRef>\n      <bpmn:inputDataItem id=\"InputItem\" name=\"row\" itemSubjectRef=\"Item\" isCollection=\"false\"/>\n      <bpmn:outputDataItem id=\"OutputItem\" name=\"result\" itemSubjectRef=\"Item\" isCollection=\"false\"/>\n      <bpmn:complexBehaviorDefinition id=\"Behavior\"><bpmn:condition>count &gt; 1</bpmn:condition><bpmn:event id=\"Implicit\"/></bpmn:complexBehaviorDefinition>\n      <bpmn:completionCondition xsi:type=\"bpmn:tFormalExpression\">allDone</bpmn:completionCondition>\n    </bpmn:multiInstanceLoopCharacteristics></bpmn:task>\n  </bpmn:process>\n</bpmn:definitions>\n" },
  { name: "events.bpmn", sha256: "df1c87920e3f7d832d10573f65dd159cf5b15d43d6fa7556b86389aadd95a270", source: "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" id=\"Events\" targetNamespace=\"urn:events\">\n  <bpmn:message id=\"Message\"/><bpmn:error id=\"Error\" errorCode=\"E\"/><bpmn:signal id=\"Signal\" name=\"Ready\"/><bpmn:escalation id=\"Escalation\" escalationCode=\"S\"/>\n  <bpmn:timerEventDefinition id=\"ReusableTimer\"><bpmn:timeDuration xsi:type=\"bpmn:tFormalExpression\">PT5M</bpmn:timeDuration></bpmn:timerEventDefinition>\n  <bpmn:process id=\"P\" isExecutable=\"false\">\n    <bpmn:startEvent id=\"Start\" isInterrupting=\"true\" parallelMultiple=\"false\"><bpmn:messageEventDefinition id=\"StartMessage\" messageRef=\"Message\"/></bpmn:startEvent>\n    <bpmn:task id=\"Task\"/><bpmn:transaction id=\"Transaction\" method=\"##Compensate\"/>\n    <bpmn:boundaryEvent id=\"Boundary\" attachedToRef=\"Task\" cancelActivity=\"true\"><bpmn:errorEventDefinition id=\"BoundaryError\" errorRef=\"Error\"/></bpmn:boundaryEvent>\n    <bpmn:boundaryEvent id=\"CancelBoundary\" attachedToRef=\"Transaction\"><bpmn:cancelEventDefinition id=\"Cancel\"/></bpmn:boundaryEvent>\n    <bpmn:boundaryEvent id=\"CompensateBoundary\" attachedToRef=\"Task\" cancelActivity=\"false\"><bpmn:compensateEventDefinition id=\"CompensateCatch\" waitForCompletion=\"true\" activityRef=\"Task\"/></bpmn:boundaryEvent>\n    <bpmn:intermediateCatchEvent id=\"Timer\"><bpmn:timerEventDefinition id=\"Duration\"><bpmn:timeDuration xsi:type=\"bpmn:tFormalExpression\">PT5M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>\n    <bpmn:intermediateCatchEvent id=\"Date\"><bpmn:timerEventDefinition id=\"DateDefinition\"><bpmn:timeDate xsi:type=\"bpmn:tFormalExpression\">2030-01-01T00:00:00Z</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>\n    <bpmn:intermediateCatchEvent id=\"Cycle\"><bpmn:timerEventDefinition id=\"CycleDefinition\"><bpmn:timeCycle xsi:type=\"bpmn:tFormalExpression\">R3/PT1H</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>\n    <bpmn:intermediateCatchEvent id=\"Condition\"><bpmn:conditionalEventDefinition id=\"Conditional\"><bpmn:condition xsi:type=\"bpmn:tFormalExpression\" language=\"urn:inert\">amount &gt; 10</bpmn:condition></bpmn:conditionalEventDefinition></bpmn:intermediateCatchEvent>\n    <bpmn:intermediateCatchEvent id=\"SignalCatch\"><bpmn:signalEventDefinition id=\"SignalDefinition\" signalRef=\"Signal\"/></bpmn:intermediateCatchEvent>\n    <bpmn:intermediateCatchEvent id=\"LinkCatch\"><bpmn:linkEventDefinition id=\"LinkTarget\" name=\"resume\"><bpmn:source>LinkSource</bpmn:source></bpmn:linkEventDefinition></bpmn:intermediateCatchEvent>\n    <bpmn:intermediateThrowEvent id=\"LinkThrow\"><bpmn:linkEventDefinition id=\"LinkSource\" name=\"resume\"><bpmn:target>LinkTarget</bpmn:target></bpmn:linkEventDefinition></bpmn:intermediateThrowEvent>\n    <bpmn:intermediateThrowEvent id=\"EscalationThrow\"><bpmn:escalationEventDefinition id=\"Escalate\" escalationRef=\"Escalation\"/></bpmn:intermediateThrowEvent>\n    <bpmn:intermediateThrowEvent id=\"CompensateThrow\"><bpmn:compensateEventDefinition id=\"Compensate\" activityRef=\"Task\" waitForCompletion=\"false\"/></bpmn:intermediateThrowEvent>\n    <bpmn:intermediateCatchEvent id=\"ReferencedTimer\"><bpmn:eventDefinitionRef>ReusableTimer</bpmn:eventDefinitionRef></bpmn:intermediateCatchEvent>\n    <bpmn:exclusiveGateway id=\"Exclusive\" gatewayDirection=\"Diverging\" default=\"Fallback\"/>\n    <bpmn:inclusiveGateway id=\"Inclusive\" gatewayDirection=\"Converging\"/>\n    <bpmn:parallelGateway id=\"Parallel\" gatewayDirection=\"Mixed\"/>\n    <bpmn:complexGateway id=\"Complex\" gatewayDirection=\"Diverging\"><bpmn:activationCondition xsi:type=\"bpmn:tFormalExpression\">ready</bpmn:activationCondition></bpmn:complexGateway>\n    <bpmn:eventBasedGateway id=\"EventBased\" gatewayDirection=\"Diverging\" eventGatewayType=\"Exclusive\" instantiate=\"false\"/>\n    <bpmn:endEvent id=\"End\"><bpmn:terminateEventDefinition id=\"Terminate\"/></bpmn:endEvent>\n    <bpmn:sequenceFlow id=\"Begin\" sourceRef=\"Start\" targetRef=\"Task\"/>\n    <bpmn:sequenceFlow id=\"ConditionalFlow\" name=\"approved\" sourceRef=\"Exclusive\" targetRef=\"End\" isImmediate=\"false\"><bpmn:conditionExpression xsi:type=\"bpmn:tFormalExpression\" language=\"urn:inert\">amount &gt; 10 &amp;&amp; ready</bpmn:conditionExpression></bpmn:sequenceFlow>\n    <bpmn:sequenceFlow id=\"Fallback\" sourceRef=\"Exclusive\" targetRef=\"Task\"/>\n  </bpmn:process>\n</bpmn:definitions>\n" },
  { name: "collaboration.bpmn", sha256: "9ba8f83c8d12668f0bcaa56adf2761e3e19c7fa17773b753ad9d81d985467230", source: "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" id=\"CollaborationDefinitions\" targetNamespace=\"urn:collaboration\">\n  <bpmn:import namespace=\"urn:optional\" location=\"https://invalid.example/not-fetched\" importType=\"http://www.omg.org/spec/BPMN/20100524/MODEL\"/>\n  <bpmn:itemDefinition id=\"Item\" structureRef=\"xsi:type\"/>\n  <bpmn:message id=\"Request\" name=\"Request\" itemRef=\"Item\"/>\n  <bpmn:category id=\"Category\" name=\"Department\"><bpmn:categoryValue id=\"CategoryValue\" value=\"Operations\"/></bpmn:category>\n  <bpmn:dataStore id=\"Store\" name=\"Archive\" capacity=\"10000000000000000000000\" isUnlimited=\"false\" itemSubjectRef=\"Item\"/>\n  <bpmn:resource id=\"Resource\" name=\"Reviewer\"><bpmn:resourceParameter id=\"Parameter\" name=\"team\" type=\"Item\" isRequired=\"true\"/></bpmn:resource>\n  <bpmn:process id=\"Buyer\" name=\"Buyer\" isExecutable=\"false\">\n    <bpmn:laneSet id=\"Lanes\" name=\"Teams\"><bpmn:lane id=\"Operations\" name=\"Operations\"><bpmn:flowNodeRef>Send</bpmn:flowNodeRef><bpmn:childLaneSet id=\"NestedLanes\"><bpmn:lane id=\"Reviewers\" name=\"Reviewers\"><bpmn:flowNodeRef>Review</bpmn:flowNodeRef></bpmn:lane></bpmn:childLaneSet></bpmn:lane></bpmn:laneSet>\n    <bpmn:dataObject id=\"Object\" name=\"Request data\" itemSubjectRef=\"Item\" isCollection=\"false\"><bpmn:dataState id=\"State\" name=\"draft\"/></bpmn:dataObject>\n    <bpmn:dataObjectReference id=\"ObjectRef\" name=\"Request\" dataObjectRef=\"Object\" itemSubjectRef=\"Item\"/>\n    <bpmn:dataStoreReference id=\"StoreRef\" dataStoreRef=\"Store\" itemSubjectRef=\"Item\"/>\n    <bpmn:sendTask id=\"Send\" messageRef=\"Request\"/>\n    <bpmn:userTask id=\"Review\" name=\"Review &amp; approve\">\n      <bpmn:ioSpecification id=\"IO\"><bpmn:dataInput id=\"Input\" name=\"request\" itemSubjectRef=\"Item\" isCollection=\"false\"/><bpmn:dataOutput id=\"Output\" name=\"decision\" itemSubjectRef=\"Item\"/><bpmn:inputSet id=\"InputSet\"><bpmn:dataInputRefs>Input</bpmn:dataInputRefs><bpmn:optionalInputRefs>Input</bpmn:optionalInputRefs></bpmn:inputSet><bpmn:outputSet id=\"OutputSet\"><bpmn:dataOutputRefs>Output</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification>\n      <bpmn:dataInputAssociation id=\"DataIn\"><bpmn:sourceRef>ObjectRef</bpmn:sourceRef><bpmn:targetRef>Input</bpmn:targetRef><bpmn:transformation id=\"Transform\" language=\"urn:inert\">copy(input)</bpmn:transformation><bpmn:assignment id=\"Assignment\"><bpmn:from xsi:type=\"bpmn:tFormalExpression\">request</bpmn:from><bpmn:to xsi:type=\"bpmn:tFormalExpression\">input</bpmn:to></bpmn:assignment></bpmn:dataInputAssociation>\n      <bpmn:dataOutputAssociation id=\"DataOut\"><bpmn:sourceRef>Output</bpmn:sourceRef><bpmn:targetRef>StoreRef</bpmn:targetRef></bpmn:dataOutputAssociation>\n      <bpmn:potentialOwner id=\"Owner\" name=\"Reviewers\"><bpmn:resourceRef>Resource</bpmn:resourceRef><bpmn:resourceParameterBinding parameterRef=\"Parameter\"><bpmn:expression xsi:type=\"bpmn:tFormalExpression\">team</bpmn:expression></bpmn:resourceParameterBinding></bpmn:potentialOwner>\n      <bpmn:potentialOwner id=\"OwnerAssignment\" name=\"Assigned reviewers\"><bpmn:resourceAssignmentExpression><bpmn:expression xsi:type=\"bpmn:tFormalExpression\">reviewers</bpmn:expression></bpmn:resourceAssignmentExpression></bpmn:potentialOwner>\n    </bpmn:userTask>\n    <bpmn:sequenceFlow id=\"BuyerFlow\" sourceRef=\"Send\" targetRef=\"Review\"/>\n    <bpmn:group id=\"Group\" categoryValueRef=\"CategoryValue\"/>\n    <bpmn:textAnnotation id=\"Note\" textFormat=\"text/plain\"><bpmn:text>Illustrative document; no execution.</bpmn:text></bpmn:textAnnotation>\n    <bpmn:association id=\"Association\" sourceRef=\"Review\" targetRef=\"Note\" associationDirection=\"One\"/>\n  </bpmn:process>\n  <bpmn:process id=\"Seller\" name=\"Seller\" isExecutable=\"false\"><bpmn:receiveTask id=\"Receive\" messageRef=\"Request\" instantiate=\"false\"/></bpmn:process>\n  <bpmn:collaboration id=\"Collaboration\" name=\"Request exchange\" isClosed=\"false\"><bpmn:participant id=\"BuyerPool\" name=\"Buyer\" processRef=\"Buyer\"><bpmn:participantMultiplicity id=\"Multiplicity\" minimum=\"1\" maximum=\"3\"/></bpmn:participant><bpmn:participant id=\"SellerPool\" name=\"Seller\" processRef=\"Seller\"/><bpmn:messageFlow id=\"RequestFlow\" name=\"Request\" sourceRef=\"Send\" targetRef=\"Receive\" messageRef=\"Request\"/></bpmn:collaboration>\n</bpmn:definitions>\n" },
  { name: "choreography-conversation.bpmn", sha256: "adc82e887410e5ebb761f4c84a008703077e3bca54af16b1ad639642f7ae595a", source: "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" id=\"ChoreographyConversations\" targetNamespace=\"urn:choreography\">\n  <bpmn:message id=\"Message\" name=\"Request\"/>\n  <bpmn:choreography id=\"Reusable\" name=\"Reusable exchange\"><bpmn:participant id=\"RA\"/><bpmn:participant id=\"RB\"/><bpmn:messageFlow id=\"RM\" sourceRef=\"RA\" targetRef=\"RB\" messageRef=\"Message\"/></bpmn:choreography>\n  <bpmn:globalChoreographyTask id=\"GlobalChoreography\" initiatingParticipantRef=\"GA\"><bpmn:participant id=\"GA\"/><bpmn:participant id=\"GB\"/></bpmn:globalChoreographyTask>\n  <bpmn:choreography id=\"Choreography\" name=\"Exchange\">\n    <bpmn:participant id=\"A\" name=\"Buyer\"/><bpmn:participant id=\"B\" name=\"Seller\"/>\n    <bpmn:messageFlow id=\"MF\" sourceRef=\"A\" targetRef=\"B\" messageRef=\"Message\"/>\n    <bpmn:startEvent id=\"Start\"/>\n    <bpmn:choreographyTask id=\"CT\" name=\"Request\" initiatingParticipantRef=\"A\" loopType=\"MultiInstanceSequential\"><bpmn:participantRef>A</bpmn:participantRef><bpmn:participantRef>B</bpmn:participantRef><bpmn:messageFlowRef>MF</bpmn:messageFlowRef></bpmn:choreographyTask>\n    <bpmn:subChoreography id=\"SubCT\" name=\"Nested\" initiatingParticipantRef=\"B\"><bpmn:participantRef>A</bpmn:participantRef><bpmn:participantRef>B</bpmn:participantRef><bpmn:choreographyTask id=\"NestedCT\" initiatingParticipantRef=\"A\"><bpmn:participantRef>A</bpmn:participantRef><bpmn:participantRef>B</bpmn:participantRef><bpmn:messageFlowRef>MF</bpmn:messageFlowRef></bpmn:choreographyTask></bpmn:subChoreography>\n    <bpmn:callChoreography id=\"CallCT\" initiatingParticipantRef=\"A\" calledChoreographyRef=\"Reusable\"><bpmn:participantRef>A</bpmn:participantRef><bpmn:participantRef>B</bpmn:participantRef><bpmn:participantAssociation id=\"CPA\"><bpmn:innerParticipantRef>RA</bpmn:innerParticipantRef><bpmn:outerParticipantRef>A</bpmn:outerParticipantRef></bpmn:participantAssociation></bpmn:callChoreography>\n    <bpmn:endEvent id=\"End\"/>\n    <bpmn:sequenceFlow id=\"CF1\" sourceRef=\"Start\" targetRef=\"CT\"/><bpmn:sequenceFlow id=\"CF2\" sourceRef=\"CT\" targetRef=\"SubCT\"/><bpmn:sequenceFlow id=\"CF3\" sourceRef=\"SubCT\" targetRef=\"CallCT\"/><bpmn:sequenceFlow id=\"CF4\" sourceRef=\"CallCT\" targetRef=\"End\"/>\n  </bpmn:choreography>\n  <bpmn:globalConversation id=\"GlobalConversation\" name=\"Reusable conversation\"><bpmn:participant id=\"RCA\"/><bpmn:participant id=\"RCB\"/><bpmn:messageFlow id=\"RCM\" sourceRef=\"RCA\" targetRef=\"RCB\" messageRef=\"Message\"/></bpmn:globalConversation>\n  <bpmn:collaboration id=\"Conversations\" name=\"Conversation view\">\n    <bpmn:participant id=\"CA\" name=\"Buyer\"/><bpmn:participant id=\"CB\" name=\"Seller\"/><bpmn:messageFlow id=\"CM\" sourceRef=\"CA\" targetRef=\"CB\" messageRef=\"Message\"/>\n    <bpmn:conversation id=\"Conversation\" name=\"Order\"><bpmn:participantRef>CA</bpmn:participantRef><bpmn:participantRef>CB</bpmn:participantRef><bpmn:messageFlowRef>CM</bpmn:messageFlowRef></bpmn:conversation>\n    <bpmn:subConversation id=\"SubConversation\" name=\"Details\"><bpmn:participantRef>CA</bpmn:participantRef><bpmn:conversation id=\"NestedConversation\" name=\"Line items\"><bpmn:participantRef>CA</bpmn:participantRef><bpmn:participantRef>CB</bpmn:participantRef></bpmn:conversation></bpmn:subConversation>\n    <bpmn:callConversation id=\"CallConversation\" calledCollaborationRef=\"GlobalConversation\"><bpmn:participantRef>CA</bpmn:participantRef><bpmn:participantAssociation id=\"CallParticipant\"><bpmn:innerParticipantRef>RCA</bpmn:innerParticipantRef><bpmn:outerParticipantRef>CA</bpmn:outerParticipantRef></bpmn:participantAssociation></bpmn:callConversation>\n    <bpmn:conversationAssociation id=\"ConversationAssociation\" innerConversationNodeRef=\"NestedConversation\" outerConversationNodeRef=\"Conversation\"/>\n    <bpmn:participantAssociation id=\"ParticipantAssociation\"><bpmn:innerParticipantRef>RCA</bpmn:innerParticipantRef><bpmn:outerParticipantRef>CA</bpmn:outerParticipantRef></bpmn:participantAssociation>\n    <bpmn:messageFlowAssociation id=\"MessageAssociation\" innerMessageFlowRef=\"RCM\" outerMessageFlowRef=\"CM\"/>\n    <bpmn:choreographyRef>Choreography</bpmn:choreographyRef>\n    <bpmn:conversationLink id=\"ConversationLinkA\" name=\"Buyer link\" sourceRef=\"CA\" targetRef=\"Conversation\"/><bpmn:conversationLink id=\"ConversationLinkB\" sourceRef=\"Conversation\" targetRef=\"CB\"/>\n  </bpmn:collaboration>\n</bpmn:definitions>\n" },
  { name: "di-views.bpmn", sha256: "8762890ccf7236fe2a0a100729440d826abdf9111630f2d5c18c38332a53fa67", source: "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"DiViews\" targetNamespace=\"urn:di\">\n  <bpmn:process id=\"P\" isExecutable=\"false\"><bpmn:task id=\"T\" name=\"Review\"/><bpmn:task id=\"U\" name=\"Approve\"/><bpmn:sequenceFlow id=\"F\" sourceRef=\"T\" targetRef=\"U\"/></bpmn:process>\n  <bpmn:choreography id=\"C\"><bpmn:participant id=\"A\"/><bpmn:participant id=\"B\"/><bpmn:messageFlow id=\"M\" sourceRef=\"A\" targetRef=\"B\"/><bpmn:choreographyTask id=\"CTask\" initiatingParticipantRef=\"A\"><bpmn:participantRef>A</bpmn:participantRef><bpmn:participantRef>B</bpmn:participantRef><bpmn:messageFlowRef>M</bpmn:messageFlowRef></bpmn:choreographyTask></bpmn:choreography>\n  <bpmndi:BPMNDiagram id=\"D1\" name=\"Process\" documentation=\"Exact supplied geometry\" resolution=\"96.000\">\n    <bpmndi:BPMNPlane id=\"Plane1\" bpmnElement=\"P\">\n      <bpmndi:BPMNShape id=\"S1\" bpmnElement=\"T\" isExpanded=\"true\" isMarkerVisible=\"false\"><dc:Bounds x=\"-12.345678901234567890123456789\" y=\"10.000\" width=\"100.00000000000000001\" height=\"80.000\"/><bpmndi:BPMNLabel id=\"LabelT\" labelStyle=\"Style1\"><dc:Bounds x=\"1.234567890123456789E+2\" y=\"94\" width=\"45\" height=\"15\"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"S2\" bpmnElement=\"U\"><dc:Bounds x=\"300\" y=\"10\" width=\"100\" height=\"80\"/></bpmndi:BPMNShape>\n      <bpmndi:BPMNEdge id=\"EdgeF\" bpmnElement=\"F\" sourceElement=\"S1\" targetElement=\"S2\" messageVisibleKind=\"initiating\"><di:waypoint x=\"123.45678901234567890123456789\" y=\"50\"/><di:waypoint x=\"300\" y=\"50\"/><bpmndi:BPMNLabel id=\"LabelF\" labelStyle=\"Style1\"><dc:Bounds x=\"180\" y=\"30\" width=\"40\" height=\"15\"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>\n    </bpmndi:BPMNPlane>\n    <bpmndi:BPMNLabelStyle id=\"Style1\"><dc:Font name=\"Example font\" size=\"1.200000000000000000000001E+1\" isBold=\"true\" isItalic=\"false\" isUnderline=\"true\" isStrikeThrough=\"false\"/></bpmndi:BPMNLabelStyle>\n  </bpmndi:BPMNDiagram>\n  <bpmndi:BPMNDiagram id=\"D2\" name=\"Choreography\">\n    <bpmndi:BPMNPlane id=\"Plane2\" bpmnElement=\"C\">\n      <bpmndi:BPMNShape id=\"CS\" bpmnElement=\"CTask\" isExpanded=\"false\" isMessageVisible=\"true\"><dc:Bounds x=\"0\" y=\"0\" width=\"160\" height=\"120\"/></bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"BandA\" bpmnElement=\"A\" isHorizontal=\"true\" participantBandKind=\"top_initiating\" choreographyActivityShape=\"CS\"><dc:Bounds x=\"0\" y=\"0\" width=\"160\" height=\"20\"/></bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"BandB\" bpmnElement=\"B\" participantBandKind=\"bottom_non_initiating\" choreographyActivityShape=\"CS\"><dc:Bounds x=\"0\" y=\"100\" width=\"160\" height=\"20\"/></bpmndi:BPMNShape>\n    </bpmndi:BPMNPlane>\n  </bpmndi:BPMNDiagram>\n</bpmn:definitions>\n" },
