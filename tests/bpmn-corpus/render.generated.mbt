  { name: "collaboration-di.bpmn", sha256: "d06c528e53ba22ed5b99e75747d6aa9326d733d7c533063c9b85a60b170c7806", source: "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<b:definitions xmlns:b=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bd=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" targetNamespace=\"urn:render:collaboration\">\n  <b:message id=\"OrderMessage\" name=\"Purchase order\"/>\n  <b:process id=\"OrderProcess\" name=\"Prepare order\" isExecutable=\"false\">\n    <b:startEvent id=\"Start\" name=\"Start\"/>\n    <b:subProcess id=\"Prepare\" name=\"Prepare order\">\n      <b:startEvent id=\"Received\" name=\"Received\"/>\n      <b:serviceTask id=\"Work\" name=\"Prepare\"/>\n      <b:endEvent id=\"Ready\" name=\"Ready\"/>\n      <b:sequenceFlow id=\"BeginWork\" sourceRef=\"Received\" targetRef=\"Work\"/>\n      <b:sequenceFlow id=\"CompleteWork\" sourceRef=\"Work\" targetRef=\"Ready\"/>\n    </b:subProcess>\n    <b:endEvent id=\"Placed\" name=\"Placed\"/>\n    <b:sequenceFlow id=\"BeginOrder\" sourceRef=\"Start\" targetRef=\"Prepare\"/>\n    <b:sequenceFlow id=\"CompleteOrder\" sourceRef=\"Prepare\" targetRef=\"Placed\"/>\n  </b:process>\n  <b:collaboration id=\"Purchase\" name=\"Purchase collaboration\">\n    <b:participant id=\"Buyer\" name=\"Buyer\" processRef=\"OrderProcess\"/>\n    <b:participant id=\"Supplier\" name=\"Supplier\"/>\n    <b:messageFlow id=\"Order\" name=\"Order\" sourceRef=\"Work\" targetRef=\"Supplier\" messageRef=\"OrderMessage\"/>\n    <b:textAnnotation id=\"SupplierNote\"><b:text>External supplier</b:text></b:textAnnotation>\n    <b:association id=\"ExplainSupplier\" sourceRef=\"Supplier\" targetRef=\"SupplierNote\"/>\n  </b:collaboration>\n  <bd:BPMNDiagram id=\"PurchaseDiagram\"><bd:BPMNPlane id=\"PurchasePlane\" bpmnElement=\"Purchase\">\n    <bd:BPMNShape id=\"BuyerShape\" bpmnElement=\"Buyer\" isHorizontal=\"true\"><dc:Bounds x=\"20\" y=\"20\" width=\"700\" height=\"320\"/></bd:BPMNShape>\n    <bd:BPMNShape id=\"SupplierShape\" bpmnElement=\"Supplier\" isHorizontal=\"true\"><dc:Bounds x=\"20\" y=\"400\" width=\"700\" height=\"100\"/></bd:BPMNShape>\n    <bd:BPMNShape bpmnElement=\"Start\"><dc:Bounds x=\"100\" y=\"130\" width=\"36\" height=\"36\"/></bd:BPMNShape>\n    <bd:BPMNShape bpmnElement=\"Prepare\" isExpanded=\"true\"><dc:Bounds x=\"220\" y=\"60\" width=\"360\" height=\"220\"/></bd:BPMNShape>\n    <bd:BPMNShape bpmnElement=\"Received\"><dc:Bounds x=\"250\" y=\"110\" width=\"36\" height=\"36\"/></bd:BPMNShape>\n    <bd:BPMNShape id=\"WorkShape\" bpmnElement=\"Work\"><dc:Bounds x=\"340\" y=\"90\" width=\"140\" height=\"80\"/></bd:BPMNShape>\n    <bd:BPMNShape bpmnElement=\"Ready\"><dc:Bounds x=\"510\" y=\"110\" width=\"36\" height=\"36\"/></bd:BPMNShape>\n    <bd:BPMNShape bpmnElement=\"Placed\"><dc:Bounds x=\"640\" y=\"152\" width=\"36\" height=\"36\"/></bd:BPMNShape>\n    <bd:BPMNShape bpmnElement=\"SupplierNote\"><dc:Bounds x=\"800\" y=\"400\" width=\"180\" height=\"100\"/></bd:BPMNShape>\n    <bd:BPMNEdge bpmnElement=\"BeginOrder\"><di:waypoint x=\"136\" y=\"148\"/><di:waypoint x=\"180\" y=\"148\"/><di:waypoint x=\"180\" y=\"170\"/><di:waypoint x=\"220\" y=\"170\"/></bd:BPMNEdge>\n    <bd:BPMNEdge bpmnElement=\"CompleteOrder\"><di:waypoint x=\"580\" y=\"170\"/><di:waypoint x=\"640\" y=\"170\"/></bd:BPMNEdge>\n    <bd:BPMNEdge bpmnElement=\"BeginWork\"><di:waypoint x=\"286\" y=\"128\"/><di:waypoint x=\"310\" y=\"128\"/><di:waypoint x=\"310\" y=\"130\"/><di:waypoint x=\"340\" y=\"130\"/></bd:BPMNEdge>\n    <bd:BPMNEdge bpmnElement=\"CompleteWork\"><di:waypoint x=\"480\" y=\"130\"/><di:waypoint x=\"495\" y=\"130\"/><di:waypoint x=\"495\" y=\"128\"/><di:waypoint x=\"510\" y=\"128\"/></bd:BPMNEdge>\n    <bd:BPMNEdge bpmnElement=\"Order\" sourceElement=\"WorkShape\" targetElement=\"SupplierShape\" messageVisibleKind=\"initiating\"><di:waypoint x=\"410\" y=\"170\"/><di:waypoint x=\"410\" y=\"300\"/><di:waypoint x=\"760\" y=\"300\"/><di:waypoint x=\"760\" y=\"450\"/><di:waypoint x=\"720\" y=\"450\"/><bd:BPMNLabel><dc:Bounds x=\"620\" y=\"270\" width=\"80\" height=\"18\"/></bd:BPMNLabel></bd:BPMNEdge>\n    <bd:BPMNEdge bpmnElement=\"ExplainSupplier\"><di:waypoint x=\"720\" y=\"460\"/><di:waypoint x=\"800\" y=\"460\"/></bd:BPMNEdge>\n  </bd:BPMNPlane></bd:BPMNDiagram>\n</b:definitions>\n" },
