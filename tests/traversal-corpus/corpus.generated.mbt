  { name: "vendor.bpmn", text: "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<b:definitions xmlns:b=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:v=\"urn:vendor\" xmlns:w=\"urn:vendor\" id=\"Defs\" targetNamespace=\"urn:vendor-test\" v:origin=\"tool\">\n  <b:process id=\"P\" v:owner=\"ops\" isClosed=\"maybe\">\n    <b:extensionElements>\n      <v:task id=\"VendorTask\" v:flag=\"true\">left<![CDATA[&raw <x>]]><w:note>aliased</w:note><!--inside--><?vendor keep?><v:empty/>tail</v:task>\n    </b:extensionElements>\n    <b:task id=\"Task\" name=\"Real task\" isForCompensation=\"perhaps\" startQuantity=\"2\" completionQuantity=\"x\"/>\n    <b:mystery id=\"Unknown\" b:odd=\"1\">kept</b:mystery>\n    <b:sequenceFlow id=\"Flow\" sourceRef=\"Task\" targetRef=\"Task\"/>\n    <b:callActivity id=\"Call\" calledElement=\"v:Elsewhere\"/>\n  </b:process>\n</b:definitions>\n" },
  { name: "process.bpmn", text: "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!-- Order handling with a review loop. -->\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Defs\" targetNamespace=\"urn:orders\">\n  <bpmn:process id=\"Orders\" name=\"Orders\" isExecutable=\"true\">\n    <bpmn:startEvent id=\"Start\" name=\"Order received\"/>\n    <bpmn:task id=\"Check\" name=\"Check order\"/>\n    <bpmn:exclusiveGateway id=\"Ok\" name=\"Complete?\" default=\"ToFix\"/>\n    <bpmn:userTask id=\"Fix\" name=\"Fix order\"/>\n    <bpmn:subProcess id=\"Ship\" name=\"Ship\">\n      <bpmn:startEvent id=\"ShipStart\"/>\n      <bpmn:serviceTask id=\"Pack\" name=\"Pack\" implementation=\"##WebService\"/>\n      <bpmn:endEvent id=\"ShipEnd\"/>\n      <bpmn:sequenceFlow id=\"S1\" sourceRef=\"ShipStart\" targetRef=\"Pack\"/>\n      <bpmn:sequenceFlow id=\"S2\" sourceRef=\"Pack\" targetRef=\"ShipEnd\"/>\n    </bpmn:subProcess>\n    <bpmn:endEvent id=\"End\"/>\n    <bpmn:sequenceFlow id=\"F1\" sourceRef=\"Start\" targetRef=\"Check\"/>\n    <bpmn:sequenceFlow id=\"F2\" sourceRef=\"Check\" targetRef=\"Ok\"/>\n    <bpmn:sequenceFlow id=\"ToShip\" sourceRef=\"Ok\" targetRef=\"Ship\"><bpmn:conditionExpression>ok</bpmn:conditionExpression></bpmn:sequenceFlow>\n    <bpmn:sequenceFlow id=\"ToFix\" sourceRef=\"Ok\" targetRef=\"Fix\"/>\n    <bpmn:sequenceFlow id=\"Back\" sourceRef=\"Fix\" targetRef=\"Check\"/>\n    <bpmn:sequenceFlow id=\"F3\" sourceRef=\"Ship\" targetRef=\"End\"/>\n  </bpmn:process>\n  <?audit level=\"full\"?>\n  <bpmndi:BPMNDiagram id=\"Diagram\">\n    <bpmndi:BPMNPlane id=\"Plane\" bpmnElement=\"Orders\">\n      <bpmndi:BPMNShape id=\"Start_di\" bpmnElement=\"Start\"><dc:Bounds x=\"10\" y=\"20\" width=\"36\" height=\"36\"/></bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Check_di\" bpmnElement=\"Check\"><dc:Bounds x=\"80\" y=\"10\" width=\"100\" height=\"56\"/></bpmndi:BPMNShape>\n      <bpmndi:BPMNEdge id=\"F1_di\" bpmnElement=\"F1\"><di:waypoint x=\"46\" y=\"38\"/><di:waypoint x=\"80\" y=\"38\"/></bpmndi:BPMNEdge>\n    </bpmndi:BPMNPlane>\n  </bpmndi:BPMNDiagram>\n</bpmn:definitions>\n<!-- trailing -->\n" },
