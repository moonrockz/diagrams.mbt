  { name: "crlf-nonbmp.bpmn", text: "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n<!-- 𝔘nicode 🚀 before nodes -->\r\n<b:definitions xmlns:b=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" id=\"Defs\" targetNamespace=\"urn:unicode\">\r\n  <b:process id=\"P\" name=\"Fête 🎉\">\r\n    <b:documentation>Line one 𝔘\r\nline two 🚀</b:documentation>\r\n    <b:task id=\"T1\" name=\"𝔄𝔅 task\"/>\r\n    <b:task id=\"T2\" name=\"tab\there\"/>\r\n    <b:sequenceFlow id=\"F\" sourceRef=\"T1\" targetRef=\"T2\"/>\r\n  </b:process>\r\n</b:definitions>\r\n" },
