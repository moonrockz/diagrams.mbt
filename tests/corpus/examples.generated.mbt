  { name: "26", sha256: "d042768225fc2a2c6aed87e913d293db64cb8da27b430259f3161a3f684888b3", source: "sequenceDiagram\n    Alice->John: Hello John, how are you?\n    loop Every minute\n        John-->Alice: Great!\n    end\n" },
