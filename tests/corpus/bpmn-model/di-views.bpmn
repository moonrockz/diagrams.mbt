  <bpmndi:BPMNDiagram id="D1" name="Process" documentation="Exact supplied geometry" resolution="96.000">
    <bpmndi:BPMNPlane id="Plane1" bpmnElement="P">
      <bpmndi:BPMNShape id="S1" bpmnElement="T" isExpanded="true" isMarkerVisible="false"><dc:Bounds x="-12.345678901234567890123456789" y="10.000" width="100.00000000000000001" height="80.000"/><bpmndi:BPMNLabel id="LabelT" labelStyle="Style1"><dc:Bounds x="1.234567890123456789E+2" y="94" width="45" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S2" bpmnElement="U"><dc:Bounds x="300" y="10" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="EdgeF" bpmnElement="F" sourceElement="S1" targetElement="S2" messageVisibleKind="initiating"><di:waypoint x="123.45678901234567890123456789" y="50"/><di:waypoint x="300" y="50"/><bpmndi:BPMNLabel id="LabelF" labelStyle="Style1"><dc:Bounds x="180" y="30" width="40" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
    <bpmndi:BPMNLabelStyle id="Style1"><dc:Font name="Example font" size="1.200000000000000000000001E+1" isBold="true" isItalic="false" isUnderline="true" isStrikeThrough="false"/></bpmndi:BPMNLabelStyle>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="D2" name="Choreography">
