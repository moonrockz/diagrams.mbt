@startuml
skinparam State {
  AttributeFontColor blue
  AttributeFontName serif
  AttributeFontSize  9
  AttributeFontStyle italic
  BackgroundColor palegreen
  BorderColor violet
  EndColor gold
  FontColor red
  FontName Sansserif
  FontSize 15
  FontStyle bold
  StartColor silver
}
state A
A : a a a\na
state B
B : b b b\nb
[*] -> A : start
A -> B : a2b
B -> [*] : end
@enduml
