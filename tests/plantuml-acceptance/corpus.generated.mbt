pub let expectations : String = "{\n \"ebnf/case-nstar.puml\": {\n  \"category\": \"library-refusal\",\n  \"reason\": \"A repetition count must be a decimal number; PlantUML draws n * x with the label n.\"\n },\n \"ebnf/case-tstar.puml\": {\n  \"category\": \"library-refusal\",\n  \"reason\": \"A repetition count must be a decimal number literal; PlantUML also accepts a quoted string.\"\n },\n \"ebnf/case-two.puml\": {\n  \"category\": \"library-refusal\",\n  \"reason\": \"PlantUML ignores text after the first semicolon of a rule line; this library diagnoses it.\"\n },\n \"regex/case-commaquant.puml\": {\n  \"category\": \"library-refusal\",\n  \"reason\": \"A quantifier with two commas such as {1,2,3} is refused; PlantUML draws it as a labelled loop.\"\n },\n \"regex/case-setescape.puml\": {\n  \"category\": \"divergence\",\n  \"reason\": \"PlantUML reads \\\\- before a character in a set as a range start; this library reads an escaped hyphen.\"\n },\n \"regex/case-toobig.puml\": {\n  \"category\": \"library-refusal\",\n  \"reason\": \"The bound exceeds the 32-bit integer range that PlantUML parses; this library refuses it instead of using -1.\"\n },\n \"regex/case-two-lines.puml\": {\n  \"category\": \"library-refusal\",\n  \"reason\": \"PlantUML draws only the last of several pattern lines; this library refuses more than one pattern line.\"\n },\n \"regex/case-unclosedset.puml\": {\n  \"category\": \"library-refusal\",\n  \"reason\": \"PlantUML accepts an unclosed character set; this library refuses it.\"\n },\n \"regex/case-unicode.puml\": {\n  \"category\": \"divergence\",\n  \"reason\": \"PlantUML splits a surrogate pair into two drawn characters; this library keeps one code point.\"\n },\n \"regex/case-xhex.puml\": {\n  \"category\": \"library-refusal\",\n  \"reason\": \"PlantUML reads \\\\x41 as the class \\\\x followed by literal 41; this library refuses \\\\x without braces instead of guessing.\"\n },\n \"regex/doc-03.puml\": {\n  \"category\": \"divergence\",\n  \"reason\": \"PlantUML draws \\\\Q and \\\\E as class boxes around the text; this library reads \\\\Q...\\\\E as quoted literal text.\"\n },\n \"regex/doc-08.puml\": {\n  \"category\": \"divergence\",\n  \"reason\": \"The !option useDescriptiveNames and language settings are retained but not applied; labels keep the regex spelling.\"\n },\n \"regex/doc-09.puml\": {\n  \"category\": \"divergence\",\n  \"reason\": \"The !option useDescriptiveNames and language settings are retained but not applied; labels keep the regex spelling.\"\n },\n \"regex/doc-10.puml\": {\n  \"category\": \"divergence\",\n  \"reason\": \"The !option useDescriptiveNames and language settings are retained but not applied; labels keep the regex spelling.\"\n },\n \"regex/doc-18.puml\": {\n  \"category\": \"library-refusal\",\n  \"reason\": \"The documented source has text after the end marker; this library diagnoses text outside the block.\"\n },\n \"regex/envelope-rdefine.puml\": {\n  \"category\": \"library-refusal\",\n  \"reason\": \"Preprocessor variables, definitions and themes are not evaluated; they are refused.\"\n },\n \"regex/envelope-rtheme.puml\": {\n  \"category\": \"library-refusal\",\n  \"reason\": \"Preprocessor variables, definitions and themes are not evaluated; they are refused.\"\n },\n \"regex/envelope-rvar.puml\": {\n  \"category\": \"library-refusal\",\n  \"reason\": \"Preprocessor variables, definitions and themes are not evaluated; they are refused.\"\n }\n}\n"
