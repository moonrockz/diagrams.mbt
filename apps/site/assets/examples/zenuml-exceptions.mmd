title Checkout interaction
@Actor Customer
@EC2 API as "Orders API"
@Lambda Worker
@AzureFunction Functions
@BigQuery Analytics
@PostgreSQL Store
@Kubernetes Cluster
Customer->API.checkout() {
    Worker.process() {
        Store->Analytics: record
    }
    Functions->Cluster: deploy request
}
try {
 API->Store: query
} catch(missing) {
 Store->API: absent
} catch(busy) {
 Store->API: retry
} finally {
 API->Store: close
}
