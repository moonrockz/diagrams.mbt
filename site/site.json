{
  "title": "diagrams.mbt",
  "description": "Diagramming for MoonBit.",
  "base_path": "/diagrams.mbt/",
  "site_url": "https://moonrockz.github.io/diagrams.mbt/",
  "repo_url": "https://github.com/moonrockz/diagrams.mbt",
  "versions": {
    "since": "0.1"
  },
  "packages": [
    "bpmn",
    "diagrams",
    "diagrams-svg",
    "diagrams-mermaid",
    "diagrams-plantuml",
    "diagrams-bpmn",
    "diagrams-raster",
    "diagrams-animated"
  ],
  "api": [
    "pkgs/bpmn",
    "pkgs/diagrams",
    "pkgs/diagrams-svg",
    "pkgs/diagrams-mermaid",
    "pkgs/diagrams-plantuml",
    "pkgs/diagrams-bpmn",
    "pkgs/diagrams-raster",
    "pkgs/diagrams-animated"
  ],
  "nav": [
    {
      "group": "Guides",
      "items": [
        "guides/"
      ]
    },
    {
      "group": "Design",
      "items": [
        "design/"
      ]
    },
    {
      "group": "Packages",
      "items": [
        "packages/"
      ]
    },
    {
      "group": "Contribute",
      "items": [
        "WRITING_FOR_THE_SITE.md"
      ]
    }
  ],
  "schema_version": 1,
  "source_roots": [
    "docs",
    "site/pages",
    "site/articles",
    "pkgs",
    "apps/site/assets",
    "tests/corpus"
  ],
  "api_output": "_build/site-api",
  "api_generate": false,
  "static": [
    {
      "from": "apps/site/assets/examples",
      "to": "assets/examples"
    },
    {
      "from": "docs/assets/brand",
      "to": "assets/brand"
    },
    {
      "from": "apps/site/assets/raster",
      "to": "assets/raster"
    }
  ],
  "gallery": {
    "manifest": "site/gallery.json",
    "root": "apps/site/assets/examples"
  },
  "exclude": [
    "docs/templates",
    "docs/superpowers",
    "templates",
    "superpowers",
    ".agents",
    ".claude",
    ".cursor",
    ".grok",
    "openspec",
    "_build",
    "_site",
    ".mooncakes",
    "node_modules",
    "target",
    ".git",
    "docs/assets/brand/README.md",
    "docs/assets/brand/alternatives",
    "docs/assets/brand/generation-prompts.txt",
    "docs/assets/brand/icon-generation-prompt.txt"
  ],
  "header_logo": "assets/brand/icons/logo-64.png",
  "favicon": "assets/brand/icons/favicon.ico",
  "gallery_raster_adapter": "assets/raster/diagrams-raster.js"
}
